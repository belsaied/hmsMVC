{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap"
    },
    {
      "provider": "unpkg",
      "library": "admin-lte@3.2.0",
      "destination": "wwwroot/lib/adminlte"
    },
    {
      "library": "font-awesome@6.5.2",
      "destination": "wwwroot/lib/font-awesome"
    },
    {
      "library": "select2@4.1.0-rc.0",
      "destination": "wwwroot/lib/select2"
    },
    {
      "library": "sweetalert2@11.11.0",
      "destination": "wwwroot/lib/sweetalert2"
    },
    {
      "library": "toastr.js@2.1.4",
      "destination": "wwwroot/lib/toastr"
    },
    {
      "library": "flatpickr@4.6.13",
      "destination": "wwwroot/lib/flatpickr"
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery"
    },
    {
      "provider": "unpkg",
      "library": "jquery-validation@1.22.1",
      "destination": "wwwroot/lib/jquery-validation/"
    },
    {
      "provider": "unpkg",
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/"
    }
  ]
}
