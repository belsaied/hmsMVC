@{
    ViewData["Title"] = "Pay by Card";
    string clientSecret = ViewBag.ClientSecret;
    decimal amount = ViewBag.Amount;
    string invoiceNumber = ViewBag.InvoiceNumber;
    Guid invoiceId = ViewBag.InvoiceId;
}

@section Styles {
<style>
    :root { --hms-blue: #1a3a5c; --hms-blue-mid: #2563a8; --hms-border: #e2e8f0; --hms-muted: #64748b; }
    .form-card { background:#fff; border-radius:14px; box-shadow:0 2px 12px rgba(0,0,0,.06); border:1px solid var(--hms-border); overflow:hidden; }
    .form-card-header { padding:16px 22px; border-bottom:1px solid var(--hms-border); font-weight:700; font-size:.9rem; background:#f8fafc; }
    .form-card-body { padding:22px; }
    #payment-element { margin: 20px 0; }
    #submit { width:100%; padding:12px; font-size:1rem; font-weight:700; border-radius:10px; border:none; background:#2563a8; color:#fff; }
    #submit:hover { background:#1a3a5c; }
    #payment-message { color:#ef4444; margin-top:12px; text-align:center; font-size:.875rem; }
</style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Pay by Card</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Invoices" asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item active">Card Payment</li>
            </ol>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="form-card">
            <div class="form-card-header">
                <i class="fab fa-stripe-s mr-2" style="color:#6772e5"></i> Card Payment &mdash; @invoiceNumber
            </div>
            <div class="form-card-body">
                <p class="text-muted mb-3">Amount due: <strong>@amount.ToString("C")</strong></p>
                <div id="payment-element"></div>
                <button id="submit" class="mt-3">
                    <span id="button-text">Pay @amount.ToString("C")</span>
                    <span id="spinner" class="d-none spinner-border spinner-border-sm ml-2"></span>
                </button>
                <p id="payment-message" class="d-none"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe('@ViewBag.StripePublicKey');
    const elements = stripe.elements({ clientSecret: '@clientSecret' });
    const paymentElement = elements.create('payment');
    paymentElement.mount('#payment-element');

    document.getElementById('submit').addEventListener('click', async () => {
        document.getElementById('spinner').classList.remove('d-none');
        document.getElementById('button-text').textContent = 'Processing\u2026';

        const { error } = await stripe.confirmPayment({
            elements,
            confirmParams: {
                return_url: window.location.origin + '/Invoices/Details/@invoiceId'
            }
        });

        if (error) {
            const msg = document.getElementById('payment-message');
            msg.textContent = error.message;
            msg.classList.remove('d-none');
            document.getElementById('spinner').classList.add('d-none');
            document.getElementById('button-text').textContent = 'Retry Payment';
        }
    });
</script>
}
