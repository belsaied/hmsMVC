@model HMS.PL.ViewModels.BillingModule.RefundViewModel
@{ ViewData["Title"] = "Refund Payment"; }

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Refund Payment</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Invoices" asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item active">Refund</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root { --hms-border: #e2e8f0; --hms-text: #1e293b; --hms-muted: #64748b; }
    .form-card { background:#fff; border-radius:14px; box-shadow:0 2px 12px rgba(0,0,0,.06); border:1px solid var(--hms-border); overflow:hidden; }
    .form-card-header { padding:16px 22px; border-bottom:1px solid var(--hms-border); font-weight:700; font-size:.9rem; background:#f8fafc; }
    .form-card-body { padding:22px; }
    .form-control { border-radius:10px; border:1.5px solid var(--hms-border); padding:10px 14px; font-size:.9rem; }
    .form-control:focus { border-color:#d97706; box-shadow:0 0 0 3px rgba(217,119,6,.12); }
    .form-label { font-size:.82rem; font-weight:600; color:var(--hms-text); margin-bottom:4px; }
    .input-group-text { border-radius:10px 0 0 10px; border-color:var(--hms-border); }
</style>
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="form-card">
            <div class="form-card-header">
                <i class="fas fa-undo mr-2 text-warning"></i> Process Refund
            </div>
            <div class="form-card-body">
                <p class="text-muted mb-3">Original payment: <strong>@Model.PaidAmount.ToString("C")</strong></p>
                <form asp-action="Refund" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PaymentId" />
                    <input type="hidden" asp-for="InvoiceId" />
                    <input type="hidden" asp-for="PaidAmount" />

                    <div class="form-group">
                        <label asp-for="Amount" class="form-label">Refund Amount ($)</label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01"
                                   max="@Model.PaidAmount" class="form-control" required />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" required></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2" style="gap:8px">
                        <button type="submit" class="btn btn-warning text-dark font-weight-bold"
                                style="border-radius:9px;padding:10px 20px"
                                onclick="return confirm('Confirm refund? This will contact Stripe for card payments.')">
                            <i class="fas fa-undo mr-1"></i> Process Refund
                        </button>
                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId"
                           class="btn btn-outline-secondary" style="border-radius:9px;font-weight:600">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
