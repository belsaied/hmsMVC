@model HMS.PL.ViewModels.BillingModule.RefundViewModel
@{ ViewData["Title"] = "Process Refund"; }

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Process Refund</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Invoices" asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item active">Refund</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root { --hms-border:#e2e8f0; --hms-text:#1e293b; --hms-muted:#64748b; }

    .pay-wrapper { max-width: 460px; margin: 0 auto; }

    .pay-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(26,58,92,.09);
        border: 1px solid var(--hms-border);
        overflow: hidden;
    }

    .pay-header {
        background: linear-gradient(135deg, #7c2d12, #ea580c);
        color: #fff;
        padding: 24px 28px 20px;
    }
    .pay-header .amount-label { font-size:.82rem; opacity:.8; }
    .pay-header .amount-value { font-size:2.2rem; font-weight:800; letter-spacing:-1px; }

    .pay-body { padding: 26px 28px; }

    .form-label { font-size:.82rem; font-weight:600; color:var(--hms-text); margin-bottom:4px; display:block; }
    .form-control { border-radius:10px; border:1.5px solid var(--hms-border); padding:11px 14px; font-size:.95rem; transition:border .2s; }
    .form-control:focus { border-color:#ea580c; box-shadow:0 0 0 3px rgba(234,88,12,.12); outline:none; }
    .input-group-text { background:#fff7ed; border-color:var(--hms-border); border-radius:10px 0 0 10px !important; color:#9a3412; font-weight:700; }
    .input-group .form-control { border-radius:0 10px 10px 0 !important; }

    .submit-btn {
        width:100%; padding:13px; font-size:.95rem; font-weight:700;
        border-radius:11px; border:none;
        background: linear-gradient(135deg, #7c2d12, #ea580c);
        color:#fff; cursor:pointer; transition:opacity .2s;
    }
    .submit-btn:hover { opacity:.9; }

    .warning-box {
        background:#fff7ed; border:1px solid #fed7aa; border-radius:10px;
        padding:12px 16px; margin-bottom:20px;
        font-size:.8rem; color:#9a3412; display:flex; align-items:flex-start; gap:8px;
    }
</style>
}

<div class="pay-wrapper">
    <div class="pay-card">
        <div class="pay-header">
            <div class="amount-label">Original Payment Amount</div>
            <div class="amount-value">@Model.PaidAmount.ToString("C")</div>
        </div>

        <div class="pay-body">
            <div class="warning-box">
                <i class="fas fa-exclamation-triangle mt-1"></i>
                <span>For card payments, this will issue a real Stripe refund. For cash payments, this only updates the system record.</span>
            </div>

            <form asp-action="Refund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PaymentId" />
                <input type="hidden" asp-for="InvoiceId" />
                <input type="hidden" asp-for="PaidAmount" />

                <div class="form-group mb-3">
                    <label asp-for="Amount" class="form-label">Refund Amount</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-dollar-sign"></i></span>
                        </div>
                        <input asp-for="Amount" type="number" step="0.01" min="0.01"
                               max="@Model.PaidAmount" class="form-control"
                               placeholder="0.00" required />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Reason" class="form-label">Reason for Refund</label>
                    <textarea asp-for="Reason" class="form-control" rows="3"
                              placeholder="e.g. Patient cancelled appointment before service was rendered" required></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <button type="submit" class="submit-btn"
                        onclick="return confirm('Are you sure you want to process this refund? This action cannot be undone.')">
                    <i class="fas fa-undo mr-2"></i> Process Refund
                </button>

                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId"
                   class="btn btn-outline-secondary btn-block mt-2" style="border-radius:11px;font-weight:600">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
