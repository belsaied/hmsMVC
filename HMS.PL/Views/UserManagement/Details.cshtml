@using HMS.PL.ViewModels.UserManagementModule
@model UserDetailsViewModel

@{
    ViewData["Title"] = Model.FullName;
    var avatarLetter = Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?";
    var colorMap = new Dictionary<string,string>{
        {"SuperAdmin","#ef4444"},{"HospitalAdmin","#f59e0b"},
        {"Doctor","#10b981"},{"Nurse","#06b6d4"},
        {"Receptionist","#8b5cf6"},{"Patient","#ec4899"}
    };
    var iconMap = new Dictionary<string,string>{
        {"SuperAdmin","fa-crown"},{"HospitalAdmin","fa-hospital-user"},
        {"Doctor","fa-user-md"},{"Nurse","fa-hand-holding-heart"},
        {"Receptionist","fa-headset"},{"Patient","fa-user-injured"}
    };
    var primaryRole = Model.PrimaryRole;
    var roleColor = colorMap.ContainsKey(primaryRole) ? colorMap[primaryRole] : "#6366f1";
    var roleIcon = iconMap.ContainsKey(primaryRole) ? iconMap[primaryRole] : "fa-user";
}

@section Styles {
<style>
    * { box-sizing: border-box; }

    .bg-details {
        position: fixed; inset: 0; z-index: 0; overflow: hidden;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    }
    .bg-details::before {
        content: ''; position: absolute; inset: 0;
        background-image:
            linear-gradient(rgba(99,102,241,.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(99,102,241,.05) 1px, transparent 1px);
        background-size: 60px 60px;
    }
    .bg-details .orb {
        position: absolute; width: 500px; height: 500px; border-radius: 50%;
        filter: blur(100px); opacity: .15;
    }
    .bg-details .orb:nth-child(1) { background: #6366f1; top: -150px; right: -100px; }
    .bg-details .orb:nth-child(2) { background: #06b6d4; bottom: -200px; left: -100px; }

    .details-wrapper {
        position: relative; z-index: 1;
        min-height: 100vh; padding: 2rem 1.25rem;
    }
    .details-container { max-width: 1100px; margin: 0 auto; }

    .back-link {
        display: inline-flex; align-items: center; gap: .5rem;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 50px; padding: .4rem 1rem .4rem .6rem;
        color: rgba(255,255,255,.5); font-size: .8rem; font-weight: 500;
        transition: all .25s; text-decoration: none; margin-bottom: 1.5rem;
    }
    .back-link:hover {
        background: rgba(255,255,255,.1); color: #fff; text-decoration: none;
    }

    .profile-hero {
        background: linear-gradient(135deg, rgba(99,102,241,.15) 0%, rgba(139,92,246,.1) 100%);
        border: 1px solid rgba(255,255,255,.1);
        backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        border-radius: 24px; padding: 2.5rem; margin-bottom: 2rem;
        position: relative; overflow: hidden;
    }
    .profile-hero::before {
        content: ''; position: absolute; top: -50%; right: -20%;
        width: 400px; height: 400px; border-radius: 50%;
        background: radial-gradient(circle, rgba(99,102,241,.08) 0%, transparent 70%);
        pointer-events: none;
    }
    .profile-hero::after {
        content: ''; position: absolute; bottom: -40%; left: -10%;
        width: 300px; height: 300px; border-radius: 50%;
        background: radial-gradient(circle, rgba(6,182,212,.06) 0%, transparent 70%);
        pointer-events: none;
    }

    .hero-avatar {
        width: 80px; height: 80px; border-radius: 50%;
        background: linear-gradient(135deg, @roleColor 0%, rgba(255,255,255,.2) 100%);
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; font-weight: 700; color: #fff;
        box-shadow: 0 8px 32px rgba(0,0,0,.3);
        position: relative; flex-shrink: 0;
    }
    .hero-avatar .status-dot {
        position: absolute; bottom: 2px; right: 2px;
        width: 16px; height: 16px; border-radius: 50%;
        border: 2px solid #1e293b;
        @if (Model.IsLocked) {
            <text>background:#ef4444;</text>
        } else {
            <text>background:#10b981;box-shadow:0 0 12px rgba(16,185,129,.5);</text>
        }
    }

    .hero-name { font-size: 1.8rem; font-weight: 800; color: #fff; letter-spacing: -.01em; }
    .hero-email { color: rgba(255,255,255,.5); font-size: .9rem; }
    .hero-role-badge {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .25rem .75rem; border-radius: 50px;
        font-size: .72rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: .04em;
    }

    .stats-row {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr));
        gap: .75rem; margin-bottom: 2rem;
    }
    .stat-card {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 16px; padding: 1rem 1.25rem;
        text-align: center; transition: all .25s;
    }
    .stat-card:hover {
        background: rgba(255,255,255,.07);
        border-color: rgba(255,255,255,.12);
        transform: translateY(-2px);
    }
    .stat-card .stat-value {
        font-size: 1.4rem; font-weight: 800; color: #fff;
        letter-spacing: -.02em;
    }
    .stat-card .stat-label {
        font-size: .65rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: .08em; color: rgba(255,255,255,.4);
        margin-top: .15rem;
    }

    .content-grid {
        display: grid; grid-template-columns: 1fr 320px;
        gap: 1.5rem;
    }
    @@media (max-width: 900px) { .content-grid { grid-template-columns: 1fr; } }

    .info-card {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border-radius: 18px; padding: 1.5rem; margin-bottom: 1.25rem;
        transition: border-color .3s;
    }
    .info-card:hover { border-color: rgba(255,255,255,.14); }

    .card-header-custom {
        display: flex; align-items: center; gap: .5rem;
        font-size: .68rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .1em; color: rgba(255,255,255,.4);
        padding-bottom: .75rem; margin-bottom: .75rem;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }
    .card-header-custom i { font-size: .75rem; color: rgba(255,255,255,.25); }

    .dl-list { list-style: none; padding: 0; margin: 0; }
    .dl-item {
        display: flex; align-items: center; padding: .6rem 0;
        border-bottom: 1px solid rgba(255,255,255,.04);
    }
    .dl-item:last-child { border-bottom: none; }
    .dl-item .label {
        width: 150px; font-size: .75rem; font-weight: 600;
        color: rgba(255,255,255,.4); text-transform: uppercase;
        letter-spacing: .04em; flex-shrink: 0;
    }
    .dl-item .value {
        font-size: .88rem; color: rgba(255,255,255,.85);
        font-weight: 500;
    }

    .actions-card {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border-radius: 18px; padding: 1.5rem;
        position: sticky; top: 2rem;
    }

    .action-btn {
        display: block; width: 100%; padding: .75rem 1rem;
        border-radius: 12px; border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.04);
        color: rgba(255,255,255,.7); font-size: .82rem; font-weight: 600;
        text-align: left; transition: all .2s; margin-bottom: .5rem;
        text-decoration: none;
    }
    .action-btn:hover {
        background: rgba(255,255,255,.08);
        border-color: rgba(255,255,255,.15);
        color: #fff; text-decoration: none;
    }
    .action-btn i { width: 20px; margin-right: .5rem; }
    .action-btn.danger:hover { background: rgba(239,68,68,.15); border-color: rgba(239,68,68,.25); color: #fca5a5; }
    .action-btn.success:hover { background: rgba(16,185,129,.15); border-color: rgba(16,185,129,.25); color: #6ee7b7; }
    .action-btn.warning-action:hover { background: rgba(245,158,11,.15); border-color: rgba(245,158,11,.25); color: #fcd34d; }
    .action-btn.primary-action:hover { background: rgba(99,102,241,.15); border-color: rgba(99,102,241,.25); color: #a5b4fc; }

    .reset-collapse { display: none; margin-top: .5rem; }
    .reset-collapse.open { display: block; }
    .reset-box {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 12px; padding: .75rem;
    }
    .reset-box input {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 8px; color: #fff; padding: .5rem .75rem;
        font-size: .82rem; width: 100%;
    }
    .reset-box input:focus {
        border-color: rgba(245,158,11,.4);
        box-shadow: 0 0 0 2px rgba(245,158,11,.15);
        outline: none;
    }

    .toast-container {
        position: fixed; top: 1.25rem; right: 1.25rem; z-index: 9999;
    }
    .toast-custom {
        background: rgba(16,185,129,.15);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(16,185,129,.2);
        border-radius: 14px; color: #6ee7b7; padding: 1rem 1.25rem;
        font-size: .88rem; max-width: 420px;
        box-shadow: 0 8px 32px rgba(0,0,0,.3);
        animation: slideIn .4s ease-out;
    }
    @@keyframes slideIn {
        from { opacity: 0; transform: translateX(30px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .toast-custom.error {
        background: rgba(239,68,68,.15);
        border-color: rgba(239,68,68,.2);
        color: #fca5a5;
    }

    .badge-custom {
        display: inline-flex; align-items: center; gap: .3rem;
        padding: .15rem .55rem; border-radius: 50px;
        font-size: .7rem; font-weight: 600;
    }
    .badge-success { background: rgba(16,185,129,.15); color: #6ee7b7; }
    .badge-danger { background: rgba(239,68,68,.15); color: #fca5a5; }
    .badge-warning { background: rgba(245,158,11,.15); color: #fcd34d; }
    .badge-info { background: rgba(99,102,241,.15); color: #a5b4fc; }

    .linked-link {
        color: #93c5fd; text-decoration: none; font-weight: 600;
        transition: color .2s;
    }
    .linked-link:hover { color: #bfdbfe; text-decoration: underline; }
</style>
}

<div class="bg-details">
    <div class="orb"></div>
    <div class="orb"></div>
</div>

@if (TempData["Success"] != null)
{
    <div class="toast-container">
        <div class="toast-custom">
            <i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["Success"])
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-container">
        <div class="toast-custom error">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        </div>
    </div>
}

<div class="details-wrapper">
    <div class="details-container">

        <a asp-action="Index" class="back-link">
            <i class="fas fa-arrow-left" style="font-size:.7rem;"></i> Back to Users
        </a>

        <div class="profile-hero">
            <div class="d-flex align-items-center gap-4" style="position:relative;z-index:1;">
                <div class="hero-avatar">
                    @avatarLetter
                    <div class="status-dot"></div>
                </div>
                <div style="flex:1;min-width:0;">
                    <div class="hero-name">@Model.FullName</div>
                    <div class="hero-email">@Model.Email</div>
                    <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.6rem;">
                        @foreach (var r in Model.Roles)
                        {
                            var c = colorMap.ContainsKey(r) ? colorMap[r] : "#6366f1";
                            var ic = iconMap.ContainsKey(r) ? iconMap[r] : "fa-user";
                            <span class="hero-role-badge" style="background:@(c)22;border:1px solid @(c)44;color:@c;">
                                <i class="fas @ic" style="font-size:.65rem;"></i> @r
                            </span>
                        }
                    </div>
                </div>
                @if (Model.DoctorId.HasValue)
                {
                    <a asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId"
                       style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2);border-radius:14px;padding:.6rem 1rem;text-align:center;text-decoration:none;flex-shrink:0;transition:all .2s;"
                       onmouseover="this.style.background='rgba(16,185,129,.2)'"
                       onmouseout="this.style.background='rgba(16,185,129,.1)'">
                        <div style="font-size:1.2rem;font-weight:800;color:#6ee7b7;">#@Model.DoctorId</div>
                        <div style="font-size:.6rem;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.4);">Doctor ID</div>
                    </a>
                }
                @if (Model.PatientId.HasValue)
                {
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
                       style="background:rgba(236,72,153,.1);border:1px solid rgba(236,72,153,.2);border-radius:14px;padding:.6rem 1rem;text-align:center;text-decoration:none;flex-shrink:0;transition:all .2s;"
                       onmouseover="this.style.background='rgba(236,72,153,.2)'"
                       onmouseout="this.style.background='rgba(236,72,153,.1)'">
                        <div style="font-size:1.2rem;font-weight:800;color:#f9a8d4;">#@Model.PatientId</div>
                        <div style="font-size:.6rem;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.4);">Patient ID</div>
                    </a>
                }
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-value" style="color:@roleColor;">
                    <i class="fas @roleIcon"></i>
                </div>
                <div class="stat-label">Primary Role</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" style="color:@(Model.IsEmailVerified ? "#6ee7b7" : "#fcd34d");">
                    <i class="fas @(Model.IsEmailVerified ? "fa-check-circle" : "fa-clock")"></i>
                </div>
                <div class="stat-label">@(Model.IsEmailVerified ? "Verified" : "Unverified")</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" style="color:@(Model.IsLocked ? "#fca5a5" : "#6ee7b7");">
                    <i class="fas @(Model.IsLocked ? "fa-lock" : "fa-unlock")"></i>
                </div>
                <div class="stat-label">@(Model.IsLocked ? "Locked" : "Active")</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" style="color:#93c5fd;">@Model.FailedLoginAttempts</div>
                <div class="stat-label">Failed Logins</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" style="font-size:1rem;color:rgba(255,255,255,.7);">
                    @(Model.LastLoginAt?.ToString("MMM dd") ?? "—")
                </div>
                <div class="stat-label">Last Login</div>
            </div>
        </div>

        <div class="content-grid">
            <div>

                <div class="info-card">
                    <div class="card-header-custom"><i class="fas fa-user"></i> Account Information</div>
                    <ul class="dl-list">
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-hashtag me-1" style="opacity:.4;"></i> User ID</span>
                            <span class="value"><code style="background:rgba(255,255,255,.06);padding:.1rem .4rem;border-radius:4px;color:rgba(255,255,255,.6);font-size:.8rem;">@Model.Id</code></span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-user me-1" style="opacity:.4;"></i> Full Name</span>
                            <span class="value">@Model.FullName</span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-envelope me-1" style="opacity:.4;"></i> Email</span>
                            <span class="value">@Model.Email</span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-phone me-1" style="opacity:.4;"></i> Phone</span>
                            <span class="value">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-layer-group me-1" style="opacity:.4;"></i> Roles</span>
                            <span class="value">
                                @foreach (var r in Model.Roles)
                                {
                                    var c = colorMap.ContainsKey(r) ? colorMap[r] : "#6366f1";
                                    <span class="badge-custom" style="background:@(c)22;color:@c;border:1px solid @(c)33;margin-right:.25rem;">@r</span>
                                }
                            </span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-check-circle me-1" style="opacity:.4;"></i> Email Verified</span>
                            <span class="value">
                                @if (Model.IsEmailVerified)
                                {
                                    <span class="badge-custom badge-success"><i class="fas fa-check-circle"></i> Verified</span>
                                }
                                else
                                {
                                    <span class="badge-custom badge-warning"><i class="fas fa-clock"></i> Pending</span>
                                }
                            </span>
                        </li>
                    </ul>
                </div>

                <div class="info-card">
                    <div class="card-header-custom"><i class="fas fa-shield"></i> Security</div>
                    <ul class="dl-list">
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-lock me-1" style="opacity:.4;"></i> Account Status</span>
                            <span class="value">
                                @if (Model.IsLocked)
                                {
                                    <span class="badge-custom badge-danger"><i class="fas fa-lock"></i> Locked until @Model.LockoutEnd?.ToString("dd MMM yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="badge-custom badge-success"><i class="fas fa-unlock"></i> Active</span>
                                }
                            </span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-right-to-bracket me-1" style="opacity:.4;"></i> Last Login</span>
                            <span class="value">@(Model.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Never")</span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-exclamation-triangle me-1" style="opacity:.4;"></i> Failed Attempts</span>
                            <span class="value">
                                <span class="badge-custom @(Model.FailedLoginAttempts > 0 ? "badge-danger" : "badge-success")">
                                    @Model.FailedLoginAttempts
                                </span>
                            </span>
                        </li>
                        <li class="dl-item">
                            <span class="label"><i class="fas fa-clock me-1" style="opacity:.4;"></i> Token Expiry</span>
                            <span class="value">
                                @(Model.RefreshTokenExpiry?.ToString("dd MMM yyyy HH:mm") ?? "—")
                            </span>
                        </li>
                    </ul>
                </div>

                @if (Model.DoctorId.HasValue || Model.PatientId.HasValue)
                {
                    <div class="info-card">
                        <div class="card-header-custom"><i class="fas fa-link"></i> Linked Records</div>
                        <ul class="dl-list">
                            @if (Model.DoctorId.HasValue)
                            {
                                <li class="dl-item">
                                    <span class="label"><i class="fas fa-user-md me-1" style="opacity:.4;"></i> Doctor</span>
                                    <span class="value">
                                        <a asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId" class="linked-link">
                                            <i class="fas fa-external-link-alt me-1" style="font-size:.65rem;"></i>View Doctor Profile
                                        </a>
                                    </span>
                                </li>
                            }
                            @if (Model.PatientId.HasValue)
                            {
                                <li class="dl-item">
                                    <span class="label"><i class="fas fa-user-injured me-1" style="opacity:.4;"></i> Patient</span>
                                    <span class="value">
                                        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="linked-link">
                                            <i class="fas fa-external-link-alt me-1" style="font-size:.65rem;"></i>View Patient Profile
                                        </a>
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div>
                <div class="actions-card">
                    <div class="card-header-custom" style="border-bottom-color:rgba(255,255,255,.06);margin-bottom:1rem;">
                        <i class="fas fa-sliders"></i> Admin Actions
                    </div>

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="action-btn primary-action">
                        <i class="fas fa-pen"></i> Edit Profile
                    </a>

                    @if (!Model.IsLocked)
                    {
                        <form asp-action="Lock" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Are you sure you want to LOCK this account?');">
                            @Html.AntiForgeryToken()
                            <button class="action-btn danger" style="width:100%;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);text-align:left;">
                                <i class="fas fa-lock"></i> Lock Account
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Unlock" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="action-btn success" style="width:100%;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);text-align:left;">
                                <i class="fas fa-unlock"></i> Unlock Account
                            </button>
                        </form>
                    }

                    <button class="action-btn warning-action" style="width:100%;" id="resetToggle">
                        <i class="fas fa-key"></i> Reset Password
                    </button>
                    <div id="resetSection" class="reset-collapse">
                        <div class="reset-box">
                            <form asp-action="ForceResetPassword" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div style="margin-bottom:.5rem;">
                                    <input type="password" name="newPassword"
                                           placeholder="New password (min 8 chars)"
                                           minlength="8" required />
                                </div>
                                <button type="submit" style="width:100%;padding:.45rem;border-radius:8px;border:none;background:rgba(245,158,11,.2);color:#fcd34d;font-weight:600;font-size:.78rem;cursor:pointer;transition:background .2s;"
                                        onmouseover="this.style.background='rgba(245,158,11,.3)'" onmouseout="this.style.background='rgba(245,158,11,.2)'"
                                        onclick="return confirm('Reset this user\'s password?');">
                                    Confirm Reset
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var toast = document.querySelector('.toast-custom');
    if (toast) {
        setTimeout(function() {
            toast.style.transition = 'opacity .5s, transform .5s';
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(30px)';
            setTimeout(function() { toast.remove(); }, 600);
        }, 5000);
    }

    document.getElementById('resetToggle')?.addEventListener('click', function() {
        document.getElementById('resetSection').classList.toggle('open');
    });
</script>
}
