@using HMS.PL.ViewModels.UserManagementModule
@model CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

@section Styles {
<style>
    * { box-sizing: border-box; }

    .bg-grid {
        position: fixed; inset: 0; z-index: 0; overflow: hidden;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    }
    .bg-grid::before {
        content: ''; position: absolute; inset: 0;
        background-image:
            linear-gradient(rgba(99,102,241,.06) 1px, transparent 1px),
            linear-gradient(90deg, rgba(99,102,241,.06) 1px, transparent 1px);
        background-size: 60px 60px;
    }
    .bg-orbs {
        position: absolute; width: 600px; height: 600px; border-radius: 50%;
        filter: blur(100px); opacity: .3; pointer-events: none;
    }
    .bg-orbs:nth-child(1) { background: #6366f1; top: -200px; left: -100px; animation: float 20s ease-in-out infinite; }
    .bg-orbs:nth-child(2) { background: #06b6d4; bottom: -200px; right: -100px; animation: float 25s ease-in-out infinite reverse; }
    .bg-orbs:nth-child(3) { background: #f59e0b; top: 50%; left: 50%; transform: translate(-50%,-50%); animation: float 30s ease-in-out infinite; }

    @@keyframes float {
        0%,100% { transform: translate(0,0) scale(1); }
        33% { transform: translate(40px,-40px) scale(1.1); }
        66% { transform: translate(-30px,30px) scale(.95); }
    }

    .create-wrapper {
        position: relative; z-index: 1;
        min-height: 100vh; padding: 2rem 1rem;
        display: flex; align-items: flex-start; justify-content: center;
    }

    .create-container {
        width: 100%; max-width: 900px;
    }

    .hero-header {
        text-align: center; margin-bottom: 2.5rem;
        position: relative;
    }
    .hero-header h1 {
        font-size: 2.2rem; font-weight: 800; color: #fff;
        letter-spacing: -.02em; text-shadow: 0 2px 20px rgba(0,0,0,.3);
        margin-bottom: .5rem;
    }
    .hero-header p {
        color: rgba(255,255,255,.6); font-size: .95rem;
    }
    .hero-header .badge-approve {
        display: inline-flex; align-items: center; gap: .4rem;
        background: rgba(16,185,129,.2); border: 1px solid rgba(16,185,129,.3);
        color: #34d399; padding: .35rem 1rem; border-radius: 50px;
        font-size: .78rem; font-weight: 600; margin-bottom: .75rem;
    }

    .form-card {
        background: rgba(255,255,255,.05);
        backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem;
        box-shadow: 0 8px 40px rgba(0,0,0,.2);
        transition: border-color .3s, box-shadow .3s;
    }
    .form-card:hover {
        border-color: rgba(255,255,255,.18);
        box-shadow: 0 12px 50px rgba(0,0,0,.3);
    }

    .section-badge {
        display: inline-flex; align-items: center; gap: .5rem;
        font-size: .68rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .12em; color: rgba(255,255,255,.4);
        margin-bottom: 1.25rem; padding-bottom: .75rem;
        border-bottom: 1px solid rgba(255,255,255,.06);
        width: 100%;
    }
    .section-badge i { font-size: .8rem; color: rgba(255,255,255,.3); }

    .form-floating-custom {
        position: relative; margin-bottom: 1rem;
    }
    .form-floating-custom label {
        display: block; font-size: .72rem; font-weight: 600;
        color: rgba(255,255,255,.5); text-transform: uppercase;
        letter-spacing: .06em; margin-bottom: .35rem;
    }
    .form-floating-custom .form-control,
    .form-floating-custom .form-select {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 12px; color: #fff; padding: .65rem 1rem;
        font-size: .9rem; transition: all .25s;
    }
    .form-floating-custom .form-control:focus,
    .form-floating-custom .form-select:focus {
        background: rgba(255,255,255,.08);
        border-color: rgba(99,102,241,.5);
        box-shadow: 0 0 0 3px rgba(99,102,241,.15);
        color: #fff;
    }
    .form-floating-custom .form-control::placeholder { color: rgba(255,255,255,.25); }
    .form-floating-custom .form-control:-ms-input-placeholder { color: rgba(255,255,255,.25); }
    .form-floating-custom .form-select option { background: #1e293b; color: #fff; }
    .form-floating-custom .text-danger { font-size: .72rem; margin-top: .25rem; display: block; }
    .form-floating-custom .form-text { color: rgba(255,255,255,.35); font-size: .72rem; }

    .input-group-custom .input-group-text {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-right: none; border-radius: 12px 0 0 12px;
        color: rgba(255,255,255,.5); font-size: .85rem;
    }
    .input-group-custom .form-control {
        border-radius: 0 12px 12px 0 !important;
    }

    .form-check-custom .form-check-input {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 5px; cursor: pointer;
    }
    .form-check-custom .form-check-input:checked {
        background: #6366f1; border-color: #6366f1;
    }
    .form-check-custom .form-check-label {
        color: rgba(255,255,255,.6); font-size: .82rem;
    }

    .role-picker {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(130px,1fr));
        gap: .6rem; margin-bottom: 1rem;
    }
    .role-card {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 14px; padding: .85rem .5rem;
        text-align: center; cursor: pointer;
        transition: all .25s; position: relative;
    }
    .role-card:hover {
        background: rgba(255,255,255,.08);
        border-color: rgba(255,255,255,.15);
        transform: translateY(-2px);
    }
    .role-card.selected {
        background: rgba(99,102,241,.15);
        border-color: rgba(99,102,241,.4);
        box-shadow: 0 4px 20px rgba(99,102,241,.15);
    }
    .role-card .role-icon {
        font-size: 1.3rem; margin-bottom: .3rem;
    }
    .role-card .role-name {
        font-size: .7rem; font-weight: 600; color: rgba(255,255,255,.7);
        text-transform: uppercase; letter-spacing: .04em;
    }
    .role-card.selected .role-name { color: #a5b4fc; }
    .role-card .check-mark {
        position: absolute; top: 5px; right: 6px;
        width: 16px; height: 16px; border-radius: 50%;
        background: #6366f1; color: #fff;
        font-size: 9px; display: flex; align-items: center; justify-content: center;
        opacity: 0; transform: scale(.5); transition: all .25s;
    }
    .role-card.selected .check-mark { opacity: 1; transform: scale(1); }

    .role-message {
        border-radius: 12px; padding: .75rem 1rem; margin-bottom: 1.5rem;
        font-size: .82rem; font-weight: 500; display: none;
    }

    .section-content {
        display: none; animation: fadeSlide .4s ease-out;
    }
    .section-content.visible { display: block; }

    @@keyframes fadeSlide {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .submit-btn {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border: none; border-radius: 14px; padding: .85rem 2.5rem;
        font-weight: 700; font-size: 1rem; color: #fff;
        box-shadow: 0 4px 24px rgba(99,102,241,.35);
        transition: all .3s; letter-spacing: .01em;
    }
    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(99,102,241,.45);
        color: #fff;
    }
    .submit-btn:active { transform: translateY(0); }

    .cancel-btn {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 14px; padding: .85rem 2rem;
        font-weight: 600; font-size: .9rem; color: rgba(255,255,255,.6);
        transition: all .25s;
    }
    .cancel-btn:hover {
        background: rgba(255,255,255,.1);
        color: #fff; text-decoration: none;
    }

    .alert-glass {
        background: rgba(239,68,68,.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(239,68,68,.2);
        border-radius: 14px; color: #fca5a5; padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
    }
    .alert-glass ul { margin: .5rem 0 0; padding-left: 1.25rem; }
    .alert-glass li { margin-bottom: .2rem; font-size: .85rem; }
    .alert-glass strong { color: #fca5a5; }

    .alert-info-glass {
        background: rgba(59,130,246,.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(59,130,246,.2);
        border-radius: 14px; color: #93c5fd; padding: 1rem 1.25rem;
        margin-bottom: 1.5rem; display: flex; align-items: center; gap: .75rem;
    }
    .alert-info-glass i { font-size: 1.2rem; color: #60a5fa; }
</style>
}

<div class="bg-grid">
    <div class="bg-orbs"></div>
    <div class="bg-orbs"></div>
    <div class="bg-orbs"></div>
</div>

<div class="create-wrapper">
    <div class="create-container">

        <div class="hero-header">
            @if (ViewBag.PendingRequestId != null)
            {
                <div class="badge-approve">
                    <i class="fas fa-check-double"></i> Approving Pending Request
                </div>
            }
            <h1>
                <i class="fas fa-sparkles" style="color:#a78bfa;font-size:1.6rem;vertical-align:middle;"></i>
                Create New User
            </h1>
            <p>Set up a new account with role-based access and permissions</p>
        </div>

        @if (!ViewContext.ModelState.IsValid && ViewContext.ModelState.ErrorCount > 0)
        {
            <div class="alert-glass">
                <strong><i class="fas fa-exclamation-circle me-2"></i>Please fix the following errors:</strong>
                <ul>
                    @foreach (var entry in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@entry.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        @if (ViewBag.PendingRequestId != null)
        {
            <div class="alert-info-glass">
                <i class="fas fa-user-check"></i>
                <div>
                    <strong>Approving pending request</strong> — The details from the request have been pre-filled.
                    Complete the remaining fields to create the user account.
                </div>
            </div>
        }

        <form asp-action="Create" method="post" id="createUserForm">
            @Html.AntiForgeryToken()
            @if (ViewBag.PendingRequestId != null)
            {
                <input type="hidden" name="pendingRequestId" value="@ViewBag.PendingRequestId" />
            }

            <div class="form-card">
                <div class="section-badge"><i class="fas fa-fingerprint"></i> Identity</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating-custom">
                            <label asp-for="FirstName"><i class="fas fa-user me-1" style="opacity:.5;"></i> First Name</label>
                            <input asp-for="FirstName" class="form-control" placeholder="John" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating-custom">
                            <label asp-for="LastName"><i class="fas fa-user me-1" style="opacity:.5;"></i> Last Name</label>
                            <input asp-for="LastName" class="form-control" placeholder="Doe" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="form-floating-custom">
                            <label asp-for="Email"><i class="fas fa-envelope me-1" style="opacity:.5;"></i> Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="user@hospital.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-floating-custom">
                            <label asp-for="IsEmailVerified" style="opacity:0;">&nbsp;</label>
                            <div class="form-check-custom" style="padding-top:.5rem;">
                                <input asp-for="IsEmailVerified" class="form-check-input" />
                                <label asp-for="IsEmailVerified" class="form-check-label">
                                    <i class="fas fa-check-circle me-1" style="opacity:.5;"></i> Email is verified
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating-custom">
                            <label asp-for="Password"><i class="fas fa-lock me-1" style="opacity:.5;"></i> Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Min 8 characters" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating-custom">
                            <label asp-for="ConfirmPassword"><i class="fas fa-check-lock me-1" style="opacity:.5;"></i> Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <div class="section-badge"><i class="fas fa-shield-halved"></i> Role &amp; Access</div>
                <label style="font-size:.72rem;font-weight:600;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.4rem;display:block;">
                    <i class="fas fa-id-badge me-1" style="opacity:.5;"></i> Select Role
                </label>
                <input type="hidden" asp-for="Role" id="roleHidden" />
                <div class="role-picker" id="rolePicker">
                    @{
                        var roleIconMap = new Dictionary<string,string>{
                            {"SuperAdmin","fa-crown"},{"HospitalAdmin","fa-hospital-user"},
                            {"Doctor","fa-user-md"},{"Nurse","fa-hand-holding-heart"},
                            {"Receptionist","fa-headset"},{"Patient","fa-user-injured"}
                        };
                        var roleColorMap = new Dictionary<string,string>{
                            {"SuperAdmin","#ef4444"},{"HospitalAdmin","#f59e0b"},
                            {"Doctor","#10b981"},{"Nurse","#06b6d4"},
                            {"Receptionist","#8b5cf6"},{"Patient","#ec4899"}
                        };
                    }
                    @foreach (var item in (SelectList)ViewBag.RoleSelectList)
                    {
                        var icon = roleIconMap.ContainsKey(item.Value) ? roleIconMap[item.Value] : "fa-user";
                        var color = roleColorMap.ContainsKey(item.Value) ? roleColorMap[item.Value] : "#6366f1";
                        <div class="role-card @(item.Selected ? "selected" : "")"
                             data-role="@item.Value" style="--role-color:@color;">
                            <div class="check-mark"><i class="fas fa-check"></i></div>
                            <div class="role-icon" style="color:@color;"><i class="fas @icon"></i></div>
                            <div class="role-name">@item.Text</div>
                        </div>
                    }
                </div>
                <span asp-validation-for="Role" class="text-danger small"></span>

                <div id="roleMessage" class="role-message"></div>
            </div>

            <div class="section-content" id="doctorSection">
                <div class="form-card">
                    <div class="section-badge"><i class="fas fa-stethoscope"></i> Professional Details</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="LicenseNumber"><i class="fas fa-id-card me-1" style="opacity:.5;"></i> License Number</label>
                                <input asp-for="LicenseNumber" class="form-control" placeholder="e.g. MED-12345" />
                                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="Specialization"><i class="fas fa-microscope me-1" style="opacity:.5;"></i> Specialization <span style="color:#ef4444;">*</span></label>
                                <input asp-for="Specialization" class="form-control" placeholder="e.g. Cardiology" />
                                <span asp-validation-for="Specialization" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="DepartmentId"><i class="fas fa-building me-1" style="opacity:.5;"></i> Department <span style="color:#ef4444;">*</span></label>
                                <select asp-for="DepartmentId" class="form-select" asp-items="@(ViewBag.Departments as SelectList)">
                                    <option value="">— Select Department —</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating-custom">
                                <label asp-for="YearsOfExperience"><i class="fas fa-calendar me-1" style="opacity:.5;"></i> Experience</label>
                                <input asp-for="YearsOfExperience" type="number" class="form-control" placeholder="0" min="0" max="60" />
                                <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating-custom">
                                <label asp-for="ConsultationFee"><i class="fas fa-coins me-1" style="opacity:.5;"></i> Fee</label>
                                <div class="input-group input-group-custom">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" placeholder="0.00" min="0" />
                                </div>
                                <span asp-validation-for="ConsultationFee" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating-custom">
                                <label asp-for="Bio"><i class="fas fa-pen me-1" style="opacity:.5;"></i> Bio</label>
                                <textarea asp-for="Bio" class="form-control" rows="2" placeholder="Brief professional background..." maxlength="1000"></textarea>
                                <span asp-validation-for="Bio" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="section-badge"><i class="fas fa-address-card"></i> Contact &amp; Personal</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="Phone"><i class="fas fa-phone me-1" style="opacity:.5;"></i> Phone <span style="color:#ef4444;">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="DateOfBirth"><i class="fas fa-cake-candles me-1" style="opacity:.5;"></i> Date of Birth <span style="color:#ef4444;">*</span></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="Gender"><i class="fas fa-venus-mars me-1" style="opacity:.5;"></i> Gender <span style="color:#ef4444;">*</span></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">— Select —</option>
                                    <option value="1">Male</option>
                                    <option value="2">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="NationalId"><i class="fas fa-passport me-1" style="opacity:.5;"></i> National ID <span style="color:#ef4444;">*</span></label>
                                <input asp-for="NationalId" class="form-control" placeholder="14-digit national ID" maxlength="14" />
                                <span asp-validation-for="NationalId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="section-content" id="patientSection">
                <div class="form-card">
                    <div class="section-badge"><i class="fas fa-user-injured"></i> Patient Information</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="Phone"><i class="fas fa-phone me-1" style="opacity:.5;"></i> Phone <span style="color:#ef4444;">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="DateOfBirth"><i class="fas fa-cake-candles me-1" style="opacity:.5;"></i> Date of Birth <span style="color:#ef4444;">*</span></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="Gender"><i class="fas fa-venus-mars me-1" style="opacity:.5;"></i> Gender <span style="color:#ef4444;">*</span></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">— Select —</option>
                                    <option value="1">Male</option>
                                    <option value="2">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label asp-for="NationalId"><i class="fas fa-passport me-1" style="opacity:.5;"></i> National ID <span style="color:#ef4444;">*</span></label>
                                <input asp-for="NationalId" class="form-control" placeholder="14-digit national ID" maxlength="14" />
                                <span asp-validation-for="NationalId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="section-badge mt-2" style="border-bottom-color:rgba(255,255,255,.04);"><i class="fas fa-map-pin"></i> Address</div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label><i class="fas fa-road me-1" style="opacity:.5;"></i> Street</label>
                                <input asp-for="Street" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label><i class="fas fa-city me-1" style="opacity:.5;"></i> City</label>
                                <input asp-for="City" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label><i class="fas fa-globe me-1" style="opacity:.5;"></i> Country</label>
                                <input asp-for="Country" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating-custom">
                                <label><i class="fas fa-mailbox me-1" style="opacity:.5;"></i> Postal Code</label>
                                <input asp-for="PostalCode" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-center mt-4">
                <button type="submit" class="submit-btn">
                    <i class="fas fa-user-plus me-2"></i>Create User
                </button>
                <a asp-action="Index" class="cancel-btn">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const rolePicker = document.getElementById('rolePicker');
    const roleHidden = document.getElementById('roleHidden');
    const roleCards  = rolePicker.querySelectorAll('.role-card');
    const roleMsg    = document.getElementById('roleMessage');
    const doctorSec  = document.getElementById('doctorSection');
    const patientSec = document.getElementById('patientSection');

    const msgMap = {
        'SuperAdmin':    { cls:'background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);color:#fca5a5;',
                           txt:'<i class="fas fa-crown me-2"></i>SuperAdmin has full system access. Only create for trusted administrators.' },
        'HospitalAdmin': { cls:'background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.2);color:#fcd34d;',
                           txt:'<i class="fas fa-hospital-user me-2"></i>HospitalAdmin can manage operations except creating other Admins.' },
        'Doctor':        { cls:'background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2);color:#6ee7b7;',
                           txt:'<i class="fas fa-user-md me-2"></i>A new Doctor record will be created automatically. Fill in all professional details below.' },
        'Nurse':         { cls:'background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.2);color:#67e8f9;',
                           txt:'<i class="fas fa-hand-holding-heart me-2"></i>Nurse account — standard staff registration.' },
        'Receptionist':  { cls:'background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.2);color:#c4b5fd;',
                           txt:'<i class="fas fa-headset me-2"></i>Receptionist account — standard staff registration.' },
        'Patient':       { cls:'background:rgba(236,72,153,.1);border:1px solid rgba(236,72,153,.2);color:#f9a8d4;',
                           txt:'<i class="fas fa-user-injured me-2"></i>A new Patient record will be created and linked automatically.' }
    };

    function selectRole(role) {
        roleCards.forEach(c => {
            c.classList.toggle('selected', c.dataset.role === role);
        });
        roleHidden.value = role;

        if (role && msgMap[role]) {
            var m = msgMap[role];
            roleMsg.style.cssText = m.cls + 'display:block;';
            roleMsg.innerHTML = m.txt;
        } else {
            roleMsg.style.display = 'none';
        }

        doctorSection.className  = 'section-content' + (role === 'Doctor' ? ' visible' : '');
        patientSection.className = 'section-content' + (role === 'Patient' ? ' visible' : '');
    }

    roleCards.forEach(function(card) {
        card.addEventListener('click', function() {
            selectRole(this.dataset.role);
        });
    });

    var initial = roleHidden.value || '';
    if (initial && document.querySelector('.role-card[data-role="' + initial + '"]')) {
        selectRole(initial);
    }

    var style = document.createElement('style');
    style.textContent = '.section-content.visible { display: block; }';
    document.head.appendChild(style);
})();
</script>
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
