@using HMS.BLL.Shared.Dtos.PatientModule.PatientDtos
@model PatientWithDetailsResultDto

@{
    ViewData["Title"] = "Patient — " + Model.FullName;
    var statusClass = Model.Status switch
    {
        "Active" => "status-active",
        "Inactive" => "status-inactive",
        "Deceased" => "status-deceased",
        "Transferred" => "status-transferred",
        _ => "status-inactive"
    };
    var bloodColor = Model.BloodType switch
    {
        "APositive" or "ANegative" => "#3b82f6",
        "BPositive" or "BNegative" => "#10b981",
        "OPositive" or "ONegative" => "#f59e0b",
        "ABPositive" or "ABNegative" => "#8b5cf6",
        _ => "#64748b"
    };
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-gray: #64748b;
            --hms-bg: #f0f4f8;
            --hms-card: #ffffff;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .profile-avatar { cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
        .profile-avatar:hover { transform: scale(1.03); box-shadow: 0 0 0 4px rgba(255,255,255,0.4); }

        .lightbox-overlay {
            position: fixed; inset: 0; z-index: 9999;
            background: rgba(0,0,0,0.75); display: none;
            align-items: center; justify-content: center;
            backdrop-filter: blur(4px); cursor: pointer;
        }
        .lightbox-overlay.show { display: flex; }
        .lightbox-overlay img {
            max-width: 90vw; max-height: 85vh; border-radius: 14px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            object-fit: contain; cursor: default;
            animation: lightboxIn 0.25s ease-out;
        }
        @@keyframes lightboxIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
        .lightbox-close {
            position: absolute; top: 20px; right: 28px;
            color: white; font-size: 2.2rem; font-weight: 300;
            cursor: pointer; opacity: 0.7; transition: opacity 0.15s;
            line-height: 1; text-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .lightbox-close:hover { opacity: 1; }

        .patient-profile-card {
            background: white;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
            border: 1px solid var(--hms-border);
        }

        .profile-header {
            background: linear-gradient(135deg, var(--hms-blue) 0%, var(--hms-blue-mid) 100%);
            padding: 28px 20px 20px;
            text-align: center;
            position: relative;
        }

        .profile-avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 3px solid rgba(255,255,255,0.3);
            margin: 0 auto 12px;
            object-fit: cover;
            background: rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
        }

        .profile-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: white;
            margin-bottom: 2px;
        }

        .profile-mrn {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.65);
            font-family: monospace;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 10px;
        }

        .status-active {
            background: rgba(16,185,129,0.2);
            color: #d1fae5;
        }

        .status-inactive {
            background: rgba(100,116,139,0.2);
            color: #f1f5f9;
        }

        .status-deceased {
            background: rgba(239,68,68,0.2);
            color: #fee2e2;
        }

        .status-transferred {
            background: rgba(245,158,11,0.2);
            color: #fef3c7;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            border-top: 1px solid var(--hms-border);
        }

        .profile-stat {
            padding: 14px 12px;
            text-align: center;
            border-right: 1px solid var(--hms-border);
            border-bottom: 1px solid var(--hms-border);
        }

            .profile-stat:nth-child(2), .profile-stat:nth-child(4) {
                border-right: none;
            }

        .profile-stat-value {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--hms-text);
        }

        .profile-stat-label {
            font-size: 0.72rem;
            color: var(--hms-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .profile-actions {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .btn-profile-action {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
        }

        .btn-edit-profile {
            background: #fef3c7;
            color: #92400e;
        }

            .btn-edit-profile:hover {
                background: #f59e0b;
                color: white;
            }

        .btn-upload-pic {
            background: #eff6ff;
            color: #1d4ed8;
        }

            .btn-upload-pic:hover {
                background: #3b82f6;
                color: white;
            }

        /* Quick links */
        .quick-links {
            padding: 0 16px 16px;
        }

        .quick-links-title {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--hms-text-muted);
            margin-bottom: 8px;
        }

        .quick-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 9px;
            font-size: 0.83rem;
            font-weight: 500;
            color: var(--hms-text);
            text-decoration: none;
            transition: background 0.12s;
            border: 1px solid transparent;
        }

            .quick-link:hover {
                background: #f0f4ff;
                border-color: #bfdbfe;
                color: var(--hms-blue-mid);
            }

            .quick-link .ql-icon {
                width: 28px;
                height: 28px;
                border-radius: 7px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.8rem;
            }

            .quick-link .badge {
                margin-left: auto;
                font-size: 0.7rem;
            }

        /* Tabs area */
        .detail-tabs-card {
            background: white;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
            border: 1px solid var(--hms-border);
        }

        .nav-tabs {
            border-bottom: 1px solid var(--hms-border);
            background: #f8faff;
            padding: 0 16px;
            flex-wrap: nowrap;
            overflow-x: auto;
        }

            .nav-tabs .nav-link {
                border: none;
                border-bottom: 3px solid transparent;
                padding: 14px 18px;
                font-size: 0.875rem;
                font-weight: 600;
                color: var(--hms-text-muted);
                white-space: nowrap;
                border-radius: 0;
                transition: all 0.15s;
            }

                .nav-tabs .nav-link.active {
                    color: var(--hms-blue-mid);
                    border-bottom-color: var(--hms-blue-mid);
                    background: transparent;
                }

                .nav-tabs .nav-link:hover:not(.active) {
                    color: var(--hms-text);
                    background: rgba(0,0,0,0.03);
                }

        .tab-content {
            padding: 24px;
        }

        /* Info section */
        .info-section {
            margin-bottom: 24px;
        }

        .info-section-title {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--hms-text-muted);
            border-bottom: 1px solid var(--hms-border);
            padding-bottom: 8px;
            margin-bottom: 16px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .info-item {
        }

        .info-label {
            font-size: 0.75rem;
            color: var(--hms-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 3px;
        }

        .info-value {
            font-size: 0.92rem;
            font-weight: 500;
            color: var(--hms-text);
        }

        /* Table inside tabs */
        .tab-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            .tab-table thead th {
                background: #f8faff;
                color: var(--hms-text-muted);
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                padding: 10px 14px;
                border-bottom: 1px solid var(--hms-border);
            }

            .tab-table tbody td {
                padding: 12px 14px;
                border-bottom: 1px solid var(--hms-border);
                font-size: 0.88rem;
            }

            .tab-table tbody tr:last-child td {
                border-bottom: none;
            }

            .tab-table tbody tr:hover td {
                background: #f8faff;
            }

        .sev-badge {
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
        }

        .sev-LifeThreatening {
            background: #fee2e2;
            color: #991b1b;
        }

        .sev-Severe {
            background: #fef3c7;
            color: #92400e;
        }

        .sev-Moderate {
            background: #dbeafe;
            color: #1e40af;
        }

        .sev-Mild {
            background: #d1fae5;
            color: #065f46;
        }

        .cond-badge {
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
        }

        .cond-active {
            background: #fef3c7;
            color: #92400e;
        }

        .cond-resolved {
            background: #d1fae5;
            color: #065f46;
        }

        .empty-tab {
            text-align: center;
            padding: 40px 20px;
            color: var(--hms-text-muted);
        }

            .empty-tab i {
                font-size: 2.5rem;
                opacity: 0.2;
                display: block;
                margin-bottom: 10px;
            }

        /* Blood type circle */
        .blood-type-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 800;
            color: white;
            margin: 0 auto 4px;
        }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Patient Details</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Patients</a></li>
                <li class="breadcrumb-item active">@Model.FullName</li>
            </ol>
        </div>
    </div>
}

<div class="row">
    <!-- Left: Profile Card -->
    <div class="col-md-3">
        <div class="patient-profile-card mb-4">
            <div class="profile-header">
                @if (!string.IsNullOrEmpty(Model.PictureUrl))
                {
                    <img src="@Model.PictureUrl" class="profile-avatar" alt="@Model.FullName" onclick="openLightbox(this.src)" />
                }
                else
                {
                    <div class="profile-avatar">
                        @(Model.FirstName?.Substring(0, 1).ToUpper())@(Model.LastName?.Substring(0, 1).ToUpper())
                    </div>
                }
                <div class="profile-name">@Model.FullName</div>
                <div class="profile-mrn">@Model.MedicalRecordNumber</div>
                <div>
                    <span class="status-badge @statusClass">
                        <i class="fas fa-circle" style="font-size:0.5rem"></i> @Model.Status
                    </span>
                </div>
            </div>

            <div class="profile-stats">
                <div class="profile-stat">
                    <div class="profile-stat-value">@Model.Age</div>
                    <div class="profile-stat-label">Age</div>
                </div>
                <div class="profile-stat">
                    <div class="profile-stat-value">@Model.Gender</div>
                    <div class="profile-stat-label">Gender</div>
                </div>
                <div class="profile-stat">
                    <div style="margin-bottom:2px">
                        <div class="blood-type-circle" style="background:@bloodColor">
                            @(Model.BloodType?.Replace("Positive", "+").Replace("Negative", "-") ?? "—")
                        </div>
                    </div>
                    <div class="profile-stat-label">Blood Type</div>
                </div>
                <div class="profile-stat">
                    <div class="profile-stat-value">@Model.RegistrationDate.ToString("MMM yy")</div>
                    <div class="profile-stat-label">Registered</div>
                </div>
            </div>

            <div class="profile-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-profile-action btn-edit-profile">
                    <i class="fas fa-edit"></i> Edit Patient
                </a>
                <div>
                    <form asp-action="UploadPicture" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="picForm">
                        @Html.AntiForgeryToken()
                        <input type="file" id="picInput" name="file" accept=".jpg,.jpeg,.png,.webp" style="display:none" onchange="document.getElementById('picForm').submit()" />
                        <button type="button" class="btn-profile-action btn-upload-pic w-100" onclick="document.getElementById('picInput').click()">
                            <i class="fas fa-camera"></i> Update Photo
                        </button>
                    </form>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="quick-links">
                <div class="quick-links-title">Clinical Sections</div>
                <a asp-action="Allergies" asp-route-id="@Model.Id" class="quick-link">
                    <div class="ql-icon" style="background:#fee2e2"><i class="fas fa-allergies" style="color:#dc2626"></i></div>
                    Allergies
                    @if (Model.Allergies.Any())
                    {
                        <span class="badge badge-danger badge-pill">@Model.Allergies.Count()</span>
                    }
                </a>
                <a asp-action="MedicalHistories" asp-route-id="@Model.Id" class="quick-link">
                    <div class="ql-icon" style="background:#dbeafe"><i class="fas fa-notes-medical" style="color:#2563ab"></i></div>
                    Medical History
                    @if (Model.MedicalHistories.Any())
                    {
                        <span class="badge badge-info badge-pill">@Model.MedicalHistories.Count()</span>
                    }
                </a>
                <a asp-action="EmergencyContacts" asp-route-id="@Model.Id" class="quick-link">
                    <div class="ql-icon" style="background:#d1fae5"><i class="fas fa-phone-alt" style="color:#059669"></i></div>
                    Emergency Contacts
                    @if (Model.EmergencyContacts.Any())
                    {
                        <span class="badge badge-success badge-pill">@Model.EmergencyContacts.Count()</span>
                    }
                </a>
                <a asp-action="Vitals" asp-route-id="@Model.Id" class="quick-link">
                    <div class="ql-icon" style="background:#fef3c7"><i class="fas fa-heartbeat" style="color:#d97706"></i></div>
                    Vital Signs
                </a>
                <a asp-action="Prescriptions" asp-route-id="@Model.Id" class="quick-link">
                    <div class="ql-icon" style="background:#ede9fe"><i class="fas fa-pills" style="color:#7c3aed"></i></div>
                    Prescriptions
                </a>
                <a asp-action="LabOrders" asp-route-id="@Model.Id" class="quick-link">
                    <div class="ql-icon" style="background:#ecfdf5"><i class="fas fa-flask" style="color:#10b981"></i></div>
                    Lab Orders
                </a>
            </div>
        </div>

        <!-- Deactivate Card -->
        @if (Model.Status == "Active")
        {
            <div class="patient-profile-card p-3">
                <p style="font-size:0.82rem;color:var(--hms-text-muted);margin-bottom:10px">
                    <i class="fas fa-exclamation-triangle mr-1 text-warning"></i>
                    Deactivating prevents this patient from booking appointments or receiving services.
                </p>
                <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure you want to deactivate @Model.FullName?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger btn-block" style="border-radius:9px;font-weight:600">
                        <i class="fas fa-ban mr-1"></i> Deactivate Patient
                    </button>
                </form>
            </div>
        }
    </div>

    <!-- Right: Tabs Detail Card -->
    <div class="col-md-9">
        <div class="detail-tabs-card">
            <ul class="nav nav-tabs" id="patientTab">
                <li class="nav-item">
                    <a class="nav-link active" href="#tab-info">
                        <i class="fas fa-info-circle mr-1"></i> Personal Info
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="Allergies" asp-route-id="@Model.Id">
                        <i class="fas fa-allergies mr-1"></i> Allergies
                        @if (Model.Allergies.Any())
                        {
                            <span class="badge badge-danger ml-1">@Model.Allergies.Count()</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="MedicalHistories" asp-route-id="@Model.Id">
                        <i class="fas fa-notes-medical mr-1"></i> Medical History
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EmergencyContacts" asp-route-id="@Model.Id">
                        <i class="fas fa-phone-alt mr-1"></i> Emergency Contacts
                    </a>
                </li>
            </ul>

            <div class="tab-content">
                <!-- INFO TAB -->
                <div class="tab-pane active" id="tab-info">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-section">
                                <div class="info-section-title"><i class="fas fa-user mr-1"></i> Personal Information</div>
                                <div class="info-grid">
                                    <div class="info-item">
                                        <div class="info-label">First Name</div>
                                        <div class="info-value">@Model.FirstName</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Last Name</div>
                                        <div class="info-value">@Model.LastName</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Date of Birth</div>
                                        <div class="info-value">@Model.DateOfBirth.ToString("dd MMM yyyy")</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">National ID</div>
                                        <div class="info-value" style="font-family:monospace">@Model.NationalId</div>
                                    </div>
                                </div>
                            </div>

                            <div class="info-section">
                                <div class="info-section-title"><i class="fas fa-envelope mr-1"></i> Contact Details</div>
                                <div class="info-grid">
                                    <div class="info-item">
                                        <div class="info-label">Phone</div>
                                        <div class="info-value">@Model.Phone</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Email</div>
                                        <div class="info-value" style="word-break:break-all">@Model.Email</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-section">
                                <div class="info-section-title"><i class="fas fa-map-marker-alt mr-1"></i> Address</div>
                                <div class="info-grid">
                                    <div class="info-item" style="grid-column:1/-1">
                                        <div class="info-label">Street</div>
                                        <div class="info-value">@(Model.Address?.Street ?? "—")</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">City</div>
                                        <div class="info-value">@(Model.Address?.City ?? "—")</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Country</div>
                                        <div class="info-value">@(Model.Address?.Country ?? "—")</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Postal Code</div>
                                        <div class="info-value">@(Model.Address?.PostalCode ?? "—")</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Registered On</div>
                                        <div class="info-value">@Model.RegistrationDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- NAVIGATION NOTE -->
                <div style="padding:24px;text-align:center;color:var(--hms-text-muted)">
                    <i class="fas fa-arrow-up" style="font-size:1.5rem;opacity:0.3;display:block;margin-bottom:8px"></i>
                    <p style="margin:0;font-weight:500">
                        Use the tabs above to view and manage Allergies, Medical History, and Emergency Contacts.
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Lightbox overlay -->
<div class="lightbox-overlay" id="lightbox" onclick="closeLightbox()">
    <span class="lightbox-close">&times;</span>
    <img id="lightboxImg" src="" alt="Profile photo" onclick="event.stopPropagation()" />
</div>

@section Scripts {
    <script>
        function openLightbox(src) {
            document.getElementById('lightboxImg').src = src;
            document.getElementById('lightbox').classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('show');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeLightbox();
        });
    </script>
}
