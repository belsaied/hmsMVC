@using HMS.BLL.Shared
@using HMS.BLL.Shared.Dtos.PatientModule.PatientDtos
@model PaginatedResult<PatientResultDto>

@{
    ViewData["Title"] = "Patients";
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-gray: #64748b;
            --hms-bg: #f0f4f8;
            --hms-card: #ffffff;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .patients-header {
            background: linear-gradient(135deg, var(--hms-blue) 0%, var(--hms-blue-mid) 100%);
            color: white;
            padding: 28px 32px;
            border-radius: 16px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 8px 32px rgba(26,58,92,0.18);
            position: relative;
            overflow: hidden;
        }

            .patients-header::before {
                content: '';
                position: absolute;
                top: -40px;
                right: -40px;
                width: 160px;
                height: 160px;
                background: rgba(255,255,255,0.07);
                border-radius: 50%;
            }

            .patients-header::after {
                content: '';
                position: absolute;
                bottom: -60px;
                right: 80px;
                width: 220px;
                height: 220px;
                background: rgba(255,255,255,0.04);
                border-radius: 50%;
            }

        .header-title {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin: 0;
        }

        .header-subtitle {
            font-size: 0.875rem;
            opacity: 0.75;
            margin-top: 4px;
        }

        .header-icon {
            font-size: 3rem;
            opacity: 0.2;
            position: absolute;
            right: 150px;
            top: 12px;
        }

        .search-card {
            background: var(--hms-card);
            border-radius: 14px;
            padding: 20px 24px;
            margin-bottom: 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            border: 1px solid var(--hms-border);
        }

        .patient-table-card {
            background: var(--hms-card);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
            border: 1px solid var(--hms-border);
        }

            .patient-table-card .table {
                margin: 0;
            }

            .patient-table-card thead th {
                background: var(--hms-blue);
                color: white;
                font-weight: 600;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                padding: 14px 16px;
                border: none;
            }

            .patient-table-card tbody tr {
                transition: background 0.15s;
                border-bottom: 1px solid var(--hms-border);
            }

                .patient-table-card tbody tr:hover {
                    background: #f8faff;
                }

            .patient-table-card tbody td {
                padding: 13px 16px;
                vertical-align: middle;
                color: var(--hms-text);
                font-size: 0.9rem;
                border: none;
            }

        .mrn-badge {
            background: #eff6ff;
            color: var(--hms-blue-mid);
            font-family: 'Courier New', monospace;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 6px;
            border: 1px solid #bfdbfe;
        }

        .patient-name {
            font-weight: 600;
            color: var(--hms-text);
        }

        .patient-meta {
            font-size: 0.8rem;
            color: var(--hms-text-muted);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .status-active {
            background: #d1fae5;
            color: #065f46;
        }

        .status-inactive {
            background: #f1f5f9;
            color: #475569;
        }

        .status-deceased {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-transferred {
            background: #fef3c7;
            color: #92400e;
        }

        .btn-action {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 0.82rem;
            transition: all 0.15s;
            border: none;
            cursor: pointer;
        }

        .btn-view {
            background: #e0f2fe;
            color: #0369a1;
        }

            .btn-view:hover {
                background: #0369a1;
                color: white;
            }

        .btn-edit {
            background: #fef9c3;
            color: #854d0e;
        }

            .btn-edit:hover {
                background: #d97706;
                color: white;
            }

        .btn-deactivate {
            background: #fee2e2;
            color: #991b1b;
        }

            .btn-deactivate:hover {
                background: #dc2626;
                color: white;
            }

        .pagination-footer {
            background: #f8faff;
            padding: 14px 20px;
            border-top: 1px solid var(--hms-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .pagination .page-link {
            border-radius: 8px !important;
            margin: 0 2px;
            border: 1px solid var(--hms-border);
            color: var(--hms-blue-mid);
            font-weight: 500;
            font-size: 0.875rem;
            min-width: 36px;
            text-align: center;
            padding: 6px 10px;
        }

        .pagination .page-item.active .page-link {
            background: var(--hms-blue);
            border-color: var(--hms-blue);
            color: white;
        }

        .stats-bar {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-chip {
            background: white;
            border: 1px solid var(--hms-border);
            border-radius: 10px;
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.875rem;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        }

        .stat-chip-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .stat-chip-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--hms-text);
        }

        .stat-chip-label {
            font-size: 0.75rem;
            color: var(--hms-text-muted);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--hms-text-muted);
        }

            .empty-state i {
                font-size: 3.5rem;
                opacity: 0.2;
                margin-bottom: 16px;
                display: block;
            }

        .search-input-group .form-control {
            border-radius: 10px 0 0 10px;
            border-right: none;
            border-color: var(--hms-border);
            font-size: 0.9rem;
            padding: 10px 14px;
        }

        .search-input-group .btn {
            border-radius: 0 10px 10px 0;
            border-color: var(--hms-border);
            background: white;
            color: var(--hms-gray);
            border-left: none;
        }

        .form-control:focus {
            box-shadow: 0 0 0 3px rgba(37,99,168,0.12);
            border-color: var(--hms-accent);
        }

        .select2-container .select2-selection--single {
            height: 42px !important;
            border-color: var(--hms-border);
            border-radius: 10px;
        }

        .select2-selection__rendered {
            line-height: 42px !important;
            padding: 0 14px !important;
        }

        .select2-selection__arrow {
            height: 42px !important;
        }

        .btn-add-patient {
            background: linear-gradient(135deg, var(--hms-accent), var(--hms-blue-mid));
            color: white;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-weight: 600;
            font-size: 0.875rem;
            box-shadow: 0 4px 12px rgba(14,165,233,0.3);
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-add-patient:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(14,165,233,0.4);
                color: white;
            }

        .btn-clear {
            border-radius: 10px;
            border: 1px solid var(--hms-border);
            background: white;
            color: var(--hms-gray);
            font-size: 0.875rem;
            padding: 9px 14px;
        }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Patient Management</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Patients</li>
            </ol>
        </div>
    </div>
}

<!-- Header Banner -->
<div class="patients-header">
    <div style="position:relative;z-index:1">
        <h2 class="header-title"><i class="fas fa-user-injured mr-2"></i> Patient Registry</h2>
        <p class="header-subtitle">Manage all hospital patients — registrations, records and clinical data</p>
    </div>
    <div style="position:relative;z-index:1">
        <a asp-action="Create" class="btn-add-patient">
            <i class="fas fa-plus"></i> Register New Patient
        </a>
    </div>
    <i class="fas fa-hospital-user header-icon"></i>
</div>

<!-- Stats Bar -->
<div class="stats-bar">
    <div class="stat-chip">
        <div class="stat-chip-icon" style="background:#dbeafe">
            <i class="fas fa-users" style="color:#2563a8"></i>
        </div>
        <div>
            <div class="stat-chip-value">@Model.TotalCount</div>
            <div class="stat-chip-label">Total Patients</div>
        </div>
    </div>
    <div class="stat-chip">
        <div class="stat-chip-icon" style="background:#d1fae5">
            <i class="fas fa-check-circle" style="color:#10b981"></i>
        </div>
        <div>
            <div class="stat-chip-value">@Model.Data.Count(p => p.Status == "Active")</div>
            <div class="stat-chip-label">Active on This Page</div>
        </div>
    </div>
    <div class="stat-chip">
        <div class="stat-chip-icon" style="background:#f1f5f9">
            <i class="fas fa-file-medical" style="color:#64748b"></i>
        </div>
        <div>
            <div class="stat-chip-value">@Model.PageIndex / @((int)Math.Ceiling((double)Model.TotalCount / Model.PageSize))</div>
            <div class="stat-chip-label">Current / Total Pages</div>
        </div>
    </div>
</div>

<!-- Search / Filter Bar -->
<div class="search-card">
    <form method="get" asp-action="Index">
        <div class="row align-items-end g-3">
            <div class="col-md-5">
                <label class="form-label" style="font-size:0.8rem;font-weight:600;color:var(--hms-text-muted);text-transform:uppercase;letter-spacing:0.05em">Search Patients</label>
                <div class="input-group search-input-group">
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control" placeholder="Search by name, MRN or email..." />
                    <div class="input-group-append">
                        <button type="submit" class="btn"><i class="fas fa-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-size:0.8rem;font-weight:600;color:var(--hms-text-muted);text-transform:uppercase;letter-spacing:0.05em">Status Filter</label>
                <select name="status" asp-items="ViewBag.StatusList"
                        class="form-control select2" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-auto">
                <a asp-action="Index" class="btn btn-clear">
                    <i class="fas fa-times mr-1"></i> Clear
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Patients Table -->
<div class="patient-table-card">
    <table class="table">
        <thead>
            <tr>
                <th><i class="fas fa-id-card mr-1"></i> MRN</th>
                <th><i class="fas fa-user mr-1"></i> Patient</th>
                <th><i class="fas fa-birthday-cake mr-1"></i> Age / Gender</th>
                <th><i class="fas fa-phone mr-1"></i> Contact</th>
                <th><i class="fas fa-heartbeat mr-1"></i> Status</th>
                <th style="width:120px; text-align:center"><i class="fas fa-ellipsis-h mr-1"></i> Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Data)
            {
                <tr>
                    <td><span class="mrn-badge">@p.MedicalRecordNumber</span></td>
                    <td>
                        <div class="patient-name">@p.FullName</div>
                        <div class="patient-meta">@p.Email</div>
                    </td>
                    <td>
                        <span class="patient-name">@p.Age yrs</span>
                        <span class="patient-meta"> · @p.Gender</span>
                    </td>
                    <td>
                        <div>@p.Phone</div>
                    </td>
                    <td>
                        @{
                            var (scls, sico) = p.Status switch
                            {
                                "Active" => ("status-active", "fa-check-circle"),
                                "Inactive" => ("status-inactive", "fa-pause-circle"),
                                "Deceased" => ("status-deceased", "fa-times-circle"),
                                "Transferred" => ("status-transferred", "fa-exchange-alt"),
                                _ => ("status-inactive", "fa-circle")
                            };
                        }
                        <span class="status-badge @scls">
                            <i class="fas @sico" style="font-size:0.7rem"></i> @p.Status
                        </span>
                    </td>
                    <td style="text-align:center">
                        <div style="display:flex;gap:6px;justify-content:center">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn-action btn-view" title="View Details">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn-action btn-edit" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            @if (p.Status == "Active")
                            {
                                <form asp-action="Deactivate" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate @p.FullName?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-action btn-deactivate" title="Deactivate">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Data.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <i class="fas fa-user-slash"></i>
                            <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No patients found</p>
                            <p style="font-size:0.875rem">Try adjusting your search or filter, or register a new patient.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    @{
        int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
        int from = (Model.PageIndex - 1) * Model.PageSize + 1;
        int to = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);
    }
    <div class="pagination-footer">
        <span style="font-size:0.875rem;color:var(--hms-text-muted)">
            Showing <strong>@from–@to</strong> of <strong>@Model.TotalCount</strong> patients
        </span>
        @if (totalPages > 1)
        {
            <ul class="pagination mb-0">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageIndex="@(Model.PageIndex - 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-status="@ViewBag.Status"><i class="fas fa-chevron-left" style="font-size:0.7rem"></i></a>
                </li>
                @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(totalPages, Model.PageIndex + 2); i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageIndex="@i"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.Status">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageIndex == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageIndex="@(Model.PageIndex + 1)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-status="@ViewBag.Status"><i class="fas fa-chevron-right" style="font-size:0.7rem"></i></a>
                </li>
            </ul>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({ theme: 'classic', width: '100%' });
        });
    </script>
}
