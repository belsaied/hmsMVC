@using HMS.BLL.Shared.Dtos.MedicalRecordsDto
@model IEnumerable<PrescriptionResultDto>

@{
    ViewData["Title"] = "Prescriptions — " + ViewBag.PatientName;
}

@section Styles {
    <style>
        .mrc-link {
            background: rgba(255,255,255,0.12); color: white; border: none;
            border-radius: 10px; padding: 6px 14px; font-size: 0.78rem; font-weight: 600;
            text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
        }
        .mrc-link:hover { background: rgba(255,255,255,0.22); color: white; text-decoration: none; }
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg, #6d28d9 0%, #8b5cf6 100%);
            color: white; padding: 24px 28px; border-radius: 16px; margin-bottom: 24px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 8px 32px rgba(139,92,246,0.18);
        }
        .page-title { font-size: 1.4rem; font-weight: 700; margin: 0; }
        .page-subtitle { font-size: 0.84rem; opacity: 0.75; margin: 4px 0 0; }
        .patient-badge {
            background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 10px; font-size: 0.82rem;
        }
        .patient-badge strong { color: white; }
        .mrn-code { font-family: monospace; font-weight: 700; }

        .content-card {
            background: white; border-radius: 14px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
            border: 1px solid var(--hms-border); overflow: hidden;
        }
        .card-header {
            padding: 18px 20px; border-bottom: 1px solid var(--hms-border);
            background: #f8faff; display: flex; align-items: center; justify-content: space-between;
        }
        .card-header h5 { margin: 0; font-weight: 700; font-size: 0.95rem; }

        .table { margin: 0; }
        .table thead th {
            background: var(--hms-blue); color: white; font-weight: 600;
            font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 12px 16px; border: none;
        }
        .table tbody td {
            padding: 12px 16px; vertical-align: middle;
            border-bottom: 1px solid var(--hms-border); font-size: 0.88rem;
        }
        .table tbody tr:hover td { background: #f8faff; }

        .empty-state { text-align: center; padding: 50px 20px; color: var(--hms-text-muted); }
        .empty-state i { font-size: 3rem; opacity: 0.2; display: block; margin-bottom: 12px; }

        .btn-back {
            background: white; color: var(--hms-text-muted);
            border: 1.5px solid var(--hms-border); border-radius: 10px;
            padding: 9px 18px; font-weight: 600; font-size: 0.875rem;
            text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-back:hover { background: #f1f5f9; color: var(--hms-text); }

        .med-name { font-weight: 700; color: var(--hms-text); }
        .med-dosage { font-size: 0.82rem; color: var(--hms-text-muted); }
        .med-frequency { display: inline-block; }

        .rx-status-active { background: #d1fae5; color: #065f46; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
        .rx-status-completed { background: #dbeafe; color: #1e40af; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
        .rx-status-cancelled { background: #fee2e2; color: #991b1b; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
        .rx-status-expired { background: #f1f5f9; color: #475569; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }

        .controlled-badge {
            background: #fef3c7; color: #92400e; padding: 2px 8px;
            border-radius: 8px; font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
            margin-left: 6px;
        }

        .prescription-grid { display: grid; gap: 16px; }
        .rx-card {
            background: white; border: 1px solid var(--hms-border); border-radius: 14px;
            padding: 20px; box-shadow: 0 1px 6px rgba(0,0,0,0.04);
            transition: box-shadow 0.15s;
        }
        .rx-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .rx-card .rx-header {
            display: flex; align-items: flex-start; justify-content: space-between;
            margin-bottom: 12px;
        }
        .rx-card .rx-icon {
            width: 42px; height: 42px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; flex-shrink: 0;
        }
        .rx-card .rx-body { padding-left: 0; }
        .rx-meta { font-size: 0.8rem; color: var(--hms-text-muted); }
    </style>
}

<div class="page-header-card">
    <div>
        <h3 class="page-title"><i class="fas fa-pills mr-2"></i> Prescriptions</h3>
        <p class="page-subtitle">View all prescribed medications for this patient</p>
    </div>
    <div class="patient-badge">
        <strong>@ViewBag.PatientName</strong>
        <span> · </span>
        <span class="mrn-code">@ViewBag.MedicalRecordNumber</span>
        <a asp-controller="MedicalRecords" asp-action="PatientRecords" asp-route-patientId="@ViewBag.PatientId" class="mrc-link ml-2">
            <i class="fas fa-notes-medical mr-1"></i> Records
        </a>
    </div>
</div>

<div class="content-card">
    <div class="card-header">
        <h5><i class="fas fa-list mr-1"></i> Medication Prescriptions</h5>
        <span style="font-size:0.85rem;color:var(--hms-text-muted)">@Model.Count() prescription(s)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-prescription-bottle-alt"></i>
            <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No prescriptions found</p>
            <p style="font-size:0.875rem">Prescriptions will appear here once a doctor prescribes medication.</p>
        </div>
    }
    else
    {
        <div style="padding:20px">
            <div class="prescription-grid">
                @foreach (var rx in Model)
                {
                    var (rxClass, rxLabel) = rx.Status switch
                    {
                        "Active" => ("rx-status-active", "Active"),
                        "Completed" => ("rx-status-completed", "Completed"),
                        "Cancelled" => ("rx-status-cancelled", "Cancelled"),
                        "Expired" => ("rx-status-expired", "Expired"),
                        _ => ("rx-status-expired", rx.Status)
                    };

                    <div class="rx-card">
                        <div class="rx-header">
                            <div style="display:flex;align-items:flex-start;gap:14px;flex:1">
                                <div class="rx-icon" style="background:#ede9fe">
                                    <i class="fas fa-prescription-bottle" style="color:#7c3aed"></i>
                                </div>
                                <div class="rx-body" style="flex:1">
                                    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:6px">
                                        <span class="med-name">@rx.MedicationName</span>
                                        @if (rx.IsControlledSubstance)
                                        {
                                            <span class="controlled-badge"><i class="fas fa-exclamation-triangle mr-1"></i> Controlled</span>
                                        }
                                    </div>
                                    <div class="med-dosage">
                                        @rx.Dosage · @rx.Frequency · @rx.DurationDays day(s)
                                    </div>
                                    @if (!string.IsNullOrEmpty(rx.Instructions))
                                    {
                                        <div style="margin-top:6px;font-size:0.82rem;color:var(--hms-text);padding:8px 12px;background:#f8faff;border-radius:8px">
                                            <i class="fas fa-info-circle mr-1" style="color:var(--hms-blue-mid)"></i>
                                            @rx.Instructions
                                        </div>
                                    }
                                </div>
                            </div>
                            <div style="text-align:right;flex-shrink:0">
                                <div><span class="@rxClass">@rxLabel</span></div>
                                <div style="margin-top:6px">
                                    <a asp-action="DownloadPrescriptionPdf" asp-route-id="@ViewBag.PatientId" asp-route-prescriptionId="@rx.Id"
                                       class="btn btn-sm btn-outline-primary" style="border-radius:8px;font-size:0.72rem;padding:2px 10px" title="Download PDF">
                                        <i class="fas fa-download"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="rx-meta" style="border-top:1px solid var(--hms-border);padding-top:10px;margin-top:4px">
                            <i class="fas fa-calendar-alt mr-1"></i> Prescribed: @rx.PrescribedAt.ToString("dd MMM yyyy")
                            <span class="mx-2">·</span>
                            <i class="fas fa-hourglass-end mr-1"></i> Expires: @rx.ExpiresAt.ToString("dd MMM yyyy")
                            @if (rx.DoctorId > 0)
                            {
                                <span class="mx-2">·</span>
                                <span><i class="fas fa-user-md mr-1"></i> Doctor ID: @(rx.DoctorId)</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div style="margin-top:20px">
    <a asp-action="Details" asp-route-id="@ViewBag.PatientId" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Patient
    </a>
</div>

@section Scripts {
    <script>
        $(document).ready(function () { });
    </script>
}
