@using HMS.BLL.Shared.Dtos.PatientModule.EmergencyContactsDtos
@model IEnumerable<EmergencyContactResultDto>

@{
    ViewData["Title"] = "Emergency Contacts — " + ViewBag.PatientName;
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg, #065f46 0%, #10b981 100%);
            color: white; padding: 24px 28px; border-radius: 16px; margin-bottom: 24px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 8px 32px rgba(16,185,129,0.18);
        }
        .page-title { font-size: 1.4rem; font-weight: 700; margin: 0; }
        .page-subtitle { font-size: 0.84rem; opacity: 0.75; margin: 4px 0 0; }
        .patient-badge {
            background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 10px; font-size: 0.82rem;
        }
        .patient-badge strong { color: white; }
        .mrn-code { font-family: monospace; font-weight: 700; }

        .content-card {
            background: white; border-radius: 14px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
            border: 1px solid var(--hms-border); overflow: hidden;
        }
        .card-header {
            padding: 18px 20px; border-bottom: 1px solid var(--hms-border);
            background: #f8faff; display: flex; align-items: center; justify-content: space-between;
        }
        .card-header h5 { margin: 0; font-weight: 700; font-size: 0.95rem; }

        .table { margin: 0; }
        .table thead th {
            background: var(--hms-blue); color: white; font-weight: 600;
            font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 12px 16px; border: none;
        }
        .table tbody td {
            padding: 12px 16px; vertical-align: middle;
            border-bottom: 1px solid var(--hms-border); font-size: 0.88rem;
        }
        .table tbody tr:hover td { background: #f8faff; }

        .empty-state { text-align: center; padding: 50px 20px; color: var(--hms-text-muted); }
        .empty-state i { font-size: 3rem; opacity: 0.2; display: block; margin-bottom: 12px; }

        .form-label { font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; }
        .form-control {
            border-radius: 10px; border: 1.5px solid var(--hms-border);
            padding: 10px 14px; font-size: 0.9rem;
        }
        .form-control:focus { border-color: var(--hms-accent); box-shadow: 0 0 0 3px rgba(14,165,233,0.12); }
        .btn-add {
            background: linear-gradient(135deg, #10b981, #065f46);
            color: white; border: none; border-radius: 10px;
            padding: 10px 22px; font-weight: 700; font-size: 0.9rem;
            box-shadow: 0 4px 14px rgba(16,185,129,0.3);
            transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-add:hover { transform: translateY(-1px); color: white; }
        .btn-back {
            background: white; color: var(--hms-text-muted);
            border: 1.5px solid var(--hms-border); border-radius: 10px;
            padding: 9px 18px; font-weight: 600; font-size: 0.875rem;
            text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-back:hover { background: #f1f5f9; color: var(--hms-text); }

        .btn-sm-action {
            width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
            border-radius: 8px; font-size: 0.82rem; border: none; cursor: pointer; transition: all 0.15s;
        }
        .btn-edit-contact { background: #fef3c7; color: #92400e; }
        .btn-edit-contact:hover { background: #f59e0b; color: white; }
        .btn-del-contact { background: #fee2e2; color: #991b1b; }
        .btn-del-contact:hover { background: #dc2626; color: white; }

        .primary-badge {
            background: #d1fae5; color: #065f46; padding: 2px 10px;
            border-radius: 12px; font-size: 0.7rem; font-weight: 600;
        }

        .update-row { background: #fffbeb; }
        .update-row td { padding: 16px !important; }
        .btn-sm-save {
            background: #10b981; color: white; border: none;
            border-radius: 8px; padding: 6px 14px; font-size: 0.8rem; font-weight: 600;
        }
        .btn-sm-save:hover { background: #065f46; }

        .form-section-card {
            background: #f8faff; border-radius: 12px; padding: 20px;
            border: 1px dashed var(--hms-border);
        }
    </style>
}

<div class="page-header-card">
    <div>
        <h3 class="page-title"><i class="fas fa-phone-alt mr-2"></i> Emergency Contacts</h3>
        <p class="page-subtitle">Manage emergency contact persons for this patient</p>
    </div>
    <div class="patient-badge">
        <strong>@ViewBag.PatientName</strong>
        <span> · </span>
        <span class="mrn-code">@ViewBag.MedicalRecordNumber</span>
    </div>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="content-card">
            <div class="card-header">
                <h5><i class="fas fa-plus-circle mr-1" style="color:#10b981"></i> Add Contact</h5>
            </div>
            <div style="padding:20px">
                <form asp-action="AddEmergencyContact" asp-route-id="@ViewBag.PatientId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label">Full Name <span style="color:#ef4444">*</span></label>
                        <input name="Name" class="form-control" placeholder="Contact full name" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Relationship <span style="color:#ef4444">*</span></label>
                                <input name="Relationship" class="form-control" placeholder="e.g. Spouse" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Phone <span style="color:#ef4444">*</span></label>
                                <input name="Phone" class="form-control" placeholder="Phone number" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input name="Email" type="email" class="form-control" placeholder="Email address" />
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="isPrimary" name="IsPrimaryContact" value="true" />
                            <label class="custom-control-label" for="isPrimary" style="font-weight:600">Primary Contact</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Notes</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="Additional notes"></textarea>
                    </div>
                    <button type="submit" class="btn-add w-100 justify-content-center">
                        <i class="fas fa-save"></i> Add Contact
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="content-card">
            <div class="card-header">
                <h5><i class="fas fa-list mr-1"></i> Contact List</h5>
                <span style="font-size:0.85rem;color:var(--hms-text-muted)">@Model.Count() contact(s)</span>
            </div>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-phone-slash"></i>
                    <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No emergency contacts</p>
                    <p style="font-size:0.875rem">Use the form to add an emergency contact.</p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Relationship</th>
                            <th>Phone</th>
                            <th>Primary</th>
                            <th style="width:80px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td><strong>@c.Name</strong></td>
                                <td>@c.Relationship</td>
                                <td>@c.Phone</td>
                                <td>
                                    @if (c.IsPrimaryContact)
                                    {
                                        <span class="primary-badge"><i class="fas fa-check-circle mr-1"></i> Primary</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;gap:4px">
                                        <button type="button" class="btn-sm-action btn-edit-contact"
                                                onclick="$('#update-contact-@c.Id').toggle()" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form asp-action="DeleteEmergencyContact" asp-route-id="@ViewBag.PatientId" asp-route-contactId="@c.Id"
                                              method="post" onsubmit="return confirm('Remove @c.Name from emergency contacts?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-sm-action btn-del-contact" title="Remove">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <tr id="update-contact-@c.Id" class="update-row" style="display:none">
                                <td colspan="5">
                                    <form asp-action="UpdateEmergencyContact" asp-route-id="@ViewBag.PatientId" asp-route-contactId="@c.Id"
                                          method="post" class="update-form">
                                        @Html.AntiForgeryToken()
                                        <div class="row">
                                            <div class="col-md-3">
                                                <label style="font-size:0.75rem;font-weight:600">Name</label>
                                                <input name="Name" class="form-control" value="@c.Name" />
                                            </div>
                                            <div class="col-md-2">
                                                <label style="font-size:0.75rem;font-weight:600">Relationship</label>
                                                <input name="Relationship" class="form-control" value="@c.Relationship" />
                                            </div>
                                            <div class="col-md-2">
                                                <label style="font-size:0.75rem;font-weight:600">Phone</label>
                                                <input name="Phone" class="form-control" value="@c.Phone" />
                                            </div>
                                            <div class="col-md-3">
                                                <label style="font-size:0.75rem;font-weight:600">Email</label>
                                                <input name="Email" class="form-control" value="@c.Email" />
                                            </div>
                                            <div class="col-md-2" style="display:flex;align-items:flex-end">
                                                <button type="submit" class="btn-sm-save">
                                                    <i class="fas fa-check mr-1"></i> Save
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<div style="margin-top:20px">
    <a asp-action="Details" asp-route-id="@ViewBag.PatientId" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Patient
    </a>
</div>

@section Scripts {
    <script>
        $(document).ready(function () { $('.select2').select2({ theme: 'classic', width: '100%' }); });
    </script>
}
