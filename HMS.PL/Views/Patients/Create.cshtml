@using HMS.BLL.Shared.Dtos.PatientModule.PatientDtos
@model CreatePatientDto

@{
    ViewData["Title"] = "Register Patient";
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .reg-header {
            background: linear-gradient(135deg, var(--hms-blue) 0%, #1e4d8c 100%);
            color: white;
            padding: 24px 32px;
            border-radius: 16px 16px 0 0;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .reg-header-icon {
            width: 52px;
            height: 52px;
            background: rgba(255,255,255,0.15);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .reg-header-title {
            font-size: 1.3rem;
            font-weight: 700;
            margin: 0;
        }

        .reg-header-sub {
            font-size: 0.84rem;
            opacity: 0.7;
            margin: 2px 0 0;
        }

        .reg-body {
            background: white;
            border-radius: 0 0 16px 16px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.09);
            border: 1px solid var(--hms-border);
            border-top: none;
        }

        .form-section {
            padding: 28px 32px;
            border-bottom: 1px solid var(--hms-border);
        }

            .form-section:last-child {
                border-bottom: none;
            }

        .section-title {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--hms-text-muted);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #f1f5f9;
        }

        .section-title-icon {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.82rem;
        }

        .form-label {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--hms-text);
            margin-bottom: 6px;
        }

        .form-control {
            border-radius: 10px;
            border: 1.5px solid var(--hms-border);
            padding: 10px 14px;
            font-size: 0.9rem;
            color: var(--hms-text);
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .form-control:focus {
                border-color: var(--hms-accent);
                box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
                outline: none;
            }

        .text-danger.small {
            font-size: 0.78rem;
            margin-top: 4px;
            display: block;
        }

        .select2-container .select2-selection--single {
            height: 44px !important;
            border: 1.5px solid var(--hms-border) !important;
            border-radius: 10px !important;
        }

        .select2-selection__rendered {
            line-height: 44px !important;
            padding: 0 14px !important;
            font-size: 0.9rem;
        }

        .select2-selection__arrow {
            height: 44px !important;
        }

        .form-footer {
            padding: 20px 32px;
            background: #f8faff;
            border-radius: 0 0 16px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-top: 1px solid var(--hms-border);
        }

        .btn-submit {
            background: linear-gradient(135deg, var(--hms-blue-mid), var(--hms-blue));
            color: white;
            border: none;
            border-radius: 10px;
            padding: 11px 28px;
            font-weight: 700;
            font-size: 0.9rem;
            box-shadow: 0 4px 14px rgba(37,99,168,0.3);
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-submit:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(37,99,168,0.4);
                color: white;
            }

        .btn-cancel {
            background: white;
            color: var(--hms-text-muted);
            border: 1.5px solid var(--hms-border);
            border-radius: 10px;
            padding: 10px 22px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.15s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

            .btn-cancel:hover {
                background: #f1f5f9;
                color: var(--hms-text);
            }

        .required-star {
            color: #ef4444;
            margin-left: 3px;
        }

        .alert-validation {
            border-radius: 10px;
            border: none;
            background: #fef2f2;
            border-left: 4px solid #ef4444;
            color: #991b1b;
            padding: 14px 18px;
            font-size: 0.875rem;
            margin: 20px 32px 0;
        }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Register Patient</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Patients</a></li>
                <li class="breadcrumb-item active">Register</li>
            </ol>
        </div>
    </div>
}

<div>
    <div class="reg-header">
        <div class="reg-header-icon"><i class="fas fa-user-plus"></i></div>
        <div>
            <div class="reg-header-title">New Patient Registration</div>
            <div class="reg-header-sub">Fill in all required fields to register a new patient</div>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewContext.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert-validation"></div>
        }

        <div class="reg-body">

            <!-- Section 1: Personal Info -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-title-icon" style="background:#dbeafe"><i class="fas fa-user" style="color:#2563a8"></i></div>
                    Personal Information
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="FirstName" class="form-label">First Name <span class="required-star">*</span></label>
                            <input asp-for="FirstName" class="form-control" placeholder="e.g. Ahmed" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="LastName" class="form-label">Last Name <span class="required-star">*</span></label>
                            <input asp-for="LastName" class="form-control" placeholder="e.g. Hassan" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth <span class="required-star">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Gender" class="form-label">Gender <span class="required-star">*</span></label>
                            <select asp-for="Gender" asp-items="ViewBag.GenderList" class="form-control select2">
                                <option value="">— Select Gender —</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="BloodType" class="form-label">Blood Type</label>
                            <select asp-for="BloodType" asp-items="ViewBag.BloodTypeList" class="form-control select2">
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Identity & Contact -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-title-icon" style="background:#d1fae5"><i class="fas fa-id-card" style="color:#059669"></i></div>
                    Identity & Contact
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="NationalId" class="form-label">National ID <span class="required-star">*</span></label>
                            <input asp-for="NationalId" class="form-control" placeholder="14-digit national ID" maxlength="14" />
                            <span asp-validation-for="NationalId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Phone" class="form-label">Phone <span class="required-star">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="e.g. 01012345678" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email Address <span class="required-star">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="patient@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <!-- Section 3: Address -->
            <div class="form-section">
                <div class="section-title">
                    <div class="section-title-icon" style="background:#fef3c7"><i class="fas fa-map-marker-alt" style="color:#d97706"></i></div>
                    Address
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Address.Street" class="form-label">Street</label>
                            <input asp-for="Address.Street" class="form-control" placeholder="Street address" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Address.City" class="form-label">City</label>
                            <input asp-for="Address.City" class="form-control" placeholder="City" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Address.Country" class="form-label">Country</label>
                            <input asp-for="Address.Country" class="form-control" placeholder="Country" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Address.PostalCode" class="form-label">Postal Code</label>
                            <input asp-for="Address.PostalCode" class="form-control" placeholder="Postal code" />
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="form-footer">
            <button type="submit" class="btn-submit">
                <i class="fas fa-user-check"></i> Register Patient
            </button>
            <a asp-action="Index" class="btn-cancel">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('.select2').select2({ theme: 'classic', width: '100%' });
            $('[type="date"]').attr('max', new Date().toISOString().split('T')[0]);
        });
    </script>
}
