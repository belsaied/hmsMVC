@using HMS.BLL.Shared.Dtos.WardBedModule.AdmissionDtos
@model IEnumerable<AdmissionResultDto>

@{
    ViewData["Title"] = "Active Admissions";
    var list = Model?.ToList() ?? [];
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg,#059669,#10b981);
            color: white;
            padding: 24px 32px;
            border-radius: 16px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }

        .table-card {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 2px 16px rgba(0,0,0,.07);
            border: 1px solid var(--hms-border);
        }

            .table-card thead th {
                background: var(--hms-blue);
                color: white;
                font-weight: 600;
                font-size: .8rem;
                text-transform: uppercase;
                letter-spacing: .06em;
                padding: 14px 16px;
                border: none;
            }

            .table-card tbody td {
                padding: 12px 16px;
                vertical-align: middle;
                border: none;
                font-size: .88rem;
            }

            .table-card tbody tr {
                border-bottom: 1px solid var(--hms-border);
                transition: background .15s;
            }

                .table-card tbody tr:hover {
                    background: #f8faff;
                }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: .75rem;
            font-weight: 600;
        }

        .status-Active {
            background: #d1fae5;
            color: #065f46;
        }

        .status-Discharged {
            background: #e0e7ff;
            color: #3730a3;
        }

        .btn-action {
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            font-size: .8rem;
            transition: all .15s;
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-view-action {
            background: #e0f2fe;
            color: #0369a1;
        }

            .btn-view-action:hover {
                background: #0369a1;
                color: white;
            }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--hms-muted);
        }

        .stat-row {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-chip {
            background: white;
            border: 1px solid var(--hms-border);
            border-radius: 10px;
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Admissions</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Wards</a></li>
                <li class="breadcrumb-item active">Admissions</li>
            </ol>
        </div>
    </div>
}

<div class="page-header-card">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
        <div>
            <h2 style="font-size:1.5rem;font-weight:700;margin:0">
                <i class="fas fa-procedures mr-2"></i> Active Admissions
            </h2>
            <p style="font-size:.875rem;opacity:.75;margin-top:4px">Currently admitted patients · @list.Count total</p>
        </div>
        <a asp-action="Admit" class="btn btn-light" style="border-radius:9px;font-weight:600">
            <i class="fas fa-plus mr-1"></i> Admit Patient
        </a>
    </div>
</div>

<div class="stat-row">
    <div class="stat-chip">
        <div style="width:36px;height:36px;border-radius:9px;background:#d1fae5;display:flex;align-items:center;justify-content:center"><i class="fas fa-user-injured" style="color:#10b981"></i></div>
        <div><div style="font-size:1.1rem;font-weight:700">@list.Count(a => a.Status == "Active")</div><div style="font-size:.7rem;color:var(--hms-muted)">Active</div></div>
    </div>
    <div class="stat-chip">
        <div style="width:36px;height:36px;border-radius:9px;background:#e0e7ff;display:flex;align-items:center;justify-content:center"><i class="fas fa-check" style="color:#3730a3"></i></div>
        <div><div style="font-size:1.1rem;font-weight:700">@list.Count(a => a.Status == "Discharged")</div><div style="font-size:.7rem;color:var(--hms-muted)">Discharged</div></div>
    </div>
</div>

<div class="table-card">
    <table class="table">
        <thead>
            <tr>
                <th><i class="fas fa-hashtag mr-1"></i> ID</th>
                <th><i class="fas fa-user mr-1"></i> Patient</th>
                <th><i class="fas fa-bed mr-1"></i> Bed / Room / Ward</th>
                <th><i class="fas fa-user-md mr-1"></i> Doctor</th>
                <th><i class="fas fa-calendar mr-1"></i> Admitted</th>
                <th><i class="fas fa-circle mr-1"></i> Status</th>
                <th style="width:60px;text-align:center"><i class="fas fa-ellipsis-h"></i></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in list.OrderByDescending(x => x.AdmissionDate))
            {
                <tr>
                    <td><span style="font-weight:700">#@a.Id</span></td>
                    <td>
                        <div style="font-weight:600">@a.PatientName</div>
                        <div style="font-size:.78rem;color:var(--hms-muted)">Patient ID: @a.PatientId</div>
                    </td>
                    <td>
                        <div style="font-weight:600">Bed @a.BedNumber</div>
                        <div style="font-size:.78rem;color:var(--hms-muted)">Room @a.RoomNumber · @a.WardName</div>
                    </td>
                    <td style="font-weight:500">Dr. @a.DoctorName</td>
                    <td>
                        <div style="font-weight:600">@a.AdmissionDate.ToString("dd MMM yyyy")</div>
                        <div style="font-size:.78rem;color:var(--hms-muted)">@a.AdmissionDate.ToString("hh:mm tt")</div>
                    </td>
                    <td>
                        <span class="status-badge status-@a.Status">@a.Status</span>
                    </td>
                    <td style="text-align:center">
                        <a asp-action="AdmissionDetails" asp-route-id="@a.Id" class="btn-action btn-view-action" title="View">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!list.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <i class="fas fa-procedures"></i>
                            <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No admissions found</p>
                            <a asp-action="Admit" class="btn btn-primary mt-2" style="border-radius:9px;font-weight:600">
                                <i class="fas fa-plus mr-1"></i> Admit a Patient
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary" style="border-radius:9px;font-weight:600">
        <i class="fas fa-arrow-left mr-1"></i> Back to Wards
    </a>
</div>
