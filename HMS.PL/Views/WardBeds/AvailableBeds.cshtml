@using HMS.BLL.Shared.Dtos.WardBedModule.BedDtos
@model IEnumerable<BedAvailabilityResultDto>

@{
    ViewData["Title"] = "Available Beds";
    var beds = Model?.ToList() ?? [];
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg,var(--hms-blue),var(--hms-blue-mid));
            color: white;
            padding: 24px 32px;
            border-radius: 16px;
            margin-bottom: 24px;
        }

        .filter-card {
            background: white;
            border: 1px solid var(--hms-border);
            border-radius: 14px;
            padding: 20px 24px;
            margin-bottom: 20px;
        }

        .bed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px,1fr));
            gap: 16px;
        }

        .bed-card {
            background: white;
            border: 1px solid var(--hms-border);
            border-radius: 14px;
            padding: 18px;
            transition: box-shadow .15s;
        }

            .bed-card:hover {
                box-shadow: 0 4px 16px rgba(0,0,0,.08);
            }

        .bed-type-badge {
            padding: 2px 10px;
            border-radius: 8px;
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--hms-muted);
        }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Available Beds</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Wards</a></li>
                <li class="breadcrumb-item active">Available Beds</li>
            </ol>
        </div>
    </div>
}

<div class="page-header-card">
    <div>
        <h2 style="font-size:1.5rem;font-weight:700;margin:0">
            <i class="fas fa-bed mr-2"></i> Available Beds
        </h2>
        <p style="font-size:.875rem;opacity:.75;margin-top:4px">
            @beds.Count bed(s) currently available across all wards
        </p>
    </div>
</div>

<div class="filter-card">
    <form method="get" asp-action="AvailableBeds">
        <div class="row align-items-end g-2">
            <div class="col-md-4">
                <label class="form-label" style="font-size:.78rem;font-weight:600;color:var(--hms-muted);text-transform:uppercase">Ward Type</label>
                <select name="wardType" asp-items="ViewBag.WardTypeList" class="form-control" onchange="this.form.submit()">
                    <option value="">All Ward Types</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:.78rem;font-weight:600;color:var(--hms-muted);text-transform:uppercase">Bed Type</label>
                <select name="bedType" asp-items="ViewBag.BedTypeList" class="form-control" onchange="this.form.submit()">
                    <option value="">All Bed Types</option>
                </select>
            </div>
            <div class="col-md-auto">
                <a asp-action="AvailableBeds" class="btn btn-secondary btn-sm" style="border-radius:8px;padding:8px 14px">
                    <i class="fas fa-times mr-1"></i> Clear
                </a>
            </div>
        </div>
    </form>
</div>

@if (beds.Count == 0)
{
    <div class="bed-card">
        <div class="empty-state">
            <i class="fas fa-bed" style="font-size:3rem"></i>
            <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No available beds found</p>
            <p>Try adjusting the filter criteria.</p>
        </div>
    </div>
}
else
{
    <div class="bed-grid">
        @foreach (var b in beds)
        {
            <div class="bed-card">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px">
                    <div>
                        <div style="font-weight:700;font-size:1rem">Bed @b.BedNumber</div>
                        <div style="font-size:.8rem;color:var(--hms-muted)">@b.WardName · Room @b.RoomNumber</div>
                    </div>
                    <span class="bed-type-badge" style="background:#dbeafe;color:#1e40af">@b.BedType</span>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;font-size:.78rem;color:var(--hms-muted);margin-bottom:10px">
                    <span><i class="fas fa-tag mr-1"></i>@b.WardType</span>
                    @if (b.Floor.HasValue)
                    {
                        <span><i class="fas fa-layer-group mr-1"></i>Floor @b.Floor</span>
                    }
                    <span><i class="fas fa-door-open mr-1"></i>@b.RoomType</span>
                </div>
                <div style="display:flex;gap:6px;margin-top:12px">
                    <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:8px;font-size:.72rem;font-weight:600;background:#d1fae5;color:#065f46">
                        <i class="fas fa-circle" style="font-size:.4rem"></i> @b.Status
                    </span>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary" style="border-radius:9px;font-weight:600">
        <i class="fas fa-arrow-left mr-1"></i> Back to Wards
    </a>
</div>
