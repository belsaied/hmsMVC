@using HMS.BLL.Shared.Dtos.WardBedModule.WardDtos
@model IEnumerable<WardOccupancySummaryDto>

@{
    ViewData["Title"] = "Ward Management";
    int totalBeds = Model.Sum(w => w.TotalBeds);
    int totalOccup = Model.Sum(w => w.OccupiedBeds);
    int totalAvail = Model.Sum(w => w.AvailableBeds);
    int totalMaint = Model.Sum(w => w.MaintenanceBeds);
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-muted: #64748b;
        }

        .ward-header {
            background: linear-gradient(135deg,var(--hms-blue),var(--hms-blue-mid));
            color: white;
            padding: 28px 32px;
            border-radius: 16px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 8px 32px rgba(26,58,92,.18);
            position: relative;
            overflow: hidden;
        }

            .ward-header::before {
                content: '';
                position: absolute;
                top: -40px;
                right: -40px;
                width: 160px;
                height: 160px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--hms-border);
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,.05);
        }

        .stat-card-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin-bottom: 12px;
        }

        .stat-card-val {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--hms-text);
        }

        .stat-card-lbl {
            font-size: .78rem;
            color: var(--hms-muted);
            margin-top: 2px;
        }

        .ward-card {
            background: white;
            border: 1px solid var(--hms-border);
            border-radius: 14px;
            margin-bottom: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,.05);
            transition: box-shadow .15s;
        }

            .ward-card:hover {
                box-shadow: 0 6px 20px rgba(0,0,0,.1);
            }

        .ward-card-header {
            padding: 18px 22px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .ward-type-badge {
            padding: 3px 12px;
            border-radius: 10px;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .ward-card-body {
            padding: 0 22px 18px;
        }

        .occ-bar-track {
            height: 8px;
            background: #f1f5f9;
            border-radius: 4px;
            overflow: hidden;
        }

        .occ-bar-fill {
            height: 100%;
            border-radius: 4px;
            transition: width .4s;
        }

        .bed-pills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .bed-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 10px;
            font-size: .75rem;
            font-weight: 600;
        }

        .pill-occupied {
            background: #fee2e2;
            color: #991b1b;
        }

        .pill-available {
            background: #d1fae5;
            color: #065f46;
        }

        .pill-maintenance {
            background: #fef3c7;
            color: #92400e;
        }

        .pill-reserved {
            background: #dbeafe;
            color: #1e40af;
        }

        .ward-actions {
            display: flex;
            gap: 8px;
            margin-top: 14px;
        }

        .btn-ward-action {
            padding: 7px 16px;
            border-radius: 9px;
            font-size: .8rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all .15s;
            border: none;
            cursor: pointer;
        }

        .btn-view-ward {
            background: #dbeafe;
            color: #1e40af;
        }

            .btn-view-ward:hover {
                background: #2563a8;
                color: white;
            }

        .btn-edit-ward {
            background: #fef9c3;
            color: #854d0e;
        }

            .btn-edit-ward:hover {
                background: #d97706;
                color: white;
            }

        .btn-new-ward {
            background: linear-gradient(135deg,var(--hms-accent),var(--hms-blue-mid));
            color: white;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-weight: 600;
            font-size: .875rem;
            box-shadow: 0 4px 12px rgba(14,165,233,.3);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

            .btn-new-ward:hover {
                transform: translateY(-1px);
                color: white;
            }

        .inactive-badge {
            background: #f1f5f9;
            color: #64748b;
            font-size: .7rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 6px;
        }

        @@media(max-width:768px) {
            .stat-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Ward &amp; Bed Management</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Wards</li>
            </ol>
        </div>
    </div>
}

<div class="ward-header">
    <div style="position:relative;z-index:1">
        <h2 class="ward-header-title" style="font-size:1.75rem;font-weight:700;margin:0">
            <i class="fas fa-hospital mr-2"></i> Ward Management
        </h2>
        <p style="font-size:.875rem;opacity:.75;margin-top:4px">Monitor occupancy, manage rooms, beds and patient admissions</p>
    </div>
    <div style="position:relative;z-index:1;display:flex;gap:10px">
        <a asp-action="Admissions" class="btn-new-ward" style="background:linear-gradient(135deg,#059669,#10b981)">
            <i class="fas fa-procedures"></i> Active Admissions
        </a>
        <a asp-action="Create" class="btn-new-ward">
            <i class="fas fa-plus"></i> New Ward
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-icon" style="background:#dbeafe"><i class="fas fa-bed" style="color:#2563a8"></i></div>
        <div class="stat-card-val">@totalBeds</div>
        <div class="stat-card-lbl">Total Beds</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon" style="background:#fee2e2"><i class="fas fa-user-injured" style="color:#dc2626"></i></div>
        <div class="stat-card-val">@totalOccup</div>
        <div class="stat-card-lbl">Occupied</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon" style="background:#d1fae5"><i class="fas fa-check-circle" style="color:#10b981"></i></div>
        <div class="stat-card-val">@totalAvail</div>
        <div class="stat-card-lbl">Available</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon" style="background:#fef3c7"><i class="fas fa-tools" style="color:#d97706"></i></div>
        <div class="stat-card-val">@totalMaint</div>
        <div class="stat-card-lbl">Under Maintenance</div>
    </div>
</div>

@foreach (var ward in Model)
{
    double occPct = ward.TotalBeds > 0 ? Math.Round((double)ward.OccupiedBeds / ward.TotalBeds * 100, 1) : 0;
    var barColor = occPct >= 90 ? "#dc2626" : occPct >= 70 ? "#f59e0b" : "#10b981";
    var (typeBg, typeFg) = ward.WardType switch
    {
        "ICU" => ("#fee2e2", "#991b1b"),
        "Isolation" => ("#fef3c7", "#92400e"),
        "Maternity" => ("#fce7f3", "#831843"),
        "Surgical" => ("#ede9fe", "#5b21b6"),
        "Pediatrics" => ("#ecfdf5", "#065f46"),
        _ => ("#dbeafe", "#1e40af")
    };

    <div class="ward-card">
        <div class="ward-card-header">
            <div style="flex:1">
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                    <span style="font-size:1rem;font-weight:700">@ward.WardName</span>
                    <span class="ward-type-badge" style="background:@typeBg;color:@typeFg">@ward.WardType</span>
                    @if (!ward.IsActive)
                    {
                        <span class="inactive-badge">Inactive</span>
                    }
                </div>
                <div style="font-size:.8rem;color:var(--hms-muted);margin-top:4px">
                    @if (ward.Floor.HasValue)
                    {
                        <span><i class="fas fa-layer-group mr-1"></i>Floor @ward.Floor</span>
                    }
                    &nbsp;·&nbsp; @ward.TotalBeds beds total
                </div>
            </div>
            <div style="text-align:right">
                <div style="font-size:1.5rem;font-weight:800;color:@barColor">@occPct%</div>
                <div style="font-size:.72rem;color:var(--hms-muted)">Occupancy</div>
            </div>
        </div>
        <div class="ward-card-body">
            <div class="occ-bar-track">
                <div class="occ-bar-fill" style="width:@occPct%;background:@barColor"></div>
            </div>
            <div class="bed-pills">
                <span class="bed-pill pill-occupied"><i class="fas fa-circle" style="font-size:.5rem"></i> @ward.OccupiedBeds Occupied</span>
                <span class="bed-pill pill-available"><i class="fas fa-circle" style="font-size:.5rem"></i> @ward.AvailableBeds Available</span>
                @if (ward.MaintenanceBeds > 0)
                {
                    <span class="bed-pill pill-maintenance"><i class="fas fa-circle" style="font-size:.5rem"></i> @ward.MaintenanceBeds Maintenance</span>
                }
                @if (ward.ReservedBeds > 0)
                {
                    <span class="bed-pill pill-reserved"><i class="fas fa-circle" style="font-size:.5rem"></i> @ward.ReservedBeds Reserved</span>
                }
            </div>
            <div class="ward-actions">
                <a asp-action="Details" asp-route-id="@ward.WardId" class="btn-ward-action btn-view-ward">
                    <i class="fas fa-eye"></i> View Rooms &amp; Beds
                </a>
                <a asp-action="Edit" asp-route-id="@ward.WardId" class="btn-ward-action btn-edit-ward">
                    <i class="fas fa-edit"></i> Edit
                </a>
            </div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div style="text-align:center;padding:60px;color:var(--hms-muted)">
        <i class="fas fa-hospital" style="font-size:3.5rem;opacity:.2;display:block;margin-bottom:16px"></i>
        <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No wards configured</p>
        <a asp-action="Create" class="btn-new-ward mt-2 d-inline-flex"><i class="fas fa-plus mr-1"></i> Create First Ward</a>
    </div>
}

<div class="mt-3" style="display:flex;gap:12px">
    <a asp-action="AvailableBeds" class="btn btn-outline-success" style="border-radius:9px;font-weight:600">
        <i class="fas fa-bed mr-1"></i> Available Beds
    </a>
    <a asp-action="Admit" class="btn btn-outline-primary" style="border-radius:9px;font-weight:600">
        <i class="fas fa-procedures mr-1"></i> Admit Patient
    </a>
</div>
