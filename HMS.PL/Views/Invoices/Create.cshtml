@model HMS.PL.ViewModels.BillingModule.CreateInvoiceViewModel
@using HMS.DAL.Models.Enums.BillingEnums
@{ ViewData["Title"] = "New Invoice"; }

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">New Invoice</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item active">New</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root {
        --hms-blue:#1a3a5c; --hms-blue-mid:#2563a8; --hms-accent:#0ea5e9;
        --hms-border:#e2e8f0; --hms-text:#1e293b; --hms-muted:#64748b;
        --hms-green:#10b981; --hms-red:#ef4444; --hms-yellow:#f59e0b;
    }
    .form-card { background:#fff; border-radius:14px; box-shadow:0 2px 16px rgba(0,0,0,.07); border:1px solid var(--hms-border); overflow:hidden; margin-bottom:20px; }
    .form-card-header { padding:16px 22px; border-bottom:1px solid var(--hms-border); font-weight:700; font-size:.9rem; color:var(--hms-text); background:#f8fafc; display:flex; align-items:center; gap:10px; }
    .form-card-body { padding:22px; }
    .form-control { border-radius:10px; border:1.5px solid var(--hms-border); padding:10px 14px; font-size:.9rem; transition:border .2s,box-shadow .2s; }
    .form-control:focus { border-color:var(--hms-accent); box-shadow:0 0 0 3px rgba(14,165,233,.12); outline:none; }
    .form-label { font-size:.82rem; font-weight:600; color:var(--hms-text); margin-bottom:4px; display:block; }
    .btn-primary-custom { background:linear-gradient(135deg,#1e40af,#2563a8); border:none; border-radius:9px; padding:11px 28px; font-weight:700; font-size:.9rem; color:white; transition:opacity .2s; }
    .btn-primary-custom:hover { opacity:.9; color:white; }
    .auto-badge { background:#dbeafe; color:#1d4ed8; border-radius:6px; padding:2px 8px; font-size:.72rem; font-weight:700; }
    .manual-badge { background:#f0fdf4; color:#166534; border-radius:6px; padding:2px 8px; font-size:.72rem; font-weight:700; }
    .row-auto { background:#fafbff; }
    .row-auto input.form-control, .row-auto select.form-control { background:#f1f5f9 !important; }
    #subtotalPreview { font-size:1.05rem; font-weight:700; color:var(--hms-blue); }
</style>
}

<form asp-action="Create" method="post" id="createForm">
    @Html.AntiForgeryToken()

    <div class="form-card">
        <div class="form-card-header">
            <i class="fas fa-user-injured" style="color:var(--hms-blue-mid)"></i> Patient & Invoice Details
        </div>
        <div class="form-card-body">
            <div class="row">
                <div class="col-md-4 form-group">
                    <label asp-for="PatientId" class="form-label"></label>
                    <input asp-for="PatientId" class="form-control" placeholder="e.g. 42" />
                    <span asp-validation-for="PatientId" class="text-danger small"></span>
                </div>
                <div class="col-md-4 form-group">
                    <label asp-for="AppointmentId" class="form-label"></label>
                    <input asp-for="AppointmentId" class="form-control" placeholder="(optional)" />
                </div>
                <div class="col-md-4 form-group">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                </div>
                <div class="col-12 form-group">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes…"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-header d-flex align-items-center justify-content-between">
            <div>
                <i class="fas fa-list" style="color:var(--hms-blue-mid)"></i> Line Items
                <small class="text-muted ml-2">— system items are read-only; add extras below</small>
            </div>
            <div class="d-flex align-items-center" style="gap:10px">
                <span>Sub-Total: <span id="subtotalPreview">$0.00</span></span>
                <button type="button" id="addRow" class="btn btn-sm btn-outline-success" style="border-radius:8px;font-weight:600">
                    <i class="fas fa-plus mr-1"></i> Add Manual Row
                </button>
            </div>
        </div>
        <div class="form-card-body p-0">
            <table class="table table-sm mb-0" id="lineItemTable">
                <thead class="thead-light">
                    <tr>
                        <th>Description</th>
                        <th style="width:140px">Type</th>
                        <th style="width:70px" class="text-center">Qty</th>
                        <th style="width:130px" class="text-right">Unit Price</th>
                        <th style="width:120px" class="text-right">Total</th>
                        <th style="width:90px" class="text-center">Source</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody id="lineItemBody">
                    @for (int i = 0; i < Model.LineItems.Count; i++)
                    {
                        var li = Model.LineItems[i];
                        <tr class="@(li.IsAutoAdded ? "row-auto" : "")">
                            <td>
                                <input name="LineItems[@i].Description" value="@li.Description"
                                       class="form-control form-control-sm" required maxlength="300"
                                       @(li.IsAutoAdded ? "readonly" : "") />
                                <input type="hidden" name="LineItems[@i].IsAutoAdded" value="@li.IsAutoAdded.ToString().ToLower()" />
                                <input type="hidden" name="LineItems[@i].ReferenceId" value="@li.ReferenceId" />
                            </td>
                            <td>
                                <select name="LineItems[@i].LineItemType" class="form-control form-control-sm"
                                        @(li.IsAutoAdded ? "disabled" : "")>
                                    @foreach (var t in Enum.GetValues<LineItemType>())
                                    {
                                        <option value="@((int)t)" selected="@(t == li.LineItemType)">@t</option>
                                    }
                                </select>
                                @if (li.IsAutoAdded)
                                {
                                    <input type="hidden" name="LineItems[@i].LineItemType" value="@((int)li.LineItemType)" />
                                }
                            </td>
                            <td class="text-center">
                                <input name="LineItems[@i].Quantity" type="number" min="1" value="@li.Quantity"
                                       class="form-control form-control-sm qty-input text-center"
                                       @(li.IsAutoAdded ? "readonly" : "") />
                            </td>
                            <td class="text-right">
                                <input name="LineItems[@i].UnitPrice" type="number" step="0.01" min="0"
                                       value="@li.UnitPrice" class="form-control form-control-sm price-input text-right"
                                       @(li.IsAutoAdded ? "readonly" : "") required />
                            </td>
                            <td class="text-right align-middle">
                                <strong class="row-total">@((li.Quantity * li.UnitPrice).ToString("C"))</strong>
                            </td>
                            <td class="text-center align-middle">
                                @if (li.IsAutoAdded)
                                {
                                    <span class="auto-badge">AUTO</span>
                                }
                                else
                                {
                                    <span class="manual-badge">MANUAL</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                @if (!li.IsAutoAdded)
                                {
                                    <button type="button" class="btn btn-xs btn-outline-danger removeRow">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex" style="gap:10px">
        <button type="submit" class="btn-primary-custom">
            <i class="fas fa-save mr-1"></i> Create Invoice
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius:9px;font-weight:600">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
    const types = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Enum.GetValues<LineItemType>()
                .Select(v => new { value = (int)v, text = v.ToString() })
        )
    );
    let rowIndex = @Model.LineItems.Count;

    function typeOptions() {
        return types.map(t => `<option value="${t.value}">${t.text}</option>`).join('');
    }

    function addRow() {
        const i = rowIndex++;
        const row = `<tr>
            <td>
                <input name="LineItems[${i}].Description" class="form-control form-control-sm" required maxlength="300" placeholder="e.g. X-Ray Chest" />
                <input type="hidden" name="LineItems[${i}].IsAutoAdded" value="false" />
                <input type="hidden" name="LineItems[${i}].ReferenceId" value="" />
            </td>
            <td><select name="LineItems[${i}].LineItemType" class="form-control form-control-sm">${typeOptions()}</select></td>
            <td class="text-center"><input name="LineItems[${i}].Quantity" type="number" min="1" value="1" class="form-control form-control-sm qty-input text-center" /></td>
            <td class="text-right"><input name="LineItems[${i}].UnitPrice" type="number" step="0.01" min="0.01" value="0" class="form-control form-control-sm price-input text-right" required /></td>
            <td class="text-right align-middle"><strong class="row-total">$0.00</strong></td>
            <td class="text-center align-middle"><span class="manual-badge">MANUAL</span></td>
            <td class="text-center align-middle"><button type="button" class="btn btn-xs btn-outline-danger removeRow"><i class="fas fa-trash"></i></button></td>
        </tr>`;
        document.getElementById('lineItemBody').insertAdjacentHTML('beforeend', row);
        recalc();
    }

    function recalc() {
        let sub = 0;
        document.querySelectorAll('#lineItemBody tr').forEach(tr => {
            const qty   = parseFloat(tr.querySelector('.qty-input')?.value)   || 0;
            const price = parseFloat(tr.querySelector('.price-input')?.value) || 0;
            const total = qty * price;
            sub += total;
            const totalEl = tr.querySelector('.row-total');
            if (totalEl) totalEl.textContent = '$' + total.toFixed(2);
        });
        document.getElementById('subtotalPreview').textContent = '$' + sub.toFixed(2);
    }

    document.getElementById('addRow').addEventListener('click', addRow);
    document.getElementById('lineItemBody').addEventListener('click', e => {
        if (e.target.closest('.removeRow')) { e.target.closest('tr').remove(); recalc(); }
    });
    document.getElementById('lineItemBody').addEventListener('input', recalc);
    recalc();
</script>
<partial name="_ValidationScriptsPartial" />
}
