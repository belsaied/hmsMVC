@model HMS.PL.ViewModels.BillingModule.IssueInvoiceViewModel
@{ ViewData["Title"] = "Issue Invoice"; }

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Issue Invoice</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.InvoiceId">@Model.InvoiceNumber</a></li>
                <li class="breadcrumb-item active">Issue</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root { --hms-blue: #1a3a5c; --hms-blue-mid: #2563a8; --hms-border: #e2e8f0; --hms-text: #1e293b; --hms-muted: #64748b; }
    .form-card { background:#fff; border-radius:14px; box-shadow:0 2px 12px rgba(0,0,0,.06); border:1px solid var(--hms-border); overflow:hidden; }
    .form-card-header { padding:16px 22px; border-bottom:1px solid var(--hms-border); font-weight:700; font-size:.9rem; background:#f8fafc; }
    .form-card-body { padding:22px; }
    .form-control { border-radius:10px; border:1.5px solid var(--hms-border); padding:10px 14px; font-size:.9rem; }
    .form-control:focus { border-color:var(--hms-blue-mid); box-shadow:0 0 0 3px rgba(37,99,168,.12); }
    .form-label { font-size:.82rem; font-weight:600; color:var(--hms-text); margin-bottom:4px; }
    .input-group-text { border-radius:10px 0 0 10px; border-color:var(--hms-border); }
    .input-group-append .input-group-text { border-radius:0 10px 10px 0; }
</style>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="form-card">
            <div class="form-card-header">
                <i class="fas fa-paper-plane mr-2 text-success"></i> Issue @Model.InvoiceNumber
            </div>
            <div class="form-card-body">
                <p class="text-muted mb-4">
                    Sub-total: <strong>@Model.CurrentSubTotal.ToString("C")</strong>.
                    Apply optional discounts and tax, then issue to the patient.
                </p>

                <form asp-action="Issue" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="InvoiceId" />
                    <input type="hidden" asp-for="InvoiceNumber" />
                    <input type="hidden" asp-for="CurrentSubTotal" />

                    <div class="form-group">
                        <label asp-for="DiscountAmount" class="form-label"></label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                            <input asp-for="DiscountAmount" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                        <span asp-validation-for="DiscountAmount" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DiscountPercent" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="DiscountPercent" type="number" step="0.01" min="0" max="100" class="form-control" />
                            <div class="input-group-append"><span class="input-group-text">%</span></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="TaxPercent" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="TaxPercent" type="number" step="0.01" min="0" max="100" class="form-control" />
                            <div class="input-group-append"><span class="input-group-text">%</span></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex gap-2" style="gap:8px">
                        <button type="submit" class="btn btn-success" style="border-radius:9px;font-weight:700;padding:10px 24px">
                            <i class="fas fa-paper-plane mr-1"></i> Issue & Send to Patient
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.InvoiceId"
                           class="btn btn-outline-secondary" style="border-radius:9px;font-weight:600">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
