@model HMS.PL.ViewModels.BillingModule.CancelInvoiceViewModel
@{ ViewData["Title"] = "Cancel Invoice"; }

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Cancel Invoice</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.InvoiceId">@Model.InvoiceNumber</a></li>
                <li class="breadcrumb-item active">Cancel</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root { --hms-blue: #1a3a5c; --hms-border: #e2e8f0; --hms-text: #1e293b; --hms-muted: #64748b; --hms-red: #ef4444; }
    .form-card { background:#fff; border-radius:14px; box-shadow:0 2px 12px rgba(0,0,0,.06); border:1px solid var(--hms-border); overflow:hidden; }
    .form-card-header { padding:16px 22px; border-bottom:1px solid var(--hms-border); font-weight:700; font-size:.9rem; background:var(--hms-red); color:#fff; }
    .form-card-body { padding:22px; }
    .form-control { border-radius:10px; border:1.5px solid var(--hms-border); padding:10px 14px; font-size:.9rem; }
    .form-label { font-size:.82rem; font-weight:600; color:var(--hms-text); margin-bottom:4px; }
</style>
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="form-card">
            <div class="form-card-header">
                <i class="fas fa-ban mr-2"></i> Cancel @Model.InvoiceNumber
            </div>
            <div class="form-card-body">
                <p class="text-muted">Please provide a reason for cancellation. This action cannot be undone.</p>
                <form asp-action="Cancel" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="InvoiceId" />
                    <input type="hidden" asp-for="InvoiceNumber" />
                    <div class="form-group">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" required></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2" style="gap:8px">
                        <button type="submit" class="btn btn-danger" style="border-radius:9px;font-weight:700;padding:10px 20px">
                            <i class="fas fa-ban mr-1"></i> Confirm Cancellation
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.InvoiceId"
                           class="btn btn-outline-secondary" style="border-radius:9px;font-weight:600">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
