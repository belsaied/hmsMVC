@model HMS.PL.ViewModels.BillingModule.InvoiceIndexViewModel
@using HMS.DAL.Models.Enums.BillingEnums

@{
    ViewData["Title"] = "Invoices";
    int totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize) : 0;
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Invoices</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Invoices</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root {
        --hms-blue: #1a3a5c;
        --hms-blue-mid: #2563a8;
        --hms-accent: #0ea5e9;
        --hms-border: #e2e8f0;
        --hms-text: #1e293b;
        --hms-muted: #64748b;
        --hms-green: #10b981;
        --hms-red: #ef4444;
    }

    .page-header-card {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        color: white; padding: 28px 32px; border-radius: 16px; margin-bottom: 24px;
        display: flex; align-items: center; justify-content: space-between;
        box-shadow: 0 8px 32px rgba(59,130,246,0.18); position: relative; overflow: hidden;
    }
    .page-header-card::before { content: ''; position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; background: rgba(255,255,255,0.07); border-radius: 50%; }
    .page-header-card::after { content: ''; position: absolute; bottom: -60px; right: 80px; width: 220px; height: 220px; background: rgba(255,255,255,0.04); border-radius: 50%; }
    .header-title { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.5px; margin: 0; position: relative; z-index: 1; }
    .header-subtitle { font-size: 0.875rem; opacity: 0.75; margin-top: 4px; position: relative; z-index: 1; }

    .search-card {
        background: #fff; border-radius: 14px; padding: 24px;
        margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        border: 1px solid var(--hms-border);
    }
    .search-title {
        font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
        color: var(--hms-muted); margin-bottom: 16px;
    }
    .filter-row { display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap; }
    .filter-group { flex: 1; min-width: 180px; }
    .filter-label {
        font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
        color: var(--hms-muted); margin-bottom: 4px;
    }

    .badge-status { border-radius: 20px; padding: 4px 12px; font-size: .75rem; font-weight: 700; }
    .badge-status.Draft { background:#f1f5f9; color:#475569; }
    .badge-status.Issued { background:#dbeafe; color:#1d4ed8; }
    .badge-status.PartiallyPaid { background:#fef3c7; color:#92400e; }
    .badge-status.Paid { background:#dcfce7; color:#166534; }
    .badge-status.Overdue { background:#fee2e2; color:#991b1b; }
    .badge-status.Cancelled { background:#f3f4f6; color:#9ca3af; }

    .table-card {
        background: #fff; border-radius: 14px; overflow: hidden;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07); border: 1px solid var(--hms-border);
    }
    .table-card .table { margin: 0; }
    .table-card thead th {
        background: #1e40af; color: white; font-weight: 600;
        font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
        padding: 14px 16px; border: none;
    }
    .table-card tbody tr { transition: background 0.15s; border-bottom: 1px solid var(--hms-border); }
    .table-card tbody tr:hover { background: #f8faff; }
    .table-card tbody td { padding: 13px 16px; vertical-align: middle; color: var(--hms-text); font-size: 0.9rem; border: none; }

    .btn-action { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.82rem; transition: all 0.15s; border: none; cursor: pointer; }
    .btn-view { background: #e0f2fe; color: #0369a1; }
    .btn-view:hover { background: #0369a1; color: white; }

    .pagination-footer { background: #f8faff; padding: 14px 20px; border-top: 1px solid var(--hms-border); }
    .pagination { margin: 0; }
    .pagination .page-link { border-radius: 8px !important; margin: 0 2px; border: 1px solid var(--hms-border); color: #1e40af; font-weight: 500; font-size: 0.875rem; min-width: 36px; text-align: center; padding: 6px 10px; }
    .pagination .page-item.active .page-link { background: #1e40af; border-color: #1e40af; color: white; }

    .empty-state { text-align: center; padding: 60px 20px; color: var(--hms-muted); }
    .empty-state i { font-size: 3.5rem; opacity: 0.2; margin-bottom: 16px; display: block; }

    .btn-primary-custom { background: #1e40af; border: none; border-radius: 9px; padding: 9px 20px; font-weight: 600; font-size: .85rem; color: white; }
    .btn-primary-custom:hover { background: #1e3a8a; color: white; }
</style>
}

<div class="page-header-card">
    <div style="position:relative;z-index:1">
        <h2 class="header-title"><i class="fas fa-file-invoice-dollar mr-2"></i> Invoices</h2>
        <p class="header-subtitle">Manage patient invoices, payments, and insurance claims</p>
    </div>
    <a asp-action="Create" class="btn btn-light btn-sm" style="position:relative;z-index:1;border-radius:9px;font-weight:600">
        <i class="fas fa-plus mr-1"></i> New Invoice
    </a>
</div>

<div class="search-card">
    <div class="search-title"><i class="fas fa-search mr-1"></i> Filter Invoices</div>
    <form method="get" class="filter-row">
        <div class="filter-group">
            <div class="filter-label">Status</div>
            <select name="status" class="form-control form-control-sm" style="border-radius:10px;border:1.5px solid var(--hms-border)">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetNames(typeof(InvoiceStatus)))
                {
                    <option value="@s" selected="@(Model.StatusFilter?.ToString() == s)">@s</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <div class="filter-label">Patient ID</div>
            <input type="number" name="patientId" value="@Model.PatientIdFilter"
                   class="form-control form-control-sm" placeholder="Enter patient ID..."
                   style="border-radius:10px;border:1.5px solid var(--hms-border)" />
        </div>
        <div class="filter-group" style="flex:0 0 auto">
            <button type="submit" class="btn btn-primary-custom btn-sm">
                <i class="fas fa-filter mr-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm" style="border-radius:9px;border:1.5px solid var(--hms-border);color:var(--hms-muted);font-weight:500">
                Clear
            </a>
        </div>
    </form>
</div>

<div class="table-card">
    @if (!Model.Invoices.Any())
    {
        <div class="empty-state">
            <i class="fas fa-file-invoice"></i>
            <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No invoices found</p>
            <p>Create a new invoice to get started.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Patient</th>
                        <th>Status</th>
                        <th class="text-right">Total</th>
                        <th class="text-right">Outstanding</th>
                        <th>Due Date</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td><strong>@inv.InvoiceNumber</strong></td>
                            <td>@inv.PatientName</td>
                            <td><span class="badge-status @inv.Status">@inv.Status</span></td>
                            <td class="text-right">@inv.TotalAmount.ToString("C")</td>
                            <td class="text-right @(inv.OutstandingBalance > 0 ? "text-danger font-weight-bold" : "text-success")">
                                @inv.OutstandingBalance.ToString("C")
                            </td>
                            <td>@(inv.DueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>@inv.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-right">
                                <a asp-action="Details" asp-route-id="@inv.Id" class="btn-action btn-view" title="View Invoice">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        if (totalPages > 1)
        {
            <div class="pagination-footer d-flex justify-content-center">
                <nav>
                    <ul class="pagination pagination-sm">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageIndex="@i"
                                   asp-route-status="@Model.StatusFilter"
                                   asp-route-patientId="@Model.PatientIdFilter">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>
