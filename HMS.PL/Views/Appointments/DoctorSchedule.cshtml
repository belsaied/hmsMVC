@using HMS.BLL.Shared.Dtos.AppointmentModule
@model IEnumerable<AppointmentResultDto>

@{
    ViewData["Title"] = "Doctor Schedule — " + ViewBag.DoctorName;
    var list = Model?.ToList() ?? [];
    var scheduled = list.Where(a => a.Status is "Scheduled" or "Confirmed").OrderBy(a => a.StartTime).ToList();
    var completed = list.Where(a => a.Status == "Completed").OrderByDescending(a => a.StartTime).ToList();
    var cancelled = list.Where(a => a.Status is "Cancelled" or "NoShow").OrderByDescending(a => a.StartTime).ToList();
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-purple: #8b5cf6;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-muted: #64748b;
        }

        .schedule-header {
            background: linear-gradient(135deg, var(--hms-blue), var(--hms-blue-mid));
            color: white;
            padding: 24px 32px;
            border-radius: 16px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }

        .schedule-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            border: 1px solid var(--hms-border);
            margin-bottom: 16px;
            overflow: hidden;
        }

        .schedule-card-header {
            padding: 14px 20px;
            border-bottom: 1px solid var(--hms-border);
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .appt-row {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 20px;
            border-bottom: 1px solid #f1f5f9;
            transition: background .15s;
        }

            .appt-row:last-child {
                border-bottom: none;
            }

            .appt-row:hover {
                background: #f8faff;
            }

        .time-block {
            min-width: 100px;
            text-align: center;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: .82rem;
            font-weight: 600;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: .72rem;
            font-weight: 600;
        }

        .status-Scheduled {
            background: #dbeafe;
            color: #1e40af;
        }

        .status-Confirmed {
            background: #d1fae5;
            color: #065f46;
        }

        .status-Completed {
            background: #ede9fe;
            color: #3730a3;
        }

        .status-Cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-NoShow {
            background: #fef9c3;
            color: #854d0e;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--hms-muted);
        }

        .date-nav {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .date-nav input {
                border-radius: 8px;
            }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Doctor Schedule</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                <li class="breadcrumb-item active">Doctor Schedule</li>
            </ol>
        </div>
    </div>
}

<div class="schedule-header">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
        <div>
            <h2 style="font-size:1.5rem;font-weight:700;margin:0">
                <i class="fas fa-user-md mr-2"></i> @ViewBag.DoctorName
            </h2>
            <p style="font-size:.875rem;opacity:.75;margin-top:4px">
                <i class="fas fa-calendar-alt mr-1"></i> @ViewBag.Date · @list.Count appointment(s)
            </p>
        </div>
        <form method="get" class="date-nav">
            <input type="hidden" name="doctorId" value="@ViewBag.DoctorId" />
            <input type="date" name="date" value="@ViewBag.Date" class="form-control form-control-sm" style="max-width:180px" />
            <button type="submit" class="btn btn-light btn-sm" style="border-radius:8px;font-weight:600">
                <i class="fas fa-search mr-1"></i> View
            </button>
        </form>
    </div>
</div>

<!-- Upcoming -->
<div class="schedule-card">
    <div class="schedule-card-header">
        <i class="fas fa-clock" style="color:var(--hms-accent)"></i> Upcoming
        <span class="badge badge-primary ml-auto">@scheduled.Count</span>
    </div>
    @if (scheduled.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-calendar-check"></i>
            <p style="font-size:.9rem;color:var(--hms-text)">No upcoming appointments</p>
        </div>
    }
    else
    {
        foreach (var a in scheduled)
        {
            <div class="appt-row">
                <div class="time-block" style="background:#f0f9ff;color:#0369a1">
                    @a.StartTime.ToString("hh:mm tt") – @a.EndTime.ToString("hh:mm tt")
                </div>
                <div style="flex:1;min-width:0">
                    <div style="font-weight:600;font-size:.9rem">@a.PatientName</div>
                    <div style="font-size:.78rem;color:var(--hms-muted)">@a.ReasonForVisit</div>
                </div>
                <span class="status-badge status-@a.Status">@a.Status</span>
                <span style="font-family:monospace;font-size:.72rem;color:var(--hms-muted)">@a.ConfirmationNumber</span>
                <a asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id"
                   class="btn btn-sm btn-outline-primary" style="border-radius:7px;font-size:.75rem;padding:3px 10px">
                    <i class="fas fa-eye"></i>
                </a>
            </div>
        }
    }
</div>

<!-- Completed -->
<div class="schedule-card">
    <div class="schedule-card-header">
        <i class="fas fa-check-circle" style="color:var(--hms-green)"></i> Completed
        <span class="badge badge-success ml-auto">@completed.Count</span>
    </div>
    @if (completed.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-check-double"></i>
            <p style="font-size:.9rem;color:var(--hms-text)">No completed appointments</p>
        </div>
    }
    else
    {
        foreach (var a in completed)
        {
            <div class="appt-row">
                <div class="time-block" style="background:#f0fdf4;color:#166534">
                    @a.StartTime.ToString("hh:mm tt") – @a.EndTime.ToString("hh:mm tt")
                </div>
                <div style="flex:1;min-width:0">
                    <div style="font-weight:600;font-size:.9rem">@a.PatientName</div>
                    <div style="font-size:.78rem;color:var(--hms-muted)">@a.ReasonForVisit</div>
                </div>
                <span class="status-badge status-Completed">Completed</span>
                <span style="font-family:monospace;font-size:.72rem;color:var(--hms-muted)">@a.ConfirmationNumber</span>
                <a asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id"
                   class="btn btn-sm btn-outline-primary" style="border-radius:7px;font-size:.75rem;padding:3px 10px">
                    <i class="fas fa-eye"></i>
                </a>
            </div>
        }
    }
</div>

<!-- Cancelled / No Show -->
@if (cancelled.Count > 0)
{
    <div class="schedule-card">
        <div class="schedule-card-header">
            <i class="fas fa-times-circle" style="color:var(--hms-red)"></i> Cancelled / No Show
            <span class="badge badge-danger ml-auto">@cancelled.Count</span>
        </div>
        @foreach (var a in cancelled)
        {
            <div class="appt-row">
                <div class="time-block" style="background:#fef2f2;color:#991b1b">
                    @a.StartTime.ToString("hh:mm tt") – @a.EndTime.ToString("hh:mm tt")
                </div>
                <div style="flex:1;min-width:0">
                    <div style="font-weight:600;font-size:.9rem">@a.PatientName</div>
                    <div style="font-size:.78rem;color:var(--hms-muted)">@a.ReasonForVisit</div>
                </div>
                <span class="status-badge status-@a.Status">@a.Status</span>
                <span style="font-family:monospace;font-size:.72rem;color:var(--hms-muted)">@a.ConfirmationNumber</span>
                <a asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id"
                   class="btn btn-sm btn-outline-primary" style="border-radius:7px;font-size:.75rem;padding:3px 10px">
                    <i class="fas fa-eye"></i>
                </a>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-controller="Appointments" asp-action="Index" class="btn btn-secondary" style="border-radius:9px;font-weight:600">
        <i class="fas fa-arrow-left mr-1"></i> Back to Appointments
    </a>
</div>
