@using HMS.BLL.Shared.Dtos.AppointmentModule
@model AppointmentResultDto

@{
    ViewData["Title"] = "Appointment — " + Model.ConfirmationNumber;
    var statusColor = Model.Status switch
    {
        "Scheduled" => "#2563a8",
        "Confirmed" => "#10b981",
        "Completed" => "#7c3aed",
        "Cancelled" => "#dc2626",
        "NoShow" => "#d97706",
        _ => "#64748b"
    };
    var statusBg = Model.Status switch
    {
        "Scheduled" => "#dbeafe",
        "Confirmed" => "#d1fae5",
        "Completed" => "#ede9fe",
        "Cancelled" => "#fee2e2",
        "NoShow" => "#fef3c7",
        _ => "#f1f5f9"
    };
    bool canConfirm = Model.Status == "Scheduled";
    bool canComplete = Model.Status == "Confirmed";
    bool canCancel = Model.Status is "Scheduled" or "Confirmed";
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-muted: #64748b;
        }

        .appt-card {
            background: white;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,.08);
            border: 1px solid var(--hms-border);
        }

        .appt-card-header {
            background: linear-gradient(135deg, var(--hms-blue) 0%, var(--hms-blue-mid) 100%);
            padding: 28px 32px;
            color: white;
        }

        .conf-code {
            font-family: monospace;
            font-size: 1.1rem;
            font-weight: 700;
            background: rgba(255,255,255,.15);
            border-radius: 8px;
            padding: 6px 14px;
            display: inline-block;
            margin-top: 8px;
            letter-spacing: .05em;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 16px;
            border-radius: 20px;
            font-size: .8rem;
            font-weight: 700;
        }

        .info-section-title {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--hms-muted);
            border-bottom: 1px solid var(--hms-border);
            padding-bottom: 8px;
            margin-bottom: 16px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .info-label {
            font-size: .75rem;
            color: var(--hms-muted);
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 3px;
        }

        .info-value {
            font-size: .92rem;
            font-weight: 500;
            color: var(--hms-text);
        }

        .side-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,.07);
            border: 1px solid var(--hms-border);
            margin-bottom: 16px;
        }

        .side-card-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--hms-border);
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--hms-muted);
        }

        .side-card-body {
            padding: 16px 18px;
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 16px;
            border-radius: 10px;
            font-size: .875rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all .15s;
            text-decoration: none;
            width: 100%;
            margin-bottom: 8px;
        }

            .action-btn:last-child {
                margin-bottom: 0;
            }

        .btn-confirm {
            background: #d1fae5;
            color: #065f46;
        }
            .btn-confirm:hover {
                background: #10b981;
                color: white;
            }

        .btn-complete {
            background: #ede9fe;
            color: #5b21b6;
        }
            .btn-complete:hover {
                background: #7c3aed;
                color: white;
            }

        .btn-cancel {
            background: #fee2e2;
            color: #991b1b;
        }
            .btn-cancel:hover {
                background: #dc2626;
                color: white;
            }

        .notes-box {
            background: #f8faff;
            border: 1px solid var(--hms-border);
            border-radius: 10px;
            padding: 14px 16px;
            font-size: .875rem;
            color: var(--hms-text);
            line-height: 1.6;
        }

        .cancel-reason-box {
            background: #fff5f5;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 14px 16px;
            font-size: .875rem;
            color: #991b1b;
            line-height: 1.6;
        }

        .person-badge {
            display: flex; align-items: center; gap: 14px;
        }
        .person-avatar {
            width: 44px; height: 44px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem; flex-shrink: 0;
        }
        .person-name {
            font-weight: 600; font-size: .95rem; color: var(--hms-text); line-height: 1.3;
        }
        .person-meta {
            font-size: .78rem; color: var(--hms-muted);
        }
        .person-link {
            font-size: .75rem; color: var(--hms-blue-mid); font-weight: 600; text-decoration: none;
        }
            .person-link:hover { text-decoration: underline; }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Appointment Details</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Appointments</a></li>
                <li class="breadcrumb-item active">@Model.ConfirmationNumber</li>
            </ol>
        </div>
    </div>
}

<div class="row">
    <!-- Left: Main Card -->
    <div class="col-md-8">
        <div class="appt-card mb-4">
            <div class="appt-card-header">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px">
                    <div>
                        <div style="font-size:.82rem;opacity:.7;text-transform:uppercase;letter-spacing:.08em">Appointment</div>
                        <div class="conf-code"><i class="fas fa-hashtag mr-1" style="font-size:.85rem"></i>@Model.ConfirmationNumber</div>
                    </div>
                    <span class="status-pill" style="background:@statusBg;color:@statusColor">
                        <i class="fas fa-circle" style="font-size:.5rem"></i> @Model.Status
                    </span>
                </div>
            </div>

            <div class="p-4">
                <!-- Parties -->
                <div class="info-section-title"><i class="fas fa-user-friends mr-1"></i> Participants</div>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="person-badge">
                            <div class="person-avatar" style="background:#dbeafe">
                                <i class="fas fa-user" style="color:#2563a8"></i>
                            </div>
                            <div>
                                <div class="person-name">@Model.PatientName</div>
                                <div class="person-meta">ID: @Model.PatientId</div>
                                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="person-link">
                                    <i class="fas fa-external-link-alt mr-1"></i> View Patient
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="person-badge">
                            <div class="person-avatar" style="background:#ede9fe">
                                <i class="fas fa-user-md" style="color:#7c3aed"></i>
                            </div>
                            <div>
                                <div class="person-name">Dr. @Model.DoctorName</div>
                                <div class="person-meta">@Model.DoctorSpecialization</div>
                                <a asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId" class="person-link">
                                    <i class="fas fa-external-link-alt mr-1"></i> View Doctor
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Schedule -->
                <div class="info-section-title"><i class="fas fa-calendar-alt mr-1"></i> Schedule</div>
                <div class="info-grid mb-4">
                    <div class="info-item">
                        <div class="info-label">Date</div>
                        <div class="info-value">@Model.AppointmentDate.ToString("dddd, dd MMMM yyyy")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Time</div>
                        <div class="info-value">@Model.StartTime.ToString("hh:mm tt") &ndash; @Model.EndTime.ToString("hh:mm tt")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Type</div>
                        <div class="info-value">@Model.Type</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Booked At</div>
                        <div class="info-value">@Model.BookedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>

                <!-- Reason -->
                <div class="info-section-title"><i class="fas fa-stethoscope mr-1"></i> Reason for Visit</div>
                <div class="notes-box mb-4">@Model.ReasonForVisit</div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="info-section-title"><i class="fas fa-clipboard mr-1"></i> Notes</div>
                    <div class="notes-box mb-4">@Model.Notes</div>
                }

                @if (!string.IsNullOrEmpty(Model.CancellationReason))
                {
                    <div class="info-section-title"><i class="fas fa-ban mr-1" style="color:#dc2626"></i> Cancellation Reason</div>
                    <div class="cancel-reason-box">@Model.CancellationReason</div>
                }
        </div>
    </div>
</div>

<!-- Change Status Modal -->
<div class="modal fade" id="changeStatusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none">
            <div class="modal-header" style="background:linear-gradient(135deg,#1a3a5c,#2563a8);color:white;border-radius:16px 16px 0 0;border:none">
                <h5 class="modal-title"><i class="fas fa-sync-alt mr-2"></i> Change Appointment Status</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal"><span>&times;</span></button>
            </div>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-group mb-3">
                        <label class="form-label" style="font-size:.82rem;font-weight:600">New Status <span style="color:#ef4444">*</span></label>
                        <select name="NewStatus" id="newStatusSelect" class="form-control" style="border-radius:10px">
                            <option value="Scheduled">Scheduled</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Completed">Completed</option>
                            <option value="NoShow">No-Show</option>
                        </select>
                    </div>
                    <div class="form-group mb-3" id="cancelReasonGroup" style="display:none">
                        <label class="form-label" style="font-size:.82rem;font-weight:600">Cancellation Reason <span style="color:#ef4444">*</span></label>
                        <textarea name="CancellationReason" class="form-control" rows="3" style="border-radius:10px"
                                  placeholder="Reason for cancellation..."></textarea>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label" style="font-size:.82rem;font-weight:600">Notes (optional)</label>
                        <textarea name="Notes" class="form-control" rows="3" style="border-radius:10px"
                                  placeholder="Any notes about this status change..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border:none;padding:16px 24px">
                    <button type="submit" class="btn btn-primary" style="border-radius:9px;font-weight:600;background:#2563a8;border:none">
                        <i class="fas fa-check mr-1"></i> Update Status
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius:9px">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

    <!-- Right: Actions & Timeline -->
    <div class="col-md-4">

        <!-- Actions -->
        @if (canConfirm || canComplete || canCancel)
        {
            <div class="side-card">
                <div class="side-card-header"><i class="fas fa-bolt mr-1"></i> Actions</div>
                <div class="side-card-body">
                    @if (canConfirm)
                    {
                        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="action-btn btn-confirm"
                                    onclick="return confirm('Confirm this appointment?')">
                                <i class="fas fa-check-circle"></i> Confirm Appointment
                            </button>
                        </form>
                    }
                    @if (canComplete)
                    {
                        <button type="button" class="action-btn btn-complete" onclick="openCompleteModal()">
                            <i class="fas fa-flag-checkered"></i> Mark as Completed
                        </button>
                    }
                    @if (canCancel)
                    {
                        <button type="button" class="action-btn btn-cancel" onclick="openCancelModal()">
                            <i class="fas fa-times-circle"></i> Cancel Appointment
                        </button>
                    }
                    @if (Model.Status == "Confirmed")
                    {
                        <form asp-action="NoShow" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="action-btn btn-cancel"
                                    onclick="return confirm('Mark this appointment as No-Show?')">
                                <i class="fas fa-user-times"></i> Mark No-Show
                            </button>
                        </form>
                    }
                </div>
            </div>
        }

        <!-- Change Status -->
        <div class="side-card">
            <div class="side-card-header"><i class="fas fa-edit mr-1"></i> Change Status</div>
            <div class="side-card-body">
                <button type="button" class="action-btn btn-confirm" onclick="openChangeStatusModal()">
                    <i class="fas fa-sync-alt"></i> Change Status
                </button>
            </div>
        </div>

        <!-- Timeline -->
        <div class="side-card">
            <div class="side-card-header"><i class="fas fa-history mr-1"></i> Timeline</div>
            <div class="side-card-body" style="padding:0">
                <div style="display:flex; gap:0">
                    <div style="position:relative; min-width:36px; display:flex; flex-direction:column; align-items:center; padding:18px 0">
                        <div style="width:10px; height:10px; border-radius:50%; background:#10b981; position:relative; z-index:1; box-shadow:0 0 0 3px #d1fae5"></div>
                        <div style="width:2px; flex:1; background:linear-gradient(to bottom, #10b981, #2563a8); margin:4px 0"></div>
                        <div style="width:10px; height:10px; border-radius:50%; background:#2563a8; position:relative; z-index:1; box-shadow:0 0 0 3px #dbeafe"></div>
                        <div style="width:2px; flex:1; background:linear-gradient(to bottom, #2563a8, #d97706); margin:4px 0"></div>
                        <div style="width:10px; height:10px; border-radius:50%; background:#d97706; position:relative; z-index:1; box-shadow:0 0 0 3px #fef3c7"></div>
                        <div style="flex:1; min-height:4px"></div>
                    </div>
                    <div style="flex:1; padding:18px 18px 18px 0">
                        <div style="margin-bottom:22px">
                            <div style="font-size:.82rem; font-weight:600; color:#166534; display:flex; align-items:center; gap:6px">
                                <i class="fas fa-calendar-check" style="font-size:.75rem"></i> Booked
                            </div>
                            <div style="font-size:.78rem; color:var(--hms-muted); margin-top:2px">@Model.BookedAt.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                        <div style="margin-bottom:22px">
                            <div style="font-size:.82rem; font-weight:600; color:var(--hms-blue-mid); display:flex; align-items:center; gap:6px">
                                <i class="fas fa-sync-alt" style="font-size:.75rem"></i> Last Updated
                            </div>
                            <div style="font-size:.78rem; color:var(--hms-muted); margin-top:2px">
                                @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") : "—")
                            </div>
                            <div style="font-size:.72rem; color:#94a3b8; margin-top:1px">Status: @Model.Status</div>
                        </div>
                        <div>
                            <div style="font-size:.82rem; font-weight:600; color:#92400e; display:flex; align-items:center; gap:6px">
                                <i class="fas fa-clock" style="font-size:.75rem"></i> Scheduled For
                            </div>
                            <div style="font-size:.78rem; color:var(--hms-muted); margin-top:2px">
                                @Model.AppointmentDate.ToString("dd MMM yyyy") · @Model.StartTime.ToString("hh:mm tt")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back -->
        <a asp-action="Index" class="btn btn-secondary btn-block" style="border-radius:10px;font-weight:600;background:#f1f5f9;border:1.5px solid var(--hms-border);color:var(--hms-text)">
            <i class="fas fa-arrow-left mr-1"></i> Back to Appointments
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function openCompleteModal() {
            var el = document.getElementById('completeModal');
            if (el) { new bootstrap.Modal(el).show(); }
        }
        function openCancelModal() {
            var el = document.getElementById('cancelModal');
            if (el) { new bootstrap.Modal(el).show(); }
        }
        function openChangeStatusModal() {
            var el = document.getElementById('changeStatusModal');
            if (el) { new bootstrap.Modal(el).show(); }
        }
        document.addEventListener('DOMContentLoaded', function () {
            var sel = document.getElementById('newStatusSelect');
            if (sel) {
                sel.addEventListener('change', function () {
                    var grp = document.getElementById('cancelReasonGroup');
                    if (grp) { grp.style.display = this.value === 'Cancelled' ? '' : 'none'; }
                });
            }
        });
    </script>
}

<!-- Complete Modal -->
<div class="modal fade" id="completeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none">
            <div class="modal-header" style="background:linear-gradient(135deg,#5b21b6,#7c3aed);color:white;border-radius:16px 16px 0 0;border:none">
                <h5 class="modal-title"><i class="fas fa-flag-checkered mr-2"></i> Complete Appointment</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal"><span>&times;</span></button>
            </div>
            <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-group mb-0">
                        <label class="form-label" style="font-size:.82rem;font-weight:600">Completion Notes (optional)</label>
                        <textarea name="notes" class="form-control" rows="4" style="border-radius:10px"
                                  placeholder="Any notes about the completed appointment..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border:none;padding:16px 24px">
                    <button type="submit" class="btn btn-primary" style="border-radius:9px;font-weight:600;background:#7c3aed;border:none">
                        <i class="fas fa-check mr-1"></i> Mark Completed
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius:9px">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none">
            <div class="modal-header" style="background:linear-gradient(135deg,#991b1b,#dc2626);color:white;border-radius:16px 16px 0 0;border:none">
                <h5 class="modal-title"><i class="fas fa-ban mr-2"></i> Cancel Appointment</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal"><span>&times;</span></button>
            </div>
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-group mb-0">
                        <label class="form-label" style="font-size:.82rem;font-weight:600">Reason <span style="color:#ef4444">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" style="border-radius:10px"
                                  placeholder="Reason for cancellation..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border:none;padding:16px 24px">
                    <button type="submit" class="btn btn-danger" style="border-radius:9px;font-weight:600">
                        <i class="fas fa-ban mr-1"></i> Cancel Appointment
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius:9px">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
