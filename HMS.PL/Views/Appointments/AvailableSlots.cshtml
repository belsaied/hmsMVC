@using HMS.BLL.Shared.Dtos.AppointmentModule
@model IEnumerable<AvailableSlotDto>

@{
    ViewData["Title"] = "Available Slots";
    var slots = Model?.ToList() ?? [];
    var available = slots.Where(s => s.IsAvailable).ToList();
    var booked = slots.Where(s => !s.IsAvailable).ToList();
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-muted: #64748b;
        }
        .slot-header {
            background: linear-gradient(135deg, var(--hms-blue), var(--hms-blue-mid));
            color: white;
            padding: 24px 32px;
            border-radius: 16px;
            margin-bottom: 24px;
        }
        .slot-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            border: 1px solid var(--hms-border);
            overflow: hidden;
        }
        .slot-card-header {
            padding: 16px 22px;
            border-bottom: 1px solid var(--hms-border);
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--hms-muted);
        }
        .slot-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
            padding: 20px 22px;
        }
        .slot-chip {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: .85rem;
            font-weight: 600;
            border: 1.5px solid var(--hms-border);
            transition: all .15s;
        }
        .slot-available {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }
        .slot-booked {
            background: #fef2f2;
            border-color: #fecaca;
            color: #991b1b;
            opacity: .6;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--hms-muted);
        }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Available Slots</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="Book">Book</a></li>
                <li class="breadcrumb-item active">Available Slots</li>
            </ol>
        </div>
    </div>
}

<div class="slot-header">
    <div>
        <h2 style="font-size:1.5rem;font-weight:700;margin:0">
            <i class="fas fa-clock mr-2"></i> Available Slots
        </h2>
        <p style="font-size:.875rem;opacity:.75;margin-top:6px">
            Dr. @ViewBag.DoctorName · @ViewBag.Date
        </p>
    </div>
</div>

@if (slots.Count == 0)
{
    <div class="slot-card">
        <div class="empty-state">
            <i class="fas fa-calendar-times"></i>
            <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No slots generated</p>
            <p>The doctor has no schedule configured for this date.</p>
        </div>
    </div>
}
else
{
    <div class="slot-card mb-4">
        <div class="slot-card-header">
            <i class="fas fa-check-circle mr-1" style="color:var(--hms-green)"></i> Available
            <span class="badge badge-success ml-2">@available.Count</span>
        </div>
        <div class="slot-grid">
            @foreach (var s in available)
            {
                <div class="slot-chip slot-available">
                    <i class="fas fa-check-circle" style="font-size:.7rem"></i>
                    @s.StartTime.ToString("hh:mm tt") – @s.EndTime.ToString("hh:mm tt")
                </div>
            }
            @if (available.Count == 0)
            {
                <div style="grid-column:1/-1;text-align:center;padding:20px;color:var(--hms-muted)">
                    No available slots on this date.
                </div>
            }
        </div>
    </div>

    <div class="slot-card">
        <div class="slot-card-header">
            <i class="fas fa-times-circle mr-1" style="color:var(--hms-red)"></i> Booked
            <span class="badge badge-danger ml-2">@booked.Count</span>
        </div>
        <div class="slot-grid">
            @foreach (var s in booked)
            {
                <div class="slot-chip slot-booked">
                    <i class="fas fa-times-circle" style="font-size:.7rem"></i>
                    @s.StartTime.ToString("hh:mm tt") – @s.EndTime.ToString("hh:mm tt")
                </div>
            }
            @if (booked.Count == 0)
            {
                <div style="grid-column:1/-1;text-align:center;padding:20px;color:var(--hms-muted)">
                    No booked slots on this date.
                </div>
            }
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Appointments" asp-action="Book" class="btn btn-primary" style="border-radius:9px;font-weight:600">
        <i class="fas fa-arrow-left mr-1"></i> Back to Booking
    </a>
</div>
