<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — HMS</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/lib/adminlte/dist/css/adminlte.min.css" />
    <!-- Select2 -->
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <!-- Toastr -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <!-- Flatpickr -->
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/" class="nav-link">Home</a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link" data-toggle="dropdown" href="#">
                            <i class="far fa-user"></i>
                            <span class="ml-1">@User.Identity.Name</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a href="/Auth/Logout" class="dropdown-item">
                                <i class="fas fa-sign-out-alt mr-2"></i> Sign out
                            </a>
                        </div>
                    </li>
                }
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/" class="brand-link">
                <img src="~/lib/adminlte/dist/img/AdminLTELogo.png"
                     alt="HMS Logo" class="brand-image img-circle elevation-3" style="opacity:.8" />
                <span class="brand-text font-weight-light">HMS</span>
            </a>

            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview"
                        role="menu" data-accordion="false">

                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-header">PATIENT MANAGEMENT</li>

                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? "active" : "")">
                                <i class="nav-icon fas fa-user-injured"></i>
                                <p>Patients <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-controller="Patients" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Patients</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Patients" asp-action="Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Add Patient</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-header">DOCTOR MANAGEMENT</li>

                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctors" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctors" ? "active" : "")">
                                <i class="nav-icon fas fa-user-md"></i>
                                <p>Doctors <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-controller="Doctors" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Doctors</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Departments" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Departments</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-header">CLINICAL</li>

                        <li class="nav-item">
                            <a asp-controller="MedicalRecords" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MedicalRecords" ? "active" : "")">
                                <i class="nav-icon fas fa-notes-medical"></i>
                                <p>Medical Records</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Appointments" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" ? "active" : "")">
                                <i class="nav-icon fas fa-calendar-check"></i>
                                <p>Appointments</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Wards" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Wards" ? "active" : "")">
                                <i class="nav-icon fas fa-bed"></i>
                                <p>Ward & Beds</p>
                            </a>
                        </li>

                        <li class="nav-header">BILLING</li>

                        <li class="nav-item">
                            <a asp-controller="Invoices" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoices" ? "active" : "")">
                                <i class="nav-icon fas fa-file-invoice-dollar"></i>
                                <p>Invoices</p>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    @await RenderSectionAsync("PageHeader", required: false)
                </div>
            </div>
            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>&copy; 2026 Hospital Management System.</strong>
            All rights reserved.
        </footer>

        <!-- Control Sidebar (collapsed by default) -->
        <aside class="control-sidebar control-sidebar-dark"></aside>
    </div>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE -->
    <script src="~/lib/adminlte/dist/js/adminlte.min.js"></script>
    <!-- Select2 -->
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <!-- Toastr -->
    <script src="~/lib/toastr/toastr.min.js"></script>
    <!-- Flatpickr -->
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <!-- jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Global toastr defaults
        toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: 'toast-top-right',
        timeOut: 4000
        };

        // Show TempData toasts
        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@Html.Raw(TempData["Success"])');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@Html.Raw(TempData["Error"])');</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>toastr.warning('@Html.Raw(TempData["Warning"])');</text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>