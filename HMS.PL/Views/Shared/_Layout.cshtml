<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — HMS</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/lib/adminlte/dist/css/adminlte.min.css" />
    <!-- Select2 -->
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <!-- Toastr -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <!-- Flatpickr -->
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />

    <style>
        :root {
            --hms-navy:    #0f1f38;
            --hms-blue:    #0078D4;
            --hms-blue-l:  #4da3e8;
            --hms-green:   #10b981;
            --hms-amber:   #f59e0b;
            --hms-red:     #ef4444;
            --hms-purple:  #8b5cf6;
            --hms-surface: #ffffff;
            --hms-bg:      #f0f4f8;
            --hms-border:  #e2e8f0;
            --hms-text:    #1e293b;
            --hms-muted:   #64748b;
            --radius:      14px;
            --shadow-sm:   0 2px 8px rgba(0,0,0,.07);
            --shadow-md:   0 8px 24px rgba(0,0,0,.10);
        }

        body.hold-transition {
            background-color: #f0f4f8 !important;
        }

        .sidebar-trigger {
            position: fixed;
            left: 0; top: 0;
            width: 6px; height: 100vh;
            z-index: 1040;
            cursor: pointer;
            background: transparent;
            transition: background 0.2s;
        }
        .sidebar-trigger:hover {
            background: rgba(0,120,212,0.08);
        }

        .main-sidebar {
            position: fixed !important;
            left: 0; top: 0;
            height: 100vh;
            width: 240px !important;
            z-index: 1030;
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(.4,0,.2,1), box-shadow 0.3s;
            border-radius: 0 18px 18px 0;
        }
        .sidebar-visible .main-sidebar {
            transform: translateX(0);
            box-shadow: 8px 0 36px rgba(0,0,0,0.16);
        }

        .content-wrapper,
        .main-footer {
            margin-left: 0 !important;
            transition: margin-left 0.3s cubic-bezier(.4,0,.2,1);
        }
        .sidebar-visible .content-wrapper,
        .sidebar-visible .main-footer {
            margin-left: 240px !important;
        }

        .sidebar-collapsible {
            opacity: 1;
            visibility: visible;
        }

        @@media (max-width: 991.98px) {
            .sidebar-trigger { display: none; }
            .sidebar-visible .content-wrapper,
            .sidebar-visible .main-footer { margin-left: 0 !important; }
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.55rem 0.75rem;
            border-radius: 10px;
            color: rgba(255,255,255,0.65) !important;
            font-size: 0.84rem;
            font-weight: 500;
            text-decoration: none;
            transition: background 0.18s, color 0.18s;
            position: relative;
        }
        .sidebar-link:hover {
            background: rgba(255,255,255,0.07) !important;
            color: #fff !important;
        }
        .sidebar-active {
            background: rgba(0,120,212,0.22) !important;
            color: #fff !important;
            font-weight: 600;
        }
        .sidebar-active::before {
            content: '';
            position: absolute;
            left: 0; top: 20%; bottom: 20%;
            width: 3px;
            background: #0078D4;
            border-radius: 0 3px 3px 0;
        }

        .sidebar-sub-link {
            display: flex;
            align-items: center;
            padding: 0.4rem 0.75rem;
            border-radius: 8px;
            color: rgba(255,255,255,0.5) !important;
            font-size: 0.8rem;
            text-decoration: none;
            transition: color 0.15s, background 0.15s;
        }
        .sidebar-sub-link:hover { color: rgba(255,255,255,0.85) !important; background: rgba(255,255,255,0.05) !important; }
        .sidebar-sub-active   { color: #fff !important; background: rgba(255,255,255,0.08) !important; }

        .sidebar-icon {
            width: 28px; height: 28px;
            border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.75rem;
            flex-shrink: 0;
        }

        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 2px; }

        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.4; transform: scale(0.85); }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Sidebar flyout trigger (invisible, 6px at left edge) -->
        <div class="sidebar-trigger"></div>

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand" style="
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            min-height: 56px;">

            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"
                       style="color: #64748b; font-size: 1rem;">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-flex align-items-center">
                    <span style="color: #94a3b8; font-size: 0.8rem;">@ViewData["Title"]</span>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto align-items-center" style="gap: 0.25rem;">

                <li class="nav-item d-none d-md-flex align-items-center me-2">
                    <span id="signalrBadge" style="
                        display: inline-flex; align-items: center; gap: 0.35rem;
                        font-size: 0.72rem; color: #94a3b8;
                        background: #f8fafc; border: 1px solid #e2e8f0;
                        border-radius: 20px; padding: 0.2rem 0.65rem;">
                        <span id="signalrDot" style="
                            width: 6px; height: 6px;
                            border-radius: 50%;
                            background: #94a3b8;
                            display: inline-block;"></span>
                        <span id="signalrLabel">Connecting&hellip;</span>
                    </span>
                </li>

                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button"
                       style="color: #64748b; width: 36px; height: 36px; display: flex;
                              align-items: center; justify-content: center; border-radius: 8px;"
                       title="Fullscreen">
                        <i class="fas fa-expand-arrows-alt" style="font-size: 0.85rem;"></i>
                    </a>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#"
                           style="display: flex; align-items: center; gap: 0.5rem;
                                  color: #1e293b; font-size: 0.84rem; font-weight: 500;
                                  background: #f1f5f9; border-radius: 22px;
                                  padding: 0.3rem 0.9rem 0.3rem 0.4rem;">
                            <span style="
                                width: 28px; height: 28px; border-radius: 50%;
                                background: linear-gradient(135deg,#0078D4,#00b4d8);
                                display: flex; align-items: center; justify-content: center;
                                color: #fff; font-size: 0.75rem; font-weight: 700; flex-shrink: 0;">
                                @(User.Identity.Name?.Substring(0,1).ToUpper() ?? "A")
                            </span>
                            <span class="d-none d-md-inline">@User.Identity.Name</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" style="
                             border: 1px solid #e2e8f0; border-radius: 12px;
                             box-shadow: 0 8px 24px rgba(0,0,0,0.1); padding: 0.5rem;
                             min-width: 160px;">
                            <a href="/Auth/Logout" class="dropdown-item" style="
                               border-radius: 8px; font-size: 0.84rem; color: #ef4444;">
                                <i class="fas fa-sign-out-alt me-2"></i> Sign out
                            </a>
                        </div>
                    </li>
                }
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar elevation-2" style="
            background: linear-gradient(180deg, #0f1f38 0%, #1a3255 60%, #0f2040 100%);
            border-right: 1px solid rgba(255,255,255,0.06);">

            <a href="/" class="brand-link" style="
                border-bottom: 1px solid rgba(255,255,255,0.08);
                padding: 1rem 1.25rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                text-decoration: none;">
                <div style="
                    width: 36px; height: 36px;
                    background: linear-gradient(135deg, #0078D4, #00b4d8);
                    border-radius: 10px;
                    display: flex; align-items: center; justify-content: center;
                    font-size: 0.9rem; color: #fff; flex-shrink: 0;
                    box-shadow: 0 4px 12px rgba(0,120,212,0.4);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v4h4v2h-4v4h-2v-4H7v-2h4V7z"
                              fill="currentColor"/>
                    </svg>
                </div>
                <div class="sidebar-collapsible" style="transition-delay: 0.04s;">
                    <div style="font-size: 1rem; font-weight: 800; color: #fff; line-height: 1.1;
                                font-family: 'Nunito', 'Source Sans Pro', sans-serif;">Healing</div>
                    <div style="font-size: 0.68rem; color: rgba(255,255,255,0.45); letter-spacing: 0.04em;">
                        Hospital Management
                    </div>
                </div>
            </a>

            <div class="sidebar" style="padding: 0.5rem 0; overflow-y: auto; height: calc(100vh - 70px);">
                <nav class="mt-1">
                    <ul class="nav nav-pills nav-sidebar flex-column" style="padding: 0 0.75rem; gap: 2px;">

                        <li class="sidebar-collapsible" style="margin: 0;">
                            <hr style="border:none; border-top:1px solid rgba(255,255,255,0.07); margin: 0.4rem 0 0.35rem;">
                            <span style="font-size: 0.6rem; font-weight: 700; color: rgba(255,255,255,0.25);
                                         text-transform: uppercase; letter-spacing: 0.13em;">Overview</span>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(0,120,212,0.18); color: #4da3e8;">
                                    <i class="fas fa-th-large"></i>
                                </span>
                                <span class="sidebar-collapsible">Admin Dashboard</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="DoctorDashboard"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "DoctorDashboard" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(16,185,129,0.15); color: #10b981;">
                                    <i class="fas fa-stethoscope"></i>
                                </span>
                                <span class="sidebar-collapsible">Doctor Dashboard</span>
                            </a>
                        </li>

                        <li class="sidebar-collapsible" style="margin: 0;">
                            <hr style="border:none; border-top:1px solid rgba(255,255,255,0.07); margin: 0.75rem 0 0.35rem;">
                            <span style="font-size: 0.6rem; font-weight: 700; color: rgba(255,255,255,0.25);
                                         text-transform: uppercase; letter-spacing: 0.13em;">Patients</span>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Patients" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(245,158,11,0.15); color: #f59e0b;">
                                    <i class="fas fa-user-injured"></i>
                                </span>
                                <span class="sidebar-collapsible">All Patients</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Patients" asp-action="Create"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" && ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? "sidebar-active" : "")"
                               style="padding-left: 2.4rem;">
                                <i class="fas fa-plus" style="width:28px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.35); flex-shrink:0;"></i>
                                <span class="sidebar-collapsible">Add Patient</span>
                            </a>
                        </li>

                        <li class="sidebar-collapsible" style="margin: 0;">
                            <hr style="border:none; border-top:1px solid rgba(255,255,255,0.07); margin: 0.75rem 0 0.35rem;">
                            <span style="font-size: 0.6rem; font-weight: 700; color: rgba(255,255,255,0.25);
                                         text-transform: uppercase; letter-spacing: 0.13em;">Clinical</span>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Appointments" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(245,158,11,0.12); color: #fbbf24;">
                                    <i class="fas fa-calendar-check"></i>
                                </span>
                                <span class="sidebar-collapsible">Appointments</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="MedicalRecords" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MedicalRecords" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(239,68,68,0.12); color: #f87171;">
                                    <i class="fas fa-notes-medical"></i>
                                </span>
                                <span class="sidebar-collapsible">Medical Records</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Admissions" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admissions" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(239,68,68,0.12); color: #f87171;">
                                    <i class="fas fa-procedures"></i>
                                </span>
                                <span class="sidebar-collapsible">Active Admissions</span>
                                <span id="sidebarPulseAdmissions" style="
                                    display: none;
                                    width: 7px; height: 7px;
                                    background: #ef4444;
                                    border-radius: 50%;
                                    margin-left: auto;
                                    flex-shrink: 0;
                                    animation: pulse 1.5s infinite;">
                                </span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Wards" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Wards" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(14,165,233,0.12); color: #38bdf8;">
                                    <i class="fas fa-bed"></i>
                                </span>
                                <span class="sidebar-collapsible">Ward &amp; Beds</span>
                                <span id="sidebarBedPulse" style="
                                    display: none;
                                    width: 7px; height: 7px;
                                    background: #10b981;
                                    border-radius: 50%;
                                    margin-left: auto;
                                    flex-shrink: 0;
                                    animation: pulse 1.5s infinite;">
                                </span>
                            </a>
                        </li>

                        <li class="sidebar-collapsible" style="margin: 0;">
                            <hr style="border:none; border-top:1px solid rgba(255,255,255,0.07); margin: 0.75rem 0 0.35rem;">
                            <span style="font-size: 0.6rem; font-weight: 700; color: rgba(255,255,255,0.25);
                                         text-transform: uppercase; letter-spacing: 0.13em;">Staff</span>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Doctors" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctors" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(139,92,246,0.15); color: #a78bfa;">
                                    <i class="fas fa-user-md"></i>
                                </span>
                                <span class="sidebar-collapsible">All Doctors</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Departments" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departments" ? "sidebar-active" : "")"
                               style="padding-left: 2.4rem;">
                                <i class="fas fa-hospital" style="width:28px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.35); flex-shrink:0;"></i>
                                <span class="sidebar-collapsible">Departments</span>
                            </a>
                        </li>

                        <li class="sidebar-collapsible" style="margin: 0;">
                            <hr style="border:none; border-top:1px solid rgba(255,255,255,0.07); margin: 0.75rem 0 0.35rem;">
                            <span style="font-size: 0.6rem; font-weight: 700; color: rgba(255,255,255,0.25);
                                         text-transform: uppercase; letter-spacing: 0.13em;">Finance</span>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Invoices" asp-action="Index"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoices" ? "sidebar-active" : "")">
                                <span class="sidebar-icon" style="background: rgba(16,185,129,0.12); color: #34d399;">
                                    <i class="fas fa-receipt"></i>
                                </span>
                                <span class="sidebar-collapsible">Invoices</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Reports" asp-action="Revenue"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Revenue" ? "sidebar-active" : "")"
                               style="padding-left: 2.4rem;">
                                <i class="fas fa-chart-bar" style="width:28px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.35); flex-shrink:0;"></i>
                                <span class="sidebar-collapsible">Revenue Report</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Reports" asp-action="Outstanding"
                               class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Outstanding" ? "sidebar-active" : "")"
                               style="padding-left: 2.4rem;">
                                <i class="fas fa-exclamation-circle" style="width:28px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.35); flex-shrink:0;"></i>
                                <span class="sidebar-collapsible">Outstanding</span>
                            </a>
                        </li>

                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("HospitalAdmin"))
                        {
                            <li class="sidebar-collapsible" style="margin: 0;">
                                <hr style="border:none; border-top:1px solid rgba(255,255,255,0.07); margin: 0.75rem 0 0.35rem;">
                                <span style="font-size: 0.6rem; font-weight: 700; color: rgba(255,255,255,0.25);
                                             text-transform: uppercase; letter-spacing: 0.13em;">Administration</span>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="UserManagement" asp-action="Index"
                                   class="nav-link sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserManagement" && ViewContext.RouteData.Values["action"]?.ToString() != "AuditLog" ? "sidebar-active" : "")">
                                    <span class="sidebar-icon" style="background: rgba(139,92,246,0.15); color: #a78bfa;">
                                        <i class="fas fa-users-cog"></i>
                                    </span>
                                    <span class="sidebar-collapsible">User Management</span>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="UserManagement" asp-action="AuditLog"
                                   class="nav-link sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLog" ? "sidebar-active" : "")"
                                   style="padding-left: 2.4rem;">
                                    <i class="fas fa-history" style="width:28px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.35); flex-shrink:0;"></i>
                                    <span class="sidebar-collapsible">Audit Log</span>
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    @await RenderSectionAsync("PageHeader", required: false)
                </div>
            </div>
            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     xmlns="http://www.w3.org/2000/svg" style="vertical-align: middle; margin-right: 4px;">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v4h4v2h-4v4h-2v-4H7v-2h4V7z"
                          fill="#0078D4"/>
                </svg>
                &copy; @DateTime.Now.Year Healing
            </strong>
            &mdash; Hospital Management System. All rights reserved.
        </footer>

        <aside class="control-sidebar control-sidebar-dark"></aside>
    </div>

    <!-- jQuery -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE -->
    <script src="~/lib/adminlte/dist/js/adminlte.min.js"></script>
    <!-- Select2 -->
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <!-- Toastr -->
    <script src="~/lib/toastr/toastr.min.js"></script>
    <!-- Flatpickr -->
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <!-- jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: 'toast-top-right',
        timeOut: 4000
        };

        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@Html.Raw(TempData["Success"])');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>toastr.error('@Html.Raw(TempData["Error"])');</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>toastr.warning('@Html.Raw(TempData["Warning"])');</text>
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var trigger = document.querySelector('.sidebar-trigger');
            var sidebar = document.querySelector('.main-sidebar');
            var wrapper = document.querySelector('.wrapper');
            var toggleBtn = document.querySelector('[data-widget="pushmenu"]');

            if (trigger && sidebar && wrapper) {
                trigger.addEventListener('mouseenter', function() {
                    wrapper.classList.add('sidebar-visible');
                });
                sidebar.addEventListener('mouseenter', function() {
                    wrapper.classList.add('sidebar-visible');
                });
                sidebar.addEventListener('mouseleave', function() {
                    wrapper.classList.remove('sidebar-visible');
                });
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    wrapper.classList.toggle('sidebar-visible');
                });
            }
        });
    </script>

    <!-- ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <!-- SignalR Client -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr/dist/browser/signalr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
