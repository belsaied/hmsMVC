        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var trigger = document.querySelector('.sidebar-trigger');
            var sidebar = document.querySelector('.main-sidebar');
            var wrapper = document.querySelector('.wrapper');
            var toggleBtn = document.querySelector('[data-widget="pushmenu"]');
            var profileBtn = document.getElementById('userProfileBtn');
            var profilePanel = document.getElementById('userProfilePanel');

            if (trigger && sidebar && wrapper) {
                trigger.addEventListener('mouseenter', function() {
                    wrapper.classList.add('sidebar-visible');
                });
                sidebar.addEventListener('mouseenter', function() {
                    wrapper.classList.add('sidebar-visible');
                });
                sidebar.addEventListener('mouseleave', function() {
                    wrapper.classList.remove('sidebar-visible');
                });
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    wrapper.classList.toggle('sidebar-visible');
                });
            }

            if (profileBtn && profilePanel) {
                var chevron = document.getElementById('profileChevron');
                profileBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var isOpen = profilePanel.classList.toggle('open');
                    if (chevron) {
                        chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
                    }
                });
                document.addEventListener('click', function(e) {
                    if (!profileBtn.contains(e.target) && !profilePanel.contains(e.target)) {
                        profilePanel.classList.remove('open');
                        if (chevron) chevron.style.transform = 'rotate(0deg)';
                    }
                });
            }
        });
    </script>

    <!-- ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <!-- SignalR Client -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr/dist/browser/signalr.min.js"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        var signalrUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        <script>
            (function() {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/notifications')
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .build();

                var badgeEl = document.getElementById('sidebarNotifBadge');
                var dotEl = document.getElementById('signalrDot');
                var labelEl = document.getElementById('signalrLabel');

                function setConnected(connected) {
                    if (dotEl) {
                        dotEl.style.background = connected ? '#10b981' : '#ef4444';
                    }
                    if (labelEl) {
                        labelEl.textContent = connected ? 'Connected' : 'Disconnected';
                    }
                }

                connection.on('ReceiveNotification', function(notification) {
                    toastr.info(notification.body || notification.subject, 'New Notification');
                    if (badgeEl) {
                        var current = parseInt(badgeEl.textContent) || 0;
                        badgeEl.textContent = current + 1;
                        badgeEl.style.display = 'block';
                    }
                });

                connection.onreconnecting(function() {
                    setConnected(false);
                    if (labelEl) labelEl.textContent = 'Reconnecting...';
                });

                connection.onreconnected(function() {
                    setConnected(true);
                    connection.invoke('JoinUserGroup', '@signalrUserId').catch(function() {});
                });

                connection.onclose(function() {
                    setConnected(false);
                    if (labelEl) labelEl.textContent = 'Disconnected';
                });

                connection.start().then(function() {
                    setConnected(true);
                    return connection.invoke('JoinUserGroup', '@signalrUserId');
                }).catch(function(err) {
                    setConnected(false);
                    console.error('SignalR connection error:', err);
                });
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
