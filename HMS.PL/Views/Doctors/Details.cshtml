@using HMS.BLL.Shared.Dtos.DoctorModule.DoctorDtos
@model DoctorWithDetailsResultDto

@{
    ViewData["Title"] = "Doctor — " + Model.FullName;
    var statusClass = Model.Status switch
    {
        "Active" => "status-active",
        "OnLeave" => "status-onleave",
        "Inactive" => "status-inactive",
        "Suspended" => "status-suspended",
        _ => "status-inactive"
    };
}

@section Styles {
    <style>
        :root {
            --hms-teal: #0f766e;
            --hms-teal-mid: #14b8a6;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .lightbox-overlay {
            position: fixed; inset: 0; z-index: 9999;
            background: rgba(0,0,0,0.75); display: none;
            align-items: center; justify-content: center;
            backdrop-filter: blur(4px); cursor: pointer;
        }
        .lightbox-overlay.show { display: flex; }
        .lightbox-overlay img {
            max-width: 90vw; max-height: 85vh; border-radius: 14px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            object-fit: contain; cursor: default;
            animation: lightboxIn 0.25s ease-out;
        }
        @@keyframes lightboxIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
        .lightbox-close {
            position: absolute; top: 20px; right: 28px;
            color: white; font-size: 2.2rem; font-weight: 300;
            cursor: pointer; opacity: 0.7; transition: opacity 0.15s;
            line-height: 1; text-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .lightbox-close:hover { opacity: 1; }

        .profile-card { background: white; border-radius: 18px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); border: 1px solid var(--hms-border); }
        .profile-header { background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%); padding: 28px 20px 20px; text-align: center; position: relative; }
        .profile-avatar { width: 90px; height: 90px; border-radius: 50%; border: 3px solid rgba(255,255,255,0.3); margin: 0 auto 12px; object-fit: cover; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
        .profile-avatar:hover { transform: scale(1.03); box-shadow: 0 0 0 4px rgba(255,255,255,0.4); }
        .profile-name { font-size: 1.15rem; font-weight: 700; color: white; margin-bottom: 2px; }
        .profile-spec { font-size: 0.85rem; color: rgba(255,255,255,0.75); }
        .profile-dept { font-size: 0.78rem; color: rgba(255,255,255,0.55); }

        .status-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; margin-top: 10px; }
        .status-active { background: rgba(16,185,129,0.2); color: #d1fae5; }
        .status-onleave { background: rgba(245,158,11,0.2); color: #fef3c7; }
        .status-inactive { background: rgba(100,116,139,0.2); color: #f1f5f9; }
        .status-suspended { background: rgba(239,68,68,0.2); color: #fee2e2; }

        .profile-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--hms-border); }
        .profile-stat { padding: 14px 12px; text-align: center; border-right: 1px solid var(--hms-border); border-bottom: 1px solid var(--hms-border); }
        .profile-stat:nth-child(2), .profile-stat:nth-child(4) { border-right: none; }
        .profile-stat-value { font-size: 1.1rem; font-weight: 700; color: var(--hms-text); }
        .profile-stat-label { font-size: 0.72rem; color: var(--hms-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }

        .profile-actions { padding: 16px; display: flex; flex-direction: column; gap: 8px; }
        .btn-profile-action { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 10px; font-size: 0.875rem; font-weight: 600; border: none; cursor: pointer; transition: all 0.15s; text-decoration: none; }
        .btn-edit-profile { background: #fef3c7; color: #92400e; }
        .btn-edit-profile:hover { background: #f59e0b; color: white; }
        .btn-schedule { background: #ccfbf1; color: #0f766e; }
        .btn-schedule:hover { background: #0f766e; color: white; }
        .btn-qual { background: #ede9fe; color: #6d28d9; }
        .btn-qual:hover { background: #7c3aed; color: white; }

        .quick-links { padding: 0 16px 16px; }
        .quick-links-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--hms-text-muted); margin-bottom: 8px; }
        .quick-link { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 9px; font-size: 0.83rem; font-weight: 500; color: var(--hms-text); text-decoration: none; transition: background 0.12s; border: 1px solid transparent; }
        .quick-link:hover { background: #f0f4ff; border-color: #bfdbfe; color: var(--hms-teal); }
        .quick-link .ql-icon { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; }

        .detail-card { background: white; border-radius: 18px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); border: 1px solid var(--hms-border); }
        .nav-tabs { border-bottom: 1px solid var(--hms-border); background: #f8faff; padding: 0 16px; flex-wrap: nowrap; overflow-x: auto; }
        .nav-tabs .nav-link { border: none; border-bottom: 3px solid transparent; padding: 14px 18px; font-size: 0.875rem; font-weight: 600; color: var(--hms-text-muted); white-space: nowrap; border-radius: 0; transition: all 0.15s; }
        .nav-tabs .nav-link.active { color: var(--hms-teal); border-bottom-color: var(--hms-teal); background: transparent; }
        .nav-tabs .nav-link:hover:not(.active) { color: var(--hms-text); background: rgba(0,0,0,0.03); }
        .tab-content { padding: 24px; }

        .info-section { margin-bottom: 24px; }
        .info-section-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--hms-text-muted); border-bottom: 1px solid var(--hms-border); padding-bottom: 8px; margin-bottom: 16px; }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .info-label { font-size: 0.75rem; color: var(--hms-text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 3px; }
        .info-value { font-size: 0.92rem; font-weight: 500; color: var(--hms-text); }

        .tab-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        .tab-table thead th { background: #f8faff; color: var(--hms-text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 10px 14px; border-bottom: 1px solid var(--hms-border); }
        .tab-table tbody td { padding: 12px 14px; border-bottom: 1px solid var(--hms-border); font-size: 0.88rem; }
        .tab-table tbody tr:last-child td { border-bottom: none; }
        .tab-table tbody tr:hover td { background: #f8faff; }

        .empty-tab { text-align: center; padding: 40px 20px; color: var(--hms-text-muted); }
        .empty-tab i { font-size: 2.5rem; opacity: 0.2; display: block; margin-bottom: 10px; }

        .fee-amount { font-size: 1.2rem; font-weight: 700; color: var(--hms-teal); }
        .qual-badge { background: #ede9fe; color: #6d28d9; padding: 2px 10px; border-radius: 8px; font-size: 0.75rem; font-weight: 600; display: inline-block; }
        .schedule-available { color: #10b981; }
        .schedule-unavailable { color: #ef4444; }
    </style>
}

<div class="row">
    <div class="col-md-3">
        <div class="profile-card mb-4">
            <div class="profile-header">
                @if (!string.IsNullOrEmpty(Model.PictureUrl))
                {
                    <img src="@Model.PictureUrl" class="profile-avatar" alt="@Model.FullName" onclick="openLightbox(this.src)" />
                }
                else
                {
                    <div class="profile-avatar">
                        @(Model.FirstName?.Substring(0, 1).ToUpper())@(Model.LastName?.Substring(0, 1).ToUpper())
                    </div>
                }
                <div class="profile-name">@Model.FullName</div>
                <div class="profile-spec">@Model.Specialization</div>
                <div class="profile-dept">@Model.DepartmentName</div>
                <div>
                    <span class="status-badge @statusClass">
                        <i class="fas fa-circle" style="font-size:0.5rem"></i> @Model.Status
                    </span>
                </div>
            </div>
            <div class="profile-stats">
                <div class="profile-stat"><div class="profile-stat-value">@Model.YearsOfExperience</div><div class="profile-stat-label">Experience</div></div>
                <div class="profile-stat"><div class="profile-stat-value">@Model.Age</div><div class="profile-stat-label">Age</div></div>
                <div class="profile-stat"><div class="profile-stat-value">@Model.Gender</div><div class="profile-stat-label">Gender</div></div>
                <div class="profile-stat">
                    <div class="fee-amount">@Model.ConsultationFee.ToString("C", new System.Globalization.CultureInfo("en-EG"))</div>
                    <div class="profile-stat-label">Consultation Fee</div>
                </div>
            </div>
            <div class="profile-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-profile-action btn-edit-profile">
                    <i class="fas fa-edit"></i> Edit Doctor
                </a>
                <a asp-action="Schedule" asp-route-id="@Model.Id" class="btn-profile-action btn-schedule">
                    <i class="fas fa-clock"></i> Manage Schedule
                </a>
                <a asp-action="Qualifications" asp-route-id="@Model.Id" class="btn-profile-action btn-qual">
                    <i class="fas fa-graduation-cap"></i> Qualifications
                </a>
                <form asp-action="UploadPicture" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="picForm">
                    @Html.AntiForgeryToken()
                    <input type="file" id="picInput" name="file" accept=".jpg,.jpeg,.png,.webp" style="display:none"
                           onchange="document.getElementById('picForm').submit()" />
                    <button type="button" class="btn-profile-action w-100"
                            style="background:#f0f4ff;color:#1e3a5c;"
                            onmouseover="this.style.background='#bfdbfe'" onmouseout="this.style.background='#f0f4ff'"
                            onclick="document.getElementById('picInput').click()">
                        <i class="fas fa-camera"></i> Update Photo
                    </button>
                </form>
            </div>
            @if (Model.Status == "Active")
            {
                <div class="p-3" style="border-top:1px solid var(--hms-border)">
                    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Deactivate @Model.FullName?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger btn-block" style="border-radius:9px;font-weight:600">
                            <i class="fas fa-ban mr-1"></i> Deactivate Doctor
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="col-md-9">
        <div class="detail-card">
            <ul class="nav nav-tabs" id="doctorTab">
                <li class="nav-item"><a class="nav-link active" href="#tab-info"><i class="fas fa-info-circle mr-1"></i> Personal Info</a></li>
                <li class="nav-item"><a class="nav-link" asp-action="Qualifications" asp-route-id="@Model.Id"><i class="fas fa-graduation-cap mr-1"></i> Qualifications @(Model.Qualifications.Any() ? $"({Model.Qualifications.Count()})" : "")</a></li>
                <li class="nav-item"><a class="nav-link" asp-action="Schedule" asp-route-id="@Model.Id"><i class="fas fa-clock mr-1"></i> Schedule @(Model.AvailabilitySchedules.Any() ? $"({Model.AvailabilitySchedules.Count()})" : "")</a></li>
                <li class="nav-item"><a class="nav-link" asp-action="Patients" asp-route-id="@Model.Id"><i class="fas fa-users mr-1"></i> Patients</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="tab-info">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-section">
                                <div class="info-section-title"><i class="fas fa-user mr-1"></i> Personal Information</div>
                                <div class="info-grid">
                                    <div class="info-item"><div class="info-label">First Name</div><div class="info-value">@Model.FirstName</div></div>
                                    <div class="info-item"><div class="info-label">Last Name</div><div class="info-value">@Model.LastName</div></div>
                                    <div class="info-item"><div class="info-label">Email</div><div class="info-value">@Model.Email</div></div>
                                    <div class="info-item"><div class="info-label">Phone</div><div class="info-value">@Model.Phone</div></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-section">
                                <div class="info-section-title"><i class="fas fa-briefcase mr-1"></i> Professional Info</div>
                                <div class="info-grid">
                                    <div class="info-item"><div class="info-label">Specialization</div><div class="info-value">@Model.Specialization</div></div>
                                    <div class="info-item"><div class="info-label">Department</div><div class="info-value">@Model.DepartmentName</div></div>
                                    <div class="info-item"><div class="info-label">Experience</div><div class="info-value">@Model.YearsOfExperience year(s)</div></div>
                                    <div class="info-item"><div class="info-label">Joined</div><div class="info-value">@Model.JoinDate.ToString("dd MMM yyyy")</div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <div class="info-section">
                            <div class="info-section-title"><i class="fas fa-align-left mr-1"></i> Bio</div>
                            <p style="font-size:0.9rem;color:var(--hms-text);line-height:1.6">@Model.Bio</p>
                        </div>
                    }
                </div>
                <div style="padding:24px;text-align:center;color:var(--hms-text-muted)">
                    <i class="fas fa-arrow-up" style="font-size:1.5rem;opacity:0.3;display:block;margin-bottom:8px"></i>
                    <p style="margin:0;font-weight:500">
                        Use the tabs above to manage Qualifications and Schedule.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox overlay -->
<div class="lightbox-overlay" id="lightbox" onclick="closeLightbox()">
    <span class="lightbox-close">&times;</span>
    <img id="lightboxImg" src="" alt="Profile photo" onclick="event.stopPropagation()" />
</div>

@section Scripts {
    <script>
        function openLightbox(src) {
            document.getElementById('lightboxImg').src = src;
            document.getElementById('lightbox').classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('show');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeLightbox();
        });
    </script>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Doctor Details</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Doctors</a></li>
                <li class="breadcrumb-item active">@Model.FullName</li>
            </ol>
        </div>
    </div>
}
