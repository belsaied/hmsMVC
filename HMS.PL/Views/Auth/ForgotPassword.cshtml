@model HMS.PL.ViewModels.AuthModule.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LandingLayout";
}

<div class="hms-auth-wrapper">
    <div class="hms-auth-bg-shape hms-auth-bg-shape--1"></div>
    <div class="hms-auth-bg-shape hms-auth-bg-shape--2"></div>
    <div class="hms-auth-bg-shape hms-auth-bg-shape--3"></div>

    <div class="hms-auth-card">
        <div class="hms-auth-brand">
            <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48">
                <path d="M50 88 C6 54 12 20 38 22 C49 22 50 34 50 34 C50 34 53 22 62 23 C88 23 94 56 50 88Z" fill="rgba(29,78,216,0.06)" stroke="none"/>
                <path d="M50 86 C8 52 14 22 38 24 C49 24 50 35 50 35 C50 35 53 24 62 25 C85 25 91 55 50 86Z" stroke="#1D4ED8" stroke-width="4" stroke-linejoin="round" stroke-linecap="round" fill="none"/>
                <path d="M50 82 C14 54 20 28 38 28 C47 28 50 36 50 36 C50 36 53 28 62 29 C80 29 86 54 50 82Z" stroke="#3B82F6" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" fill="none" opacity="0.5"/>
                <path d="M5 52 L22 52 L28 52 L34 38 L40 66 L46 52 L54 52 L60 38 L66 66 L72 52 L95 52" stroke="#1D4ED8" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
                <path d="M5 52 L22 52 L28 52 L34 38 L40 66 L46 52 L54 52 L60 38 L66 66 L72 52 L95 52" stroke="#60A5FA" stroke-width="4" stroke-linejoin="round" stroke-linecap="round" opacity="0.2" style="filter: blur(2px);"/>
            </svg>
            <div class="hms-auth-brand-text">
                <span class="hms-auth-brand-title">HEALING</span>
                <span class="hms-auth-brand-sub">HOSPITAL MANAGEMENT SYSTEM</span>
            </div>
        </div>

        <div class="hms-auth-header">
            <h1 class="hms-auth-title">Forgot Password</h1>
            <p class="hms-auth-subtitle">Enter your email to receive a reset link</p>
        </div>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="hms-auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="hms-auth-error" role="alert"></div>

            <div class="hms-input-group">
                <div class="hms-input-wrap">
                    <span class="hms-input-icon"><i class="far fa-envelope"></i></span>
                    <input asp-for="Email" class="hms-form-input" placeholder="Enter your email address" />
                </div>
                <span asp-validation-for="Email" class="hms-field-error"></span>
            </div>

            <button type="submit" class="hms-auth-btn">
                <i class="fas fa-paper-plane"></i>
                <span>Send Reset Link</span>
            </button>
        </form>

        <p class="hms-auth-footer-text">
            <a asp-controller="Auth" asp-action="Login" class="hms-auth-link">Back to Sign In</a>
        </p>

        <div class="hms-auth-footer-decoration">
            <svg viewBox="0 0 200 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="200" height="20" opacity="0.15">
                <path d="M0 10 L20 10 L25 10 L30 2 L36 18 L42 6 L48 14 L55 10 L80 10 L85 10 L90 2 L96 18 L102 6 L108 14 L115 10 L140 10 L145 10 L150 2 L156 18 L162 6 L168 14 L175 10 L200 10" stroke="#123A7A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
