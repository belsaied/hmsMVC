@using HMS.BLL.Shared.Dtos.MedicalRecordsDto
@model MedicalRecordResultDto

@{
ViewData["Title"] = "Prescriptions · Record #" + Model.Id;
}

@section Styles {
<style>
:root {
--blue: #1e40af; --blue-light: #dbeafe; --blue-bg: #eff6ff;
--red: #dc2626; --red-light: #fee2e2; --red-bg: #fef2f2;
--green: #059669; --green-light: #d1fae5; --green-bg: #ecfdf5;
--purple: #7c3aed; --purple-light: #ede9fe; --purple-bg: #f5f3ff;
--amber: #d97706; --amber-light: #fef3c7;
--teal: #0f766e; --teal-light: #ccfbf1;
--text: #1e293b; --text-muted: #64748b; --border: #e2e8f0;
--hms-primary: #3b82f6;
}

.clinical-card { background: white; border-radius: 16px; border: 1px solid var(--border); overflow: hidden; margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); }
.clinical-section { padding: 18px 22px; }

.info-sidebar { background: white; border-radius: 16px; border: 1px solid var(--border); overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.05); }
.section { padding: 16px 18px; border-bottom: 1px solid var(--border); }
.section:last-child { border-bottom: none; }
.section-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
.info-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.info-row:last-child { margin-bottom: 0; }
.info-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
.info-label { font-size: 0.7rem; color: var(--text-muted); }
.info-value { font-size: 0.88rem; font-weight: 600; color: var(--text); }

.page-header-card {
background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
color: white; padding: 28px 32px; border-radius: 16px; margin-bottom: 24px;
display: flex; align-items: center; justify-content: space-between;
box-shadow: 0 8px 32px rgba(124,58,237,0.18); position: relative; overflow: hidden;
}
.page-header-card::before { content: ''; position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; background: rgba(255,255,255,0.07); border-radius: 50%; }
.page-title { font-size: 1.5rem; font-weight: 700; margin: 0; position: relative; z-index: 1; }
.page-subtitle { font-size: 0.85rem; opacity: 0.75; margin-top: 4px; position: relative; z-index: 1; }

.rx-list { display: flex; flex-direction: column; gap: 10px; }
.rx-item { background: white; border: 1px solid var(--border); border-radius: 12px; padding: 16px 18px; }
.rx-item .rx-top { display: flex; justify-content: space-between; align-items: flex-start; }
.rx-item .rx-name { font-weight: 700; font-size: 0.95rem; }
.rx-item .rx-dosage { font-size: 0.82rem; color: var(--text-muted); }
.badge-rx { padding: 2px 10px; border-radius: 10px; font-size: 0.72rem; font-weight: 600; }
.badge-rx-active { background: var(--green-light); color: var(--green); }
.badge-rx-cancelled { background: var(--red-light); color: var(--red); }
.badge-controlled { background: var(--amber-light); color: var(--amber); padding: 1px 6px; border-radius: 5px; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; margin-left: 6px; }

.add-section { background: #f8faff; border: 1px dashed #bfdbfe; border-radius: 12px; padding: 20px; margin-top: 16px; }
.add-section-title { font-size: 0.8rem; font-weight: 700; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; color: var(--purple); }
.form-control-custom { border-radius: 8px; border-color: var(--border); }
</style>
}

<div class="page-header-card">
<div>
<h3 class="page-title"><i class="fas fa-pills mr-2"></i> Prescriptions · Record #@Model.Id</h3>
<p class="page-subtitle">@Model.VisitDate.ToString("dddd, dd MMM yyyy") · @Model.PatientName · Dr. @Model.DoctorName</p>
</div>
<div style="position:relative;z-index:1">
<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm" style="background:rgba(255,255,255,0.2);color:white;border:none;border-radius:10px;font-weight:600">
<i class="fas fa-arrow-left mr-1"></i> Back to Record
</a>
</div>
</div>

<div class="row">
<div class="col-md-4">
<div class="info-sidebar mb-4">
<div class="section">
<div class="section-title"><i class="fas fa-calendar-alt" style="color:var(--blue)"></i> Visit</div>
<div class="info-row">
<div class="info-icon" style="background:var(--blue-light);color:var(--blue)"><i class="fas fa-calendar-day"></i></div>
<div><div class="info-label">Visit Date</div><div class="info-value">@Model.VisitDate.ToString("dd MMM yyyy")</div></div>
</div>
<div class="info-row">
<div class="info-icon" style="background:var(--blue-light);color:var(--blue)"><i class="fas fa-clock"></i></div>
<div><div class="info-label">Recorded</div><div class="info-value">@Model.RecordedAt.ToString("dd MMM yyyy · HH:mm")</div></div>
</div>
</div>
<div class="section">
<div class="section-title"><i class="fas fa-users" style="color:var(--teal)"></i> People</div>
<div class="info-row">
<div class="info-icon" style="background:var(--blue-light);color:var(--blue)"><i class="fas fa-user-injured"></i></div>
<div><div class="info-label">Patient</div><div class="info-value">@Model.PatientName</div></div>
</div>
<div class="info-row">
<div class="info-icon" style="background:var(--teal-light);color:var(--teal)"><i class="fas fa-user-md"></i></div>
<div><div class="info-label">Doctor</div><div class="info-value">@Model.DoctorName</div></div>
</div>
</div>
</div>
</div>

<div class="col-md-8">
<div class="clinical-card">
<div style="padding:20px">
@if (Model.Prescriptions.Any())
{
<div class="rx-list">
@foreach (var rx in Model.Prescriptions)
{
var badgeClass = rx.Status == "Active" ? "badge-rx-active" : "badge-rx-cancelled";
<div class="rx-item">
<div class="rx-top">
<div style="flex:1">
<div style="display:flex;align-items:center;gap:6px">
<span class="rx-name"><i class="fas fa-prescription-bottle mr-1" style="color:var(--purple)"></i> @rx.MedicationName</span>
@if (rx.IsControlledSubstance)
{
<span class="badge-controlled"><i class="fas fa-exclamation-triangle mr-1"></i> Controlled</span>
}
</div>
<div class="rx-dosage">@rx.Dosage · @rx.Frequency · @rx.DurationDays day(s)</div>
@if (!string.IsNullOrEmpty(rx.Instructions))
{
<div style="margin-top:6px;font-size:0.82rem;color:var(--text);padding:8px 12px;background:var(--purple-bg);border-radius:8px">
<i class="fas fa-info-circle mr-1" style="color:var(--purple)"></i> @rx.Instructions
</div>
}
</div>
<div style="text-align:right;flex-shrink:0;min-width:100px">
<div><span class="badge-rx @badgeClass">@rx.Status</span></div>
<div style="font-size:0.7rem;color:var(--text-muted);margin-top:4px">@rx.PrescribedAt.ToString("dd MMM yyyy")</div>
<div style="display:flex;gap:4px;justify-content:flex-end;margin-top:6px">
@if (rx.Status == "Active")
{
<form asp-action="CancelPrescription" asp-route-recordId="@Model.Id" asp-route-prescriptionId="@rx.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this prescription?')">
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-sm" style="background:var(--red-light);color:var(--red);border:none;border-radius:8px;font-size:0.7rem;font-weight:600;padding:3px 10px">
<i class="fas fa-ban mr-1"></i> Cancel
</button>
</form>
}
<a asp-action="DownloadPrescriptionPdf" asp-route-prescriptionId="@rx.Id" asp-route-patientId="@Model.PatientId"
class="btn btn-sm" style="background:var(--blue-light);color:var(--blue);border:none;border-radius:8px;font-size:0.7rem;font-weight:600;padding:3px 10px;text-decoration:none">
<i class="fas fa-download mr-1"></i> PDF
</a>
</div>
</div>
</div>
<div style="border-top:1px solid var(--border);margin-top:10px;padding-top:8px;font-size:0.75rem;color:var(--text-muted)">
<i class="fas fa-hourglass-end mr-1"></i> Expires: @rx.ExpiresAt.ToString("dd MMM yyyy")
</div>
</div>
}
</div>
}
else
{
<div style="text-align:center;padding:24px;color:var(--text-muted)">
<i class="fas fa-pills" style="font-size:2rem;opacity:0.2;display:block;margin-bottom:8px"></i>
<p style="font-weight:600;margin:0">No prescriptions for this visit</p>
</div>
}
</div>
</div>

<div class="clinical-card">
<div class="add-section">
<div class="add-section-title"><i class="fas fa-plus-circle"></i> Add Prescription</div>
<form asp-action="AddPrescription" asp-route-recordId="@Model.Id" method="post">
@Html.AntiForgeryToken()
<div class="row">
<div class="col-md-6 mb-2">
<label style="font-size:0.7rem;font-weight:600;color:var(--text-muted)">Medication</label>
<input name="MedicationName" type="text" class="form-control form-control-sm" style="border-radius:8px;border-color:var(--border)" required />
</div>
<div class="col-md-3 mb-2">
<label style="font-size:0.7rem;font-weight:600;color:var(--text-muted)">Dosage</label>
<input name="Dosage" type="text" class="form-control form-control-sm" style="border-radius:8px;border-color:var(--border)" placeholder="e.g. 500mg" required />
</div>
<div class="col-md-3 mb-2">
<label style="font-size:0.7rem;font-weight:600;color:var(--text-muted)">Frequency</label>
<input name="Frequency" type="text" class="form-control form-control-sm" style="border-radius:8px;border-color:var(--border)" placeholder="e.g. BID" required />
</div>
<div class="col-md-3 mb-2">
<label style="font-size:0.7rem;font-weight:600;color:var(--text-muted)">Duration (days)</label>
<input name="DurationDays" type="number" class="form-control form-control-sm" style="border-radius:8px;border-color:var(--border)" min="1" max="365" required />
</div>
<div class="col-md-3 mb-2">
<label style="font-size:0.7rem;font-weight:600;color:var(--text-muted)">Expires</label>
<input name="ExpiresAt" type="date" class="form-control form-control-sm" style="border-radius:8px;border-color:var(--border)" required />
</div>
<div class="col-md-3 mb-2">
<label style="font-size:0.7rem;font-weight:600;color:var(--text-muted)">Instructions</label>
<input name="Instructions" type="text" class="form-control form-control-sm" style="border-radius:8px;border-color:var(--border)" />
</div>
<div class="col-md-3 mb-2 d-flex align-items-end">
<div class="form-check">
<input name="IsControlledSubstance" type="checkbox" class="form-check-input" value="true" id="cs-@Model.Id" />
<label class="form-check-label" for="cs-@Model.Id" style="font-size:0.8rem;font-weight:500">Controlled Substance</label>
<input name="IsControlledSubstance" type="hidden" value="false" />
</div>
</div>
</div>
<button type="submit" class="btn btn-sm" style="background:var(--purple);color:white;border:none;border-radius:8px;font-weight:600;padding:6px 16px;margin-top:4px">
<i class="fas fa-prescription mr-1"></i> Add Prescription
</button>
</form>
</div>
</div>
</div>
</div>
