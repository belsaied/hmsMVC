@using HMS.BLL.Shared.Dtos.MedicalRecordsDto
@model UpdateMedicalRecordDto

@{
    ViewData["Title"] = "Edit Medical Record #" + ViewBag.RecordId;
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-gree: #10b981;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg, #854d0e 0%, #f59e0b 100%);
            color: white; padding: 24px 28px; border-radius: 16px; margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(245,158,11,0.18); position: relative; overflow: hidden;
        }
        .page-header-card::before { content: ''; position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; background: rgba(255,255,255,0.07); border-radius: 50%; }
        .page-header-card::after { content: ''; position: absolute; bottom: -60px; right: 80px; width: 220px; height: 220px; background: rgba(255,255,255,0.04); border-radius: 50%; }
        .page-title { font-size: 1.4rem; font-weight: 700; margin: 0; position: relative; z-index: 1; }
        .page-subtitle { font-size: 0.84rem; opacity: 0.75; margin: 4px 0 0; position: relative; z-index: 1; }

        .form-card {
            background: white; border-radius: 18px; overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08); border: 1px solid var(--hms-border);
        }
        .form-card .card-header {
            padding: 18px 24px; border-bottom: 1px solid var(--hms-border);
            background: #f8faff; font-weight: 700; font-size: 0.95rem;
        }
        .form-card .card-body { padding: 24px; }

        .form-label-custom {
            font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
            color: var(--hms-text-muted); margin-bottom: 4px;
        }
        .form-control-custom {
            border-radius: 10px; border: 1.5px solid var(--hms-border);
            padding: 10px 14px; font-size: 0.9rem;
        }
        .form-control-custom:focus {
            box-shadow: 0 0 0 3px rgba(245,158,11,0.12); border-color: #f59e0b;
        }

        .btn-primary-hms {
            background: linear-gradient(135deg, #d97706, #f59e0b); color: white; border: none;
            border-radius: 10px; padding: 11px 24px; font-weight: 600; font-size: 0.9rem;
            box-shadow: 0 4px 12px rgba(245,158,11,0.3); transition: all 0.2s;
        }
        .btn-primary-hms:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(245,158,11,0.4); color: white; }
        .btn-secondary-hms {
            background: white; color: var(--hms-text-muted); border: 1.5px solid var(--hms-border);
            border-radius: 10px; padding: 11px 24px; font-weight: 600; font-size: 0.9rem;
            transition: all 0.15s;
        }
        .btn-secondary-hms:hover { background: #f1f5f9; color: var(--hms-text); }

        .validation-summary { background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; color: #991b1b; font-size: 0.85rem; }
        .field-validation-error { color: #dc2626; font-size: 0.78rem; }

        .info-chip {
            background: #f8faff; border: 1px solid var(--hms-border); border-radius: 10px;
            padding: 12px 16px; display: inline-flex; align-items: center; gap: 12px;
            font-size: 0.85rem;
        }
        .info-chip strong { color: var(--hms-text); }
    </style>
}

<div class="page-header-card">
    <div style="position:relative;z-index:1">
        <h2 class="page-title"><i class="fas fa-edit mr-2"></i> Edit Record #@ViewBag.RecordId</h2>
        <p class="page-subtitle">Update clinical details for this visit</p>
    </div>
    <div style="position:relative;z-index:1">
        <a asp-action="Details" asp-route-id="@ViewBag.RecordId" class="btn btn-sm" style="background:rgba(255,255,255,0.2);color:white;border:none;border-radius:10px;font-weight:600">
            <i class="fas fa-arrow-left mr-1"></i> Back to Record
        </a>
    </div>
    <i class="fas fa-edit" style="font-size:3rem;opacity:0.2;position:absolute;right:150px;top:12px"></i>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary" asp-validation-summary="All"></div>
}

<div class="mb-3" style="display:flex;gap:16px;flex-wrap:wrap">
    <div class="info-chip">
        <i class="fas fa-user-injured" style="color:#1e40af"></i>
        <span><strong>Patient:</strong> @ViewBag.PatientName</span>
    </div>
    <div class="info-chip">
        <i class="fas fa-user-md" style="color:#0f766e"></i>
        <span><strong>Doctor:</strong> @ViewBag.DoctorName</span>
    </div>
    <div class="info-chip">
        <i class="fas fa-calendar" style="color:#d97706"></i>
        <span><strong>Visit:</strong> @ViewBag.VisitDate.ToString("dd MMM yyyy")</span>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@ViewBag.RecordId" method="post">
    @Html.AntiForgeryToken()

    <div class="form-card">
        <div class="card-header">
            <i class="fas fa-notes-medical mr-1" style="color:#d97706"></i> Clinical Information
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label-custom"><i class="fas fa-stethoscope mr-1"></i> Chief Complaint</label>
                    <textarea asp-for="ChiefComplaint" class="form-control form-control-custom" rows="3"></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label-custom"><i class="fas fa-diagnoses mr-1"></i> Diagnosis</label>
                    <textarea asp-for="Diagnosis" class="form-control form-control-custom" rows="3"></textarea>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label-custom"><i class="fas fa-code mr-1"></i> ICD Code</label>
                    <input asp-for="IcdCode" class="form-control form-control-custom" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label-custom"><i class="fas fa-calendar-check mr-1"></i> Follow-Up Date</label>
                    <input asp-for="FollowUpDate" type="date" class="form-control form-control-custom" />
                </div>
                <div class="col-md-4 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsConfidential" type="checkbox" class="form-check-input" />
                        <label class="form-check-label" style="font-size:0.85rem;font-weight:500">Confidential</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label-custom"><i class="fas fa-notes mr-1"></i> Clinical Notes</label>
                    <textarea asp-for="ClinicalNotes" class="form-control form-control-custom" rows="4"></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label-custom"><i class="fas fa-tasks mr-1"></i> Treatment Plan</label>
                    <textarea asp-for="TreatmentPlan" class="form-control form-control-custom" rows="4"></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a asp-action="Details" asp-route-id="@ViewBag.RecordId" class="btn-secondary-hms"><i class="fas fa-times mr-1"></i> Cancel</a>
                <button type="submit" class="btn-primary-hms"><i class="fas fa-save mr-1"></i> Update Record</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
