@using HMS.BLL.Shared.Dtos.MedicalRecordsDto
@model PaginatedResult<MedicalRecordResultDto>

@{
    ViewData["Title"] = "Medical Records — " + ViewBag.PatientName;
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            color: white; padding: 24px 28px; border-radius: 16px; margin-bottom: 24px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 8px 32px rgba(59,130,246,0.18); position: relative; overflow: hidden;
        }
        .page-title { font-size: 1.3rem; font-weight: 700; margin: 0; position: relative; z-index: 1; }
        .page-subtitle { font-size: 0.84rem; opacity: 0.75; margin: 4px 0 0; position: relative; z-index: 1; }
        .patient-badge {
            background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 10px;
            font-size: 0.82rem; position: relative; z-index: 1;
        }

        .table-card {
            background: white; border-radius: 14px; overflow: hidden;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07); border: 1px solid var(--hms-border);
        }
        .table-card .table { margin: 0; }
        .table-card thead th {
            background: #1e40af; color: white; font-weight: 600;
            font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 12px 16px; border: none;
        }
        .table-card tbody td { padding: 12px 16px; vertical-align: middle; border-bottom: 1px solid var(--hms-border); font-size: 0.88rem; }
        .table-card tbody tr:hover td { background: #f8faff; }

        .btn-sm-hms { border-radius: 8px; font-size: 0.75rem; padding: 5px 12px; font-weight: 600; }
        .btn-view { background: #e0f2fe; color: #0369a1; border: none; }
        .btn-view:hover { background: #0369a1; color: white; }

        .empty-state { text-align: center; padding: 50px 20px; color: var(--hms-text-muted); }
        .empty-state i { font-size: 3rem; opacity: 0.2; display: block; margin-bottom: 12px; }

        .pagination-footer { background: #f8faff; padding: 14px 20px; border-top: 1px solid var(--hms-border); display: flex; align-items: center; justify-content: space-between; }
        .pagination .page-link { border-radius: 8px !important; margin: 0 2px; border: 1px solid var(--hms-border); color: #1e40af; font-weight: 500; font-size: 0.875rem; min-width: 36px; text-align: center; padding: 6px 10px; }
        .pagination .page-item.active .page-link { background: #1e40af; border-color: #1e40af; color: white; }

        .btn-back {
            background: white; color: var(--hms-text-muted);
            border: 1.5px solid var(--hms-border); border-radius: 10px;
            padding: 9px 18px; font-weight: 600; font-size: 0.875rem;
            text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-back:hover { background: #f1f5f9; color: var(--hms-text); }
    </style>
}

<div class="page-header-card">
    <div>
        <h3 class="page-title"><i class="fas fa-notes-medical mr-2"></i> Medical Records</h3>
        <p class="page-subtitle">All records for this patient</p>
    </div>
    <div class="patient-badge">
        <strong><i class="fas fa-user-injured mr-1"></i> @ViewBag.PatientName</strong>
        <a asp-action="Create" asp-route-patientId="@ViewBag.PatientId" class="ml-3" style="color:white;text-decoration:none">
            <i class="fas fa-plus mr-1"></i> New Record
        </a>
    </div>
</div>

<div class="table-card">
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Doctor</th>
                <th>Diagnosis</th>
                <th>Complaint</th>
                <th style="width:100px;text-align:center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Data)
            {
                <tr>
                    <td>@r.VisitDate.ToString("dd MMM yyyy")<br /><span style="font-size:0.75rem;color:var(--hms-text-muted)">@r.RecordedAt.ToString("HH:mm")</span></td>
                    <td>@r.DoctorName</td>
                    <td>
                        <span style="font-weight:500">@(r.Diagnosis.Length > 40 ? r.Diagnosis[..40] + "..." : r.Diagnosis)</span>
                        @if (!string.IsNullOrEmpty(r.IcdCode))
                        {
                            <br /><span style="font-size:0.75rem;color:var(--hms-text-muted)">ICD: @r.IcdCode</span>
                        }
                    </td>
                    <td style="font-size:0.85rem">@(r.ChiefComplaint.Length > 50 ? r.ChiefComplaint[..50] + "..." : r.ChiefComplaint)</td>
                    <td style="text-align:center">
                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-view btn-sm-hms">
                            <i class="fas fa-eye mr-1"></i> View
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Data.Any())
            {
                <tr>
                    <td colspan="5">
                        <div class="empty-state">
                            <i class="fas fa-notes-medical"></i>
                            <p style="font-weight:600;color:var(--hms-text)">No medical records for this patient</p>
                            <a asp-action="Create" asp-route-patientId="@ViewBag.PatientId" class="btn" style="background:#1e40af;color:white;border-radius:10px;font-weight:600">
                                <i class="fas fa-plus mr-1"></i> Create First Record
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @{
        int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
        int from = (Model.PageIndex - 1) * Model.PageSize + 1;
        int to = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);
    }
    <div class="pagination-footer">
        <span style="font-size:0.875rem;color:var(--hms-text-muted)">
            Showing <strong>@from–@to</strong> of <strong>@Model.TotalCount</strong>
        </span>
        @if (totalPages > 1)
        {
            <ul class="pagination mb-0">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="PatientRecords"
                       asp-route-patientId="@ViewBag.PatientId"
                       asp-route-pageIndex="@(Model.PageIndex - 1)"><i class="fas fa-chevron-left" style="font-size:0.7rem"></i></a>
                </li>
                @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(totalPages, Model.PageIndex + 2); i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="PatientRecords"
                           asp-route-patientId="@ViewBag.PatientId"
                           asp-route-pageIndex="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageIndex == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="PatientRecords"
                       asp-route-patientId="@ViewBag.PatientId"
                       asp-route-pageIndex="@(Model.PageIndex + 1)"><i class="fas fa-chevron-right" style="font-size:0.7rem"></i></a>
                </li>
            </ul>
        }
    </div>
</div>

<div style="margin-top:20px">
    <a asp-controller="Patients" asp-action="Details" asp-route-id="@ViewBag.PatientId" class="btn-back">
        <i class="fas fa-arrow-left"></i> Back to Patient
    </a>
</div>
