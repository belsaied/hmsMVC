@using HMS.BLL.Shared.Dtos.MedicalRecordsDto
@model PaginatedResult<MedicalRecordResultDto>

@{
    ViewData["Title"] = "Medical Records";
    bool hasFilter = ViewBag.PatientId != null || ViewBag.DoctorId != null;
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-green: #10b981;
            --hms-red: #ef4444;
            --hms-orange: #f59e0b;
            --hms-gray: #64748b;
            --hms-bg: #f0f4f8;
            --hms-card: #ffffff;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            color: white; padding: 28px 32px; border-radius: 16px; margin-bottom: 24px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 8px 32px rgba(59,130,246,0.18); position: relative; overflow: hidden;
        }
        .page-header-card::before { content: ''; position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; background: rgba(255,255,255,0.07); border-radius: 50%; }
        .page-header-card::after { content: ''; position: absolute; bottom: -60px; right: 80px; width: 220px; height: 220px; background: rgba(255,255,255,0.04); border-radius: 50%; }
        .header-title { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.5px; margin: 0; position: relative; z-index: 1; }
        .header-subtitle { font-size: 0.875rem; opacity: 0.75; margin-top: 4px; position: relative; z-index: 1; }
        .header-icon { font-size: 3rem; opacity: 0.2; position: absolute; right: 150px; top: 12px; }

        .search-card {
            background: var(--hms-card); border-radius: 14px; padding: 24px;
            margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            border: 1px solid var(--hms-border);
        }
        .search-title {
            font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
            color: var(--hms-text-muted); margin-bottom: 16px;
        }
        .filter-row { display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap; }
        .filter-group { flex: 1; min-width: 180px; }
        .filter-label {
            font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
            color: var(--hms-text-muted); margin-bottom: 4px; display: flex; align-items: center; gap: 5px;
        }
        .search-input-group .form-control {
            border-radius: 10px 0 0 10px; border-right: none; border-color: var(--hms-border);
            font-size: 0.9rem; padding: 10px 14px; height: 44px;
        }
        .search-input-group .btn {
            border-radius: 0 10px 10px 0; border-color: var(--hms-border);
            background: #1e40af; color: white; border-left: none; height: 44px;
        }
        .search-input-group .btn:hover { background: #1e3a8a; }
        .form-control:focus { box-shadow: 0 0 0 3px rgba(30,64,175,0.12); border-color: #3b82f6; }
        .btn-clear {
            border-radius: 10px; border: 1.5px solid var(--hms-border); background: white;
            color: var(--hms-gray); font-size: 0.875rem; padding: 9px 18px; height: 44px;
            display: inline-flex; align-items: center; gap: 6px; font-weight: 500;
            transition: all 0.12s;
        }
        .btn-clear:hover { background: #f1f5f9; color: var(--hms-text); }

        .filter-chip {
            display: inline-flex; align-items: center; gap: 8px;
            background: #dbeafe; color: #1e40af; padding: 6px 14px; border-radius: 10px;
            font-size: 0.85rem; font-weight: 600;
        }

        .table-card {
            background: var(--hms-card); border-radius: 14px; overflow: hidden;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07); border: 1px solid var(--hms-border);
        }
        .table-card .table { margin: 0; }
        .table-card thead th {
            background: #1e40af; color: white; font-weight: 600;
            font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 14px 16px; border: none;
        }
        .table-card tbody tr { transition: background 0.15s; border-bottom: 1px solid var(--hms-border); }
        .table-card tbody tr:hover { background: #f8faff; }
        .table-card tbody td { padding: 13px 16px; vertical-align: middle; color: var(--hms-text); font-size: 0.9rem; border: none; }

        .patient-name { font-weight: 600; color: var(--hms-text); }
        .doctor-name { font-weight: 500; color: var(--hms-blue-mid); font-size: 0.85rem; }
        .record-meta { font-size: 0.78rem; color: var(--hms-text-muted); }

        .diag-badge {
            background: #dbeafe; color: #1e40af; font-size: 0.75rem; font-weight: 600;
            padding: 3px 10px; border-radius: 8px; display: inline-block; max-width: 200px;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }

        .btn-action { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.82rem; transition: all 0.15s; border: none; cursor: pointer; }
        .btn-view { background: #e0f2fe; color: #0369a1; }
        .btn-view:hover { background: #0369a1; color: white; }
        .btn-edit { background: #fef9c3; color: #854d0e; }
        .btn-edit:hover { background: #d97706; color: white; }

        .pagination-footer { background: #f8faff; padding: 14px 20px; border-top: 1px solid var(--hms-border); display: flex; align-items: center; justify-content: space-between; }
        .pagination .page-link { border-radius: 8px !important; margin: 0 2px; border: 1px solid var(--hms-border); color: #1e40af; font-weight: 500; font-size: 0.875rem; min-width: 36px; text-align: center; padding: 6px 10px; }
        .pagination .page-item.active .page-link { background: #1e40af; border-color: #1e40af; color: white; }

        .empty-state { text-align: center; padding: 60px 20px; color: var(--hms-text-muted); }
        .empty-state i { font-size: 3.5rem; opacity: 0.2; margin-bottom: 16px; display: block; }

        .stats-bar { display: flex; gap: 16px; margin-bottom: 20px; }
        .stat-chip { background: white; border: 1px solid var(--hms-border); border-radius: 10px; padding: 12px 18px; display: flex; align-items: center; gap: 10px; font-size: 0.875rem; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
        .stat-chip-icon { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
        .stat-chip-value { font-size: 1.2rem; font-weight: 700; color: var(--hms-text); }
        .stat-chip-label { font-size: 0.75rem; color: var(--hms-text-muted); }

        .confidential-badge {
            background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 6px;
            font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
        }
        .prompt-card {
            text-align: center; padding: 60px 20px;
        }
        .prompt-card i { font-size: 4rem; opacity: 0.15; display: block; margin-bottom: 16px; }
        .prompt-card h4 { font-weight: 700; color: var(--hms-text); margin-bottom: 8px; }
        .prompt-card p { color: var(--hms-text-muted); font-size: 0.95rem; }
    </style>
}

<div class="page-header-card">
    <div style="position:relative;z-index:1">
        <h2 class="header-title"><i class="fas fa-notes-medical mr-2"></i> Medical Records</h2>
        <p class="header-subtitle">Browse clinical records by patient or doctor</p>
    </div>
    <i class="fas fa-notes-medical header-icon"></i>
</div>

<div class="search-card">
    <div class="search-title"><i class="fas fa-search mr-1"></i> Find Records</div>
    <form method="get" asp-action="Index">
        <div class="filter-row">
            <div class="filter-group">
                <div class="filter-label"><i class="fas fa-user-injured"></i> Patient ID</div>
                <div class="input-group search-input-group">
                    <input type="number" name="patientId" value="@ViewBag.PatientId" class="form-control" placeholder="Enter patient ID..." min="1" />
                </div>
            </div>
            <div class="filter-group">
                <div class="filter-label"><i class="fas fa-user-md"></i> Doctor ID</div>
                <div class="input-group search-input-group">
                    <input type="number" name="doctorId" value="@ViewBag.DoctorId" class="form-control" placeholder="Enter doctor ID..." min="1" />
                </div>
            </div>
            <div class="filter-group" style="flex:0 0 auto;min-width:0">
                <div class="filter-label">&nbsp;</div>
                <div style="display:flex;gap:8px">
                    <button type="submit" class="btn" style="background:#1e40af;color:white;border-radius:10px;padding:10px 20px;font-weight:600;height:44px;border:none">
                        <i class="fas fa-search mr-1"></i> Search
                    </button>
                    <a asp-action="Index" class="btn-clear"><i class="fas fa-times"></i> Clear</a>
                </div>
            </div>
        </div>
    </form>
</div>

@if (hasFilter)
{
    <div class="stats-bar">
        <div class="stat-chip">
            <div class="stat-chip-icon" style="background:#dbeafe"><i class="fas fa-file-medical" style="color:#1e40af"></i></div>
            <div>
                <div class="stat-chip-value">@Model.TotalCount</div>
                <div class="stat-chip-label">Records for @ViewBag.FilterValue</div>
            </div>
        </div>
        <div class="stat-chip">
            <div class="stat-chip-icon" style="background:#f8faff"><i class="fas fa-list" style="color:#64748b"></i></div>
            <div>
                <div class="stat-chip-value">@Model.PageIndex / @((int)Math.Ceiling((double)Model.TotalCount / Model.PageSize))</div>
                <div class="stat-chip-label">Page</div>
            </div>
        </div>
        @if (ViewBag.PatientId != null)
        {
            <a asp-action="Create" asp-route-patientId="@ViewBag.PatientId" class="stat-chip" style="text-decoration:none;cursor:pointer">
                <div class="stat-chip-icon" style="background:#d1fae5"><i class="fas fa-plus" style="color:#059669"></i></div>
                <div>
                    <div class="stat-chip-value" style="font-size:0.9rem">New Record</div>
                    <div class="stat-chip-label">Add for this patient</div>
                </div>
            </a>
        }
    </div>

    <div class="table-card">
        <table class="table">
            <thead>
                <tr>
                    <th><i class="fas fa-calendar mr-1"></i> Visit Date</th>
                    <th><i class="fas fa-user mr-1"></i> Patient</th>
                    <th><i class="fas fa-user-md mr-1"></i> Doctor</th>
                    <th><i class="fas fa-stethoscope mr-1"></i> Diagnosis</th>
                    <th><i class="fas fa-notes mr-1"></i> Complaint</th>
                    <th style="width:100px;text-align:center"><i class="fas fa-ellipsis-h mr-1"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Data)
                {
                    <tr>
                        <td>
                            <div class="patient-name">@r.VisitDate.ToString("dd MMM yyyy")</div>
                            <div class="record-meta">@r.RecordedAt.ToString("dd MMM HH:mm")</div>
                        </td>
                        <td>
                            <div class="patient-name">@r.PatientName</div>
                            <div class="record-meta">ID: @r.PatientId</div>
                        </td>
                        <td>
                            <div class="doctor-name">@r.DoctorName</div>
                        </td>
                        <td>
                            <span class="diag-badge" title="@r.Diagnosis">@r.Diagnosis</span>
                            @if (!string.IsNullOrEmpty(r.IcdCode))
                            {
                                <div class="record-meta">ICD: @r.IcdCode</div>
                            }
                        </td>
                        <td>
                            <span style="font-size:0.85rem;color:var(--hms-text)">@(r.ChiefComplaint.Length > 60 ? r.ChiefComplaint[..60] + "..." : r.ChiefComplaint)</span>
                            @if (r.IsConfidential)
                            {
                                <span class="confidential-badge ml-1"><i class="fas fa-lock mr-1"></i> Confidential</span>
                            }
                        </td>
                        <td style="text-align:center">
                            <div style="display:flex;gap:6px;justify-content:center">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn-action btn-view" title="View Record">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn-action btn-edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Data.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="fas fa-notes-medical"></i>
                                <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No medical records found</p>
                                <p style="font-size:0.875rem">No records match the current filter.</p>
                                @if (ViewBag.PatientId != null)
                                {
                                    <a asp-action="Create" asp-route-patientId="@ViewBag.PatientId" class="btn btn-sm" style="background:#1e40af;color:white;border-radius:10px;font-weight:600;padding:8px 18px;border:none;margin-top:8px">
                                        <i class="fas fa-plus mr-1"></i> Create First Record
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @{
            int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
            int from = (Model.PageIndex - 1) * Model.PageSize + 1;
            int to = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);
        }
        @if (Model.TotalCount > 0)
        {
            <div class="pagination-footer">
                <span style="font-size:0.875rem;color:var(--hms-text-muted)">
                    Showing <strong>@from–@to</strong> of <strong>@Model.TotalCount</strong> records
                </span>
                @if (totalPages > 1)
                {
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-patientId="@ViewBag.PatientId"
                               asp-route-doctorId="@ViewBag.DoctorId"><i class="fas fa-chevron-left" style="font-size:0.7rem"></i></a>
                        </li>
                        @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(totalPages, Model.PageIndex + 2); i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageIndex="@i"
                                   asp-route-patientId="@ViewBag.PatientId"
                                   asp-route-doctorId="@ViewBag.DoctorId">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageIndex == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-patientId="@ViewBag.PatientId"
                               asp-route-doctorId="@ViewBag.DoctorId"><i class="fas fa-chevron-right" style="font-size:0.7rem"></i></a>
                        </li>
                    </ul>
                }
            </div>
        }
    </div>
}
else
{
    <div class="table-card">
        <div class="prompt-card">
            <i class="fas fa-notes-medical"></i>
            <h4>Search Medical Records</h4>
            <p>Enter a Patient ID or Doctor ID above to view their clinical records.</p>
            <div style="display:flex;gap:12px;justify-content:center;margin-top:8px">
                <span class="filter-chip"><i class="fas fa-user-injured"></i> Patient ID</span>
                <span style="color:var(--hms-text-muted);font-size:1.2rem">or</span>
                <span class="filter-chip"><i class="fas fa-user-md"></i> Doctor ID</span>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () { });
    </script>
}
