@using HMS.BLL.Shared.Dtos.WardBedModule.RoomsDtos
@model IEnumerable<RoomResultDto>

@{
    ViewData["Title"] = "Rooms — " + ViewBag.WardName;
    var list = Model?.ToList() ?? [];
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-muted: #64748b;
            --hms-green: #10b981;
        }

        .header-card {
            background: linear-gradient(135deg, var(--hms-blue), var(--hms-blue-mid));
            color: white;
            border-radius: 16px;
            padding: 24px 32px;
            margin-bottom: 24px;
        }

        .room-card {
            background: white;
            border: 1px solid var(--hms-border);
            border-radius: 12px;
            margin-bottom: 14px;
            padding: 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: box-shadow .15s;
        }

            .room-card:hover {
                box-shadow: 0 4px 16px rgba(0,0,0,.08);
            }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: .72rem;
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--hms-muted);
        }

            .empty-state i {
                font-size: 3rem;
                opacity: .2;
                display: block;
                margin-bottom: 12px;
            }
    </style>
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Rooms</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Wards</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@ViewBag.WardId">@ViewBag.WardName</a></li>
                <li class="breadcrumb-item active">Rooms</li>
            </ol>
        </div>
    </div>
}

<div class="header-card">
    <div>
        <h2 style="font-size:1.5rem;font-weight:700;margin:0">
            <i class="fas fa-door-open mr-2"></i> @ViewBag.WardName — Rooms
        </h2>
        <p style="font-size:.875rem;opacity:.75;margin-top:4px">
            @ViewBag.WardType · @ViewBag.TotalRooms room(s)
        </p>
    </div>
</div>

@if (!list.Any())
{
    <div class="empty-state">
        <i class="fas fa-door-closed"></i>
        <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No rooms</p>
        <p>This ward has no rooms yet.</p>
        <a asp-action="Details" asp-route-id="@ViewBag.WardId" class="btn btn-primary mt-2" style="border-radius:9px;font-weight:600">
            <i class="fas fa-plus mr-1"></i> Add Room
        </a>
    </div>
}
else
{
    foreach (var r in list)
    {
        <div class="room-card">
            <div style="display:flex;align-items:center;gap:14px;flex:1;min-width:0">
                <div style="width:42px;height:42px;border-radius:10px;background:#dbeafe;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <i class="fas fa-door-open" style="color:#2563a8"></i>
                </div>
                <div>
                    <div style="font-weight:700;font-size:.95rem">Room @r.RoomNumber</div>
                    <div style="font-size:.8rem;color:var(--hms-muted)">
                        @r.RoomType · Capacity: @r.Capacity @(r.IsActive ? "" : "· Inactive")
                    </div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex-shrink:0">
                <a asp-action="BedsInRoom" asp-route-roomId="@r.Id" class="btn btn-sm btn-outline-primary" style="border-radius:7px;font-size:.75rem;padding:4px 10px">
                    <i class="fas fa-bed mr-1"></i> View Beds
                </a>
            </div>
        </div>
    }
}

<div class="mt-3">
    <a asp-action="Details" asp-route-id="@ViewBag.WardId" class="btn btn-secondary" style="border-radius:9px;font-weight:600">
        <i class="fas fa-arrow-left mr-1"></i> Back to Ward
    </a>
</div>
