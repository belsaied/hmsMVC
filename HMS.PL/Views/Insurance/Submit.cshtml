@model HMS.PL.ViewModels.BillingModule.SubmitClaimViewModel
@{ ViewData["Title"] = "Submit Insurance Claim"; }

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Submit Insurance Claim</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Invoices" asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item active">Submit Claim</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root { --hms-blue: #1a3a5c; --hms-blue-mid: #2563a8; --hms-border: #e2e8f0; --hms-text: #1e293b; --hms-muted: #64748b; }
    .form-card { background:#fff; border-radius:14px; box-shadow:0 2px 12px rgba(0,0,0,.06); border:1px solid var(--hms-border); overflow:hidden; }
    .form-card-header { padding:16px 22px; border-bottom:1px solid var(--hms-border); font-weight:700; font-size:.9rem; background:#f8fafc; }
    .form-card-body { padding:22px; }
    .form-control { border-radius:10px; border:1.5px solid var(--hms-border); padding:10px 14px; font-size:.9rem; }
    .form-control:focus { border-color:#64748b; box-shadow:0 0 0 3px rgba(100,116,139,.12); }
    .form-label { font-size:.82rem; font-weight:600; color:var(--hms-text); margin-bottom:4px; }
    .input-group-text { border-radius:10px 0 0 10px; border-color:var(--hms-border); }
</style>
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-card">
            <div class="form-card-header">
                <i class="fas fa-shield-alt mr-2 text-secondary"></i> Submit Insurance Claim &mdash; @Model.InvoiceNumber
            </div>
            <div class="form-card-body">
                <p class="text-muted mb-3">Invoice total: <strong>@Model.TotalAmount.ToString("C")</strong></p>
                <form asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="InvoiceId" />
                    <input type="hidden" asp-for="InvoiceNumber" />
                    <input type="hidden" asp-for="TotalAmount" />

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="InsuranceProvider" class="form-label"></label>
                            <input asp-for="InsuranceProvider" class="form-control" />
                            <span asp-validation-for="InsuranceProvider" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="PolicyNumber" class="form-label"></label>
                            <input asp-for="PolicyNumber" class="form-control" />
                            <span asp-validation-for="PolicyNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="MembershipNumber" class="form-label"></label>
                            <input asp-for="MembershipNumber" class="form-control" />
                            <span asp-validation-for="MembershipNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="ClaimedAmount" class="form-label"></label>
                            <div class="input-group">
                                <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                                <input asp-for="ClaimedAmount" type="number" step="0.01" min="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="ClaimedAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-12 form-group">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2" style="gap:8px">
                        <button type="submit" class="btn btn-secondary" style="border-radius:9px;font-weight:700;padding:10px 24px">
                            <i class="fas fa-upload mr-1"></i> Submit Claim
                        </button>
                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId"
                           class="btn btn-outline-secondary" style="border-radius:9px;font-weight:600">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
