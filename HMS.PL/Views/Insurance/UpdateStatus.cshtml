@model HMS.PL.ViewModels.BillingModule.UpdateClaimViewModel
@using HMS.DAL.Models.Enums.BillingEnums
@{ ViewData["Title"] = "Update Claim Status"; }

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">Update Claim Status</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Invoices" asp-action="Index">Invoices</a></li>
                <li class="breadcrumb-item"><a asp-action="ClaimDetails" asp-route-invoiceId="@Model.InvoiceId">Claim</a></li>
                <li class="breadcrumb-item active">Update Status</li>
            </ol>
        </div>
    </div>
}

@section Styles {
<style>
    :root { --hms-border: #e2e8f0; --hms-text: #1e293b; --hms-muted: #64748b; }
    .form-card { background:#fff; border-radius:14px; box-shadow:0 2px 12px rgba(0,0,0,.06); border:1px solid var(--hms-border); overflow:hidden; }
    .form-card-header { padding:16px 22px; border-bottom:1px solid var(--hms-border); font-weight:700; font-size:.9rem; background:#f8fafc; }
    .form-card-body { padding:22px; }
    .form-control { border-radius:10px; border:1.5px solid var(--hms-border); padding:10px 14px; font-size:.9rem; }
    .form-control:focus { border-color:#2563a8; box-shadow:0 0 0 3px rgba(37,99,168,.12); }
    .form-label { font-size:.82rem; font-weight:600; color:var(--hms-text); margin-bottom:4px; }
</style>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="form-card">
            <div class="form-card-header">
                <i class="fas fa-edit mr-2 text-primary"></i> Update Claim Status
            </div>
            <div class="form-card-body">
                <p class="text-muted mb-3">Claimed amount: <strong>@Model.ClaimedAmount.ToString("C")</strong></p>
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClaimId" />
                    <input type="hidden" asp-for="InvoiceId" />
                    <input type="hidden" asp-for="ClaimedAmount" />

                    <div class="form-group">
                        <label asp-for="ClaimStatus" class="form-label"></label>
                        <select asp-for="ClaimStatus" asp-items="ViewBag.ClaimStatusList" class="form-control"></select>
                        <span asp-validation-for="ClaimStatus" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ApprovedAmount" class="form-label"></label>
                        <input asp-for="ApprovedAmount" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="ApprovedAmount" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RejectionReason" class="form-label"></label>
                        <textarea asp-for="RejectionReason" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="RejectionReason" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2" style="gap:8px">
                        <button type="submit" class="btn btn-primary" style="border-radius:9px;font-weight:700;padding:10px 24px">
                            <i class="fas fa-save mr-1"></i> Update Status
                        </button>
                        <a asp-action="ClaimDetails" asp-route-invoiceId="@Model.InvoiceId"
                           class="btn btn-outline-secondary" style="border-radius:9px;font-weight:600">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
