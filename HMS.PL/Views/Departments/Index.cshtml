@using HMS.BLL.Shared.Dtos.DoctorModule.DepartmentDtos
@model IEnumerable<DepartmentResultDto>

@{
    ViewData["Title"] = "Departments";
}

@section Styles {
    <style>
        :root {
            --hms-blue: #1a3a5c;
            --hms-blue-mid: #2563a8;
            --hms-accent: #0ea5e9;
            --hms-border: #e2e8f0;
            --hms-text: #1e293b;
            --hms-text-muted: #64748b;
        }

        .page-header-card {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            color: white; padding: 28px 32px; border-radius: 16px; margin-bottom: 24px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 8px 32px rgba(59,130,246,0.18); position: relative; overflow: hidden;
        }
        .page-header-card::before { content: ''; position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; background: rgba(255,255,255,0.07); border-radius: 50%; }
        .header-title { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.5px; margin: 0; position: relative; z-index: 1; }
        .header-subtitle { font-size: 0.875rem; opacity: 0.75; margin-top: 4px; position: relative; z-index: 1; }

        .dept-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
        .dept-card { background: white; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 1px solid var(--hms-border); overflow: hidden; transition: box-shadow 0.15s, transform 0.15s; }
        .dept-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
        .dept-card .dept-header { padding: 20px 20px 16px; display: flex; align-items: flex-start; gap: 14px; }
        .dept-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
        .dept-name { font-weight: 700; font-size: 1.05rem; color: var(--hms-text); margin: 0 0 2px; }
        .dept-desc { font-size: 0.82rem; color: var(--hms-text-muted); margin: 0; }
        .dept-footer { padding: 12px 20px; background: #f8faff; border-top: 1px solid var(--hms-border); display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; color: var(--hms-text-muted); }
        .dept-head { font-size: 0.85rem; font-weight: 600; color: var(--hms-text); }
        .dept-actions { display: flex; gap: 6px; }
        .dept-actions a { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.82rem; transition: all 0.15s; text-decoration: none; }
        .btn-view-dept { background: #dbeafe; color: #1e40af; }
        .btn-view-dept:hover { background: #1e40af; color: white; }
        .btn-edit-dept { background: #fef9c3; color: #854d0e; }
        .btn-edit-dept:hover { background: #d97706; color: white; }

        .btn-add { background: linear-gradient(135deg, var(--hms-accent), #1e40af); color: white; border: none; border-radius: 10px; padding: 10px 20px; font-weight: 600; font-size: 0.875rem; box-shadow: 0 4px 12px rgba(14,165,233,0.3); transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
        .btn-add:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(14,165,233,0.4); color: white; }

        .empty-state { text-align: center; padding: 60px 20px; color: var(--hms-text-muted); }
        .empty-state i { font-size: 3.5rem; opacity: 0.2; margin-bottom: 16px; display: block; }
    </style>
}

<div class="page-header-card">
    <div style="position:relative;z-index:1">
        <h2 class="header-title"><i class="fas fa-building mr-2"></i> Departments</h2>
        <p class="header-subtitle">Manage hospital departments and their heads</p>
    </div>
    <div style="position:relative;z-index:1">
        <a asp-action="Create" class="btn-add">
            <i class="fas fa-plus"></i> New Department
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="dept-card">
        <div class="empty-state">
            <i class="fas fa-building"></i>
            <p style="font-size:1rem;font-weight:600;color:var(--hms-text)">No departments found</p>
            <p style="font-size:0.875rem">Create your first department to get started.</p>
        </div>
    </div>
}
else
{
    <div class="dept-grid">
        @foreach (var d in Model)
        {
            <div class="dept-card">
                <div class="dept-header">
                    <div class="dept-icon" style="background:#dbeafe"><i class="fas fa-hospital" style="color:#1e40af"></i></div>
                    <div style="flex:1;min-width:0">
                        <div class="dept-name">@d.Name</div>
                        <p class="dept-desc">@(d.Description ?? "No description")</p>
                    </div>
                </div>
                <div class="dept-footer">
                    <div>
                        @if (!string.IsNullOrEmpty(d.HeadDoctorName))
                        {
                            <span><i class="fas fa-user-md mr-1"></i> <span class="dept-head">@d.HeadDoctorName</span></span>
                        }
                        else
                        {
                            <span style="font-style:italic">No head assigned</span>
                        }
                        @if (!string.IsNullOrEmpty(d.PhoneExtension))
                        {
                            <span class="ml-3"><i class="fas fa-phone mr-1"></i> ext. @d.PhoneExtension</span>
                        }
                    </div>
                    <div class="dept-actions">
                        <a asp-action="Details" asp-route-id="@d.Id" class="btn-view-dept" title="Details">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn-edit-dept" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
